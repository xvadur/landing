---
/** Dvere (doc 10 §3 #6, §4): hero blok sa pri scrolle rozdelí v strede a odhalí „Kto som".
 *  Desktop ≥ 1024 px bez reduced motion: GSAP ScrollTrigger pin (jediná pinnutá scéna na domove), GSAP sa ťahá lazy
 *  až v tomto skripte. Mobil: CSS scroll-driven animácia (animation-timeline: view()), bez pinu; kde view() nie je,
 *  dvere sú otvorené. Reduced motion: dvere sa 120 ms rozplynú (globálne pravidlo), obsah je viditeľný.
 *  Kotva #kto-som je tu (CTA VSTÚP z hera): na desktope s GSAP sa klik na #kto-som odchytí a scrolluje na koniec pinu
 *  (dvere otvorené, KTO SOM odhalené), nie na začiatok scény, kde by používateľ videl len zatvorené krídla.
 *  Koreň má overflow-clip (nie hidden): hidden by z neho urobil scroll container a mobilná animácia view() by sa
 *  počítala voči nemu, nie voči viewportu — krídla by boli trvalo otvorené. */
import { BEATY } from '@/data/beaty';
import { MOTTO_1, MOTTO_2, WORDMARK } from '@/components/hero/hero-data';

const prvy = BEATY[0]!.rok;
const posledny = BEATY[BEATY.length - 1]!.rok;
---

<div id="kto-som" data-dvere="closed" class="dvere relative h-[70svh] overflow-clip border-b-3 border-ink bg-yellow lg:h-svh">
  <!-- odhalené: Kto som -->
  <div data-dvere-inner class="tx-dots absolute inset-0 flex items-center justify-center bg-yellow px-4 [--tx:26%]">
    <div class="text-center">
      <p class="eyebrow">{prvy} → {posledny}</p>
      <h2 id="kto-som-nadpis" class="mt-4 font-display text-display-xl font-extrabold uppercase leading-[0.84] tracking-tighter">
        Kto som
      </h2>
    </div>
  </div>

  <!-- ľavé krídlo -->
  <div data-dvere-l class="dvere-kridlo absolute inset-y-0 left-0 w-1/2 overflow-hidden border-r-3 border-ink bg-paper tx-grain" aria-hidden="true">
    <img
      src={WORDMARK.src}
      alt=""
      width={WORDMARK.width}
      height={WORDMARK.height}
      class="absolute top-1/2 left-[10vw] w-[80vw] max-w-none -translate-y-[80%] drop-shadow-[8px_8px_0_var(--color-ink)]"
      loading="lazy"
      decoding="async"
    />
    <p lang="en" class="absolute bottom-6 left-4 font-display text-display-sm font-extrabold uppercase leading-none tracking-tighter sm:left-6 lg:left-10">
      {MOTTO_1}
    </p>
  </div>
  <!-- pravé krídlo -->
  <div data-dvere-r class="dvere-kridlo absolute inset-y-0 right-0 w-1/2 overflow-hidden border-l-3 border-ink bg-paper tx-grain" aria-hidden="true">
    <img
      src={WORDMARK.src}
      alt=""
      width={WORDMARK.width}
      height={WORDMARK.height}
      class="absolute top-1/2 left-[-40vw] w-[80vw] max-w-none -translate-y-[80%] drop-shadow-[8px_8px_0_var(--color-ink)]"
      loading="lazy"
      decoding="async"
    />
    <p lang="en" class="absolute right-4 bottom-6 text-right font-display text-display-sm font-extrabold uppercase leading-none tracking-tighter sm:right-6 lg:right-10">
      {MOTTO_2}
    </p>
  </div>
</div>

<style>
  /* Mobil (a reduced motion na každej šírke): CSS scroll-driven otvorenie, bez pinu. */
  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    @supports (animation-timeline: view()) {
      .dvere-kridlo {
        --tl: view();
        animation-name: dvere-otvor;
        animation-timing-function: cubic-bezier(0.2, 0.9, 0.2, 1);
        animation-fill-mode: both;
        animation-timeline: var(--tl);
        animation-range: entry 25% cover 60%;
      }
      [data-dvere-r].dvere-kridlo {
        animation-name: dvere-otvor-r;
      }
    }
    @supports not (animation-timeline: view()) {
      .dvere-kridlo {
        display: none;
      }
    }
  }
  /* Pri reduced motion globálne CSS prepne timeline na auto a trvanie na 120 ms → krídla sa rozplynú. */
  @media (prefers-reduced-motion: reduce) {
    .dvere-kridlo {
      animation-name: dvere-fade !important;
    }
  }
  /* Desktop bez GSAP (import zlyhal) alebo explicitne statický stav: krídla preč. */
  [data-dvere='static'] .dvere-kridlo {
    display: none;
  }
  @keyframes dvere-otvor {
    from { transform: translateX(0); }
    to { transform: translateX(-101%); }
  }
  @keyframes dvere-otvor-r {
    from { transform: translateX(0); }
    to { transform: translateX(101%); }
  }
  @keyframes dvere-fade {
    from { opacity: 1; }
    to { opacity: 0; visibility: hidden; }
  }
</style>

<script>
  /* Desktop: pinnutá scéna (GSAP ScrollTrigger, lazy). Jediný GSAP scroll ostrov na domove. */
  type Cleanup = () => void;
  let cleanup: Cleanup | null = null;
  const MQ_DESKTOP = '(min-width: 1024px)';
  const MQ_REDUCED = '(prefers-reduced-motion: reduce)';

  async function init() {
    const el = document.querySelector<HTMLElement>('[data-dvere]');
    if (!el) return;
    const desktop = window.matchMedia(MQ_DESKTOP).matches;
    const reduced = window.matchMedia(MQ_REDUCED).matches;
    if (!desktop || reduced) return; // mobil / reduced: CSS rieši
    const left = el.querySelector<HTMLElement>('[data-dvere-l]');
    const right = el.querySelector<HTMLElement>('[data-dvere-r]');
    const inner = el.querySelector<HTMLElement>('[data-dvere-inner]');
    if (!left || !right || !inner) return;
    try {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
      gsap.registerPlugin(ScrollTrigger);
      const lenis = window.__lenis;
      const onLenis = () => ScrollTrigger.update();
      lenis?.on('scroll', onLenis);
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: el,
          start: 'top top',
          end: '+=110%',
          pin: true,
          pinSpacing: true,
          scrub: 0.6,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
      tl.fromTo(inner, { scale: 0.94, opacity: 0.6 }, { scale: 1, opacity: 1, duration: 0.6 }, 0)
        .to(left, { xPercent: -101, duration: 1 }, 0)
        .to(right, { xPercent: 101, duration: 1 }, 0);
      el.dataset.dvere = 'gsap';
      const refresh = () => ScrollTrigger.refresh();
      document.fonts?.ready.then(refresh);
      window.addEventListener('load', refresh, { once: true });
      /* Klik na #kto-som (VSTÚP, pilulka, ⌘K): scrollovať na koniec pinu = dvere otvorené. Zachytené v capture fáze,
         aby ho nezobral Lenis (anchors: true, listener na window). */
      const koniec = () => {
        const st = tl.scrollTrigger;
        if (!st) return;
        const top = st.end;
        if (lenis) lenis.scrollTo(top, { duration: 1.1 });
        else window.scrollTo({ top, behavior: 'smooth' });
        history.replaceState(null, '', '#kto-som');
      };
      const onClick = (e: MouseEvent) => {
        const a = (e.target as Element | null)?.closest?.('a[href]');
        if (!(a instanceof HTMLAnchorElement)) return;
        const url = new URL(a.href, location.href);
        if (url.hash !== '#kto-som' || url.pathname !== location.pathname || url.host !== location.host) return;
        e.preventDefault();
        e.stopPropagation();
        koniec();
      };
      document.addEventListener('click', onClick, true);
      if (location.hash === '#kto-som') requestAnimationFrame(() => requestAnimationFrame(koniec));
      cleanup = () => {
        document.removeEventListener('click', onClick, true);
        lenis?.off('scroll', onLenis);
        tl.scrollTrigger?.kill();
        tl.kill();
        gsap.set([left, right, inner], { clearProps: 'all' });
        cleanup = null;
      };
    } catch {
      el.dataset.dvere = 'static';
    }
  }

  /* Zmena šírky cez 1024 px / reduced motion po inicializácii: GSAP zrušiť (CSS view() prevezme) alebo naopak spustiť. */
  const reinit = () => {
    cleanup?.();
    init();
  };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());
  window.matchMedia(MQ_DESKTOP).addEventListener('change', reinit);
  window.matchMedia(MQ_REDUCED).addEventListener('change', reinit);
</script>
