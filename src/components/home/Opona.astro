---
/** Opona — povinný úvod webu (Adam, 19. 9. večer: „napíš xvadur, rozdelí sa to na dve polovice jak opona, ukáže sa hero").
 *  Cela obrazovka zlta s bodkami (ako pas Kto som), v strede cierny wordmark XVADUR, deliaca ciara medzi A a D (XVA | DUR), pod XVA „DIVIDED,", pod DUR „WE ARE USELESS.". Drží 1,4 s, potom sa krídla rozídu do strán (900 ms, cubic-bezier .76 0 .24 1) a odhalia hero.
 *  Pravidlá: raz za návštevu (sessionStorage.opona), reduced motion = bez opony, scroll / klik / klávesa = preskočiť
 *  (250 ms). Animácia je čisto CSS (funguje aj bez JS — potom sa opona po skončení iba skryje cez `forwards`
 *  + pointer-events none); JS rieši session, zámok scrollu a preskočenie. Google vidí hero, opona je aria-hidden.
 *  Inline skript beží pred vykreslením, aby vracajúci sa návštevník oponu nikdy nezahliadol. */
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';
---

<div id="opona" class="opona" aria-hidden="true" data-opona>
  <!-- každé krídlo nesie celú šírku obrazovky (100vw): wordmark vycentrovaný tak, že deliaca čiara padne do medzery
       medzi A a D (ľavé krídlo XVA, pravé DUR); pod XVA „DIVIDED,", pod DUR „WE ARE USELESS." -->
  <div class="opona-kridlo opona-l tx-dots">
    <div class="opona-vrstva">
      <img class="opona-wm" src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
      <p lang="en" class="opona-motto opona-motto-l">{MOTTO_1}</p>
    </div>
  </div>
  <div class="opona-kridlo opona-r tx-dots">
    <div class="opona-vrstva opona-vrstva-r">
      <img class="opona-wm" src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
      <p lang="en" class="opona-motto opona-motto-r">{MOTTO_2}</p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById('opona');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('opona') === '1';
    } catch {
      /* súkromné okno / blokované úložisko: opona sa ukáže */
    }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduced) {
      el.remove();
      return;
    }
    try {
      sessionStorage.setItem('opona', '1');
    } catch {
      /* ignoruj */
    }
    const html = document.documentElement;
    html.classList.add('opona-lock');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      html.classList.remove('opona-lock');
      el.remove();
      window.dispatchEvent(new CustomEvent('opona:done'));
      window.removeEventListener('wheel', skip);
      window.removeEventListener('touchstart', skip);
      window.removeEventListener('keydown', skip);
      window.removeEventListener('pointerdown', skip);
    };
    const skip = () => {
      el.classList.add('opona-skip');
      setTimeout(finish, 260);
    };
    window.addEventListener('wheel', skip, { passive: true });
    window.addEventListener('touchstart', skip, { passive: true });
    window.addEventListener('keydown', skip);
    window.addEventListener('pointerdown', skip);
    el.classList.add('opona-go');
    setTimeout(finish, 1400 + 900 + 80);
  })();
</script>

<style>
  .opona {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html.opona-lock) {
    overflow: hidden;
  }
  .opona-kridlo {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    background-color: var(--color-yellow);
    --tx: 26%;
    will-change: transform;
  }
  .opona-l {
    left: 0;
    border-right: 3px solid var(--color-ink);
  }
  .opona-r {
    right: 0;
    border-left: 3px solid var(--color-ink);
  }
  /* vrstva = celá obrazovka; v pravom krídle posunutá o −50vw, aby nadväzovala na ľavé */
  .opona-vrstva {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100%;
  }
  .opona-vrstva-r {
    left: -50vw;
  }
  /* wordmark: čierny (SVG s inkovou výplňou), veľký, zvisle v strede; vodorovne posunutý tak, aby stred obrazovky
     padol do medzery medzi A a D (bod 323 z 678 jednotiek viewBoxu → 47,6 % šírky) */
  .opona-wm {
    --wmw: min(84vw, 1180px);
    position: absolute;
    top: 50%;
    left: calc(50vw - var(--wmw) * 0.4764);
    width: var(--wmw);
    height: auto;
    max-width: none;
    transform: translateY(-50%);
  }
  /* motto pod wordmarkom: ľavý riadok končí pri deliacej čiare (pod XVA), pravý od nej začína (pod DUR);
     výška wordmarku = šírka × 130/678 → spodná hrana je na 50 % + 9,6 % šírky */
  .opona-motto {
    --wmw: min(84vw, 1180px);
    position: absolute;
    top: calc(50% + var(--wmw) * 0.096 + 1rem);
    margin: 0;
    max-width: calc(50vw - 1.5rem);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 1rem + 3.2vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .opona-motto-l {
    right: calc(50vw + 1rem);
    text-align: right;
  }
  .opona-motto-r {
    left: calc(50vw + 1rem);
    text-align: left;
  }
  @media (min-width: 640px) {
    .opona-motto { top: calc(50% + var(--wmw) * 0.096 + 1.5rem); }
    .opona-motto-l { right: calc(50vw + 1.5rem); }
    .opona-motto-r { left: calc(50vw + 1.5rem); }
  }

  /* otvorenie: bez JS sa spustí samo (animation-delay), s JS cez .opona-go (rovnaký čas) */
  .opona-l,
  .opona-r {
    animation-duration: 900ms;
    animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    animation-delay: 1400ms;
    animation-fill-mode: forwards;
  }
  .opona-l { animation-name: opona-l; }
  .opona-r { animation-name: opona-r; }
  .opona-skip .opona-l,
  .opona-skip .opona-r {
    animation-duration: 250ms;
    animation-delay: 0ms;
  }
  @keyframes opona-l {
    to { transform: translateX(-101%); }
  }
  @keyframes opona-r {
    to { transform: translateX(101%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .opona { display: none; }
  }
</style>
