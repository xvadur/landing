---
/** Odber (#vydanie) — e-mail → POST /api/odber (src/pages/api/odber.ts). Rozhodnutie 25. 9.: lákadlo za e-mail +
 *  newsletter. Kým `ODBER.magnet` nie je vyplnený, sľubuje sa len to, čo existuje: prvý mail = text z /texty/.
 *  Formulár je natívny (0 kB React); skript nižšie ho odošle cez fetch a vypíše stav; bez JS ostáva mailto.
 *  Honeypot `web` (skryté pole) — bot ho vyplní, API odpovie 200 a nič neuloží. */
import Section from '@/components/site/Section.astro';
import XMark from '@/components/site/XMark.astro';
import { ODBER, magnetReady } from '@/data/ponuka';
import { BTN_HOT, LINK } from './btn';
import { ArrowRightIcon, ArrowUpRightIcon } from '@phosphor-icons/react';

interface Props {
  /** odkiaľ formulár prišiel (ide do payloadu) */
  zdroj?: string;
}
const { zdroj = 'domov' } = Astro.props;
const magnet = magnetReady();
const mailto = `mailto:${ODBER.email}?subject=${encodeURIComponent('Odber — Vydanie')}`;
---

<Section id="vydanie" bg="lime" pad="lg" border="bottom" label="Vydanie — odber" class="tx-halftone scroll-mt-20">
  <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-14">
    <div>
      <p class="eyebrow">{ODBER.eyebrow}</p>
      <h2 class="mt-4 font-display text-display font-extrabold uppercase leading-[0.9] tracking-tighter">{ODBER.nadpis}</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed">{ODBER.text}</p>

      <div class="mt-8 flex items-start gap-4 rounded-lg border-3 border-ink bg-white p-5 shadow-brutal-sm">
        <XMark class="mt-1 h-9 w-9 shrink-0 text-hot" />
        {
          magnet ? (
            <p class="text-lg">
              <span class="eyebrow block">Za e-mail dostaneš</span>
              <strong class="font-display text-xl font-extrabold">{ODBER.magnet.nazov}</strong>
              <span class="mt-1 block text-base text-ink/80">{ODBER.magnet.popis}</span>
            </p>
          ) : (
            <p class="text-lg">
              <span class="eyebrow block">{ODBER.prvyMail.label}</span>
              <a href={ODBER.prvyMail.href} class="inline-block py-2.5 font-display text-xl font-extrabold underline decoration-[3px] decoration-hot underline-offset-4">
                {ODBER.prvyMail.nazov}
              </a>
            </p>
          )
        }
      </div>

      <a href={ODBER.substack} target="_blank" rel="noopener noreferrer" class:list={[LINK, 'mt-6']}>
        Alebo čítaj na Substacku
        <ArrowUpRightIcon size={22} weight="bold" aria-hidden="true" />
      </a>
    </div>

    <form data-odber class="brutal relative flex flex-col gap-4 bg-white p-6 sm:p-8" method="post" action="/api/odber/" novalidate>
      <span class="x-stamp" aria-hidden="true"></span>
      <label for="odber-email" class="eyebrow">Tvoj e-mail</label>
      <input
        id="odber-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder="ty@firma.sk"
        class="min-h-14 w-full rounded-lg border-3 border-ink bg-paper px-4 font-sans text-lg shadow-brutal-sm placeholder:text-ink/40"
      />
      <input type="hidden" name="zdroj" value={zdroj} />
      <div class="hidden" aria-hidden="true">
        <label>Web <input name="web" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button type="submit" class:list={[BTN_HOT, 'min-h-14 text-xl']}>
        {ODBER.cta}
        <ArrowRightIcon size={24} weight="bold" aria-hidden="true" />
      </button>
      <p data-odber-stav role="status" aria-live="polite" class="min-h-6 text-base font-bold"></p>
      <p class="text-sm leading-snug text-ink/70">
        Odoslaním súhlasíš, že ti raz za týždeň pošlem e-mail. Nič iné, nikomu inému.
        <noscript>
          <span class="block mt-2">Bez JavaScriptu: <a href={mailto} class="underline decoration-hot decoration-2">napíš mi e-mail</a> a zapíšem ťa ručne.</span>
        </noscript>
      </p>
    </form>
  </div>
</Section>

<script>
  // Delegácia na document: beží raz, prežije ClientRouter; formulár sa hľadá pri každom odoslaní.
  const EMAIL_RE = /^[^\s@]{1,64}@[^\s@.]+(?:\.[^\s@.]+)+$/u;
  document.addEventListener('submit', async (e) => {
    const form = (e.target as Element | null)?.closest?.('form[data-odber]') as HTMLFormElement | null;
    if (!form) return;
    e.preventDefault();
    const stav = form.querySelector<HTMLElement>('[data-odber-stav]');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fd = new FormData(form);
    const email = String(fd.get('email') ?? '').trim();
    const napis = (text: string, odkaz?: { href: string; label: string }) => {
      if (!stav) return;
      stav.replaceChildren(document.createTextNode(text));
      if (odkaz) {
        stav.append(' ');
        const a = document.createElement('a');
        a.href = odkaz.href;
        a.textContent = odkaz.label;
        a.className = 'underline decoration-hot decoration-[3px] underline-offset-4';
        stav.append(a);
      }
    };
    if (!EMAIL_RE.test(email)) {
      napis('Toto nevyzerá ako e-mail. Skús to znova.');
      form.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
      return;
    }
    if (btn) btn.disabled = true;
    napis('Posielam…');
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, zdroj: fd.get('zdroj'), web: fd.get('web') }),
      });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; chyba?: string; fallback?: string };
      if (res.ok && data.ok) {
        napis('Hotovo. Prvý mail príde čoskoro.');
        form.reset();
      } else if (data.fallback) {
        napis(data.chyba ?? 'Odber sa pripravuje.', { href: data.fallback, label: 'Napísať e-mail →' });
      } else {
        napis(data.chyba ?? 'Nepodarilo sa. Skús o chvíľu.');
      }
    } catch {
      napis('Sieť neodpovedá. Skús o chvíľu.');
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
