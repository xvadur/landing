---
/** Kto som — vertikálna časová os 7 beatov (src/data/beaty.ts, verbatim; ratifikované 19. 9.: všetkých 7,
 *  mechanizmus, nie krivda, bez mien ľudí a inštitúcií). Titulky: Fancy VerticalCutReveal (Motion) len na desktope
 *  (client:media ≥ 1024 px bez reduced motion — mobil a reduced dostanú SSR text bez Motion, rozpočet JS), text: CSS reveal. Koniec: „CELÝ PRÍBEH"
 *  → /texty/. Nadpis sekcie je v Dvere.astro (#kto-som-nadpis). Tisícové medzery („1 500 €") pevné cez nbsp(). */
import Section from '@/components/site/Section.astro';
import Titulok from './Titulok';
import { BEATY, BEATY_CTA } from '@/data/beaty';
import { ArrowRightIcon } from '@phosphor-icons/react';
import { nbsp } from './nbsp';

const prvy = BEATY[0]!.rok;
const posledny = BEATY[BEATY.length - 1]!.rok;
/* nálepka roku: ink na pasteloch; posledná (XVADUR) hot s inkom (paper na hot má len 3,2 : 1) */
const FARBY = ['bg-yellow', 'bg-pink', 'bg-lilac', 'bg-lime', 'bg-sky', 'bg-white', 'bg-hot text-ink'];
---

<Section bg="white" pad="lg" border="bottom" label="Kto som — časová os" as="section">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_2fr]">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="x-divider">Kto som</p>
      <p class="mt-6 font-display text-display-sm font-extrabold uppercase leading-[0.92] tracking-tighter">
        {BEATY.length} zastávok.<br />{prvy} → {posledny}.
      </p>
    </div>

    <ol class="relative border-l-3 border-ink pl-6 sm:pl-10" role="list">
      {
        BEATY.map((b, i) => (
          <li class="reveal relative pb-12 last:pb-0" style={`--i:${i}`}>
            <span class="absolute top-2 -left-[calc(0.75rem+1.5px)] h-6 w-6 rounded-full border-3 border-ink bg-hot" aria-hidden="true" />
            <div class="flex flex-wrap items-start gap-x-5 gap-y-3">
              <span
                class:list={[
                  'sticker shrink-0 text-base sm:text-lg',
                  FARBY[i % FARBY.length],
                ]}
                style={`--sticker-rotate:${i % 2 ? 3 : -4}deg`}
              >
                {nbsp(b.rok)}
              </span>
              <div class="min-w-0 flex-1 basis-64">
                <h3 class="font-display text-display-xs font-extrabold uppercase leading-[0.95] tracking-tight">
                  <Titulok client:media="(min-width: 1024px) and (prefers-reduced-motion: no-preference)" text={b.titulok} />
                </h3>
                <p class="mt-3 max-w-prose text-lg leading-relaxed">{nbsp(b.text)}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="mt-14 flex justify-end">
    <a
      href={BEATY_CTA.href}
      class="press inline-flex min-h-12 items-center gap-3 rounded-lg border-3 border-ink bg-ink px-5 font-display text-lg font-extrabold uppercase text-paper shadow-brutal hover:bg-ink-hover"
    >
      {BEATY_CTA.label}
      <ArrowRightIcon size={22} weight="bold" aria-hidden="true" />
    </a>
  </div>
</Section>
