---
/** Kto som (#kto-som) — v6 kompaktne: krátke bio (fakty len z beatov: domov seniorov, nemocnica, notebook 2025,
 *  podnikanie od marca 2026) + 7 beatov verbatim (src/data/beaty.ts, ratifikované 19. 9.: mechanizmus, nie krivda,
 *  bez mien ľudí a inštitúcií). Bez GSAP, bez pinu; reveal cez CSS. Odkaz na texty a na dôkazy. */
import Section from '@/components/site/Section.astro';
import { BEATY, BEATY_CTA } from '@/data/beaty';
import { LINK } from './btn';
import { nbsp } from './nbsp';
import { ArrowDownIcon, ArrowRightIcon } from '@phosphor-icons/react';

const prvy = BEATY[0]!.rok;
const posledny = BEATY[BEATY.length - 1]!.rok;
const FARBY = ['bg-yellow', 'bg-pink', 'bg-lilac', 'bg-lime', 'bg-sky', 'bg-white', 'bg-hot text-ink'];
---

<Section id="kto-som" bg="yellow" pad="lg" border="bottom" label="Kto som" class="tx-dots [--tx:22%] scroll-mt-20">
  <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="eyebrow">Kto som / {prvy} → {posledny}</p>
      <h2 class="mt-4 font-display text-display font-extrabold uppercase leading-[0.9] tracking-tighter">Kto som</h2>
      <p class="mt-8 max-w-prose font-display text-xl font-bold leading-snug sm:text-2xl">
        Adam Rudavský. Desať rokov v zdravotníctve: domov seniorov, potom nemocnica. V roku 2025 notebook, na ktorom
        som sa začal hrať s AI. Z hry sa stal biznis cez agentov a od marca 2026 podnikám pod značkou XVADUR.
      </p>
      <p class="mt-5 max-w-prose text-lg leading-relaxed">
        Nemusíš mi veriť na slovo. Preto je na tomto webe viac účteniek ako prívlastkov.
      </p>
      <div class="mt-8 flex flex-col items-start gap-3">
        <a href={BEATY_CTA.href} class={LINK}>
          Celý príbeh v textoch
          <ArrowRightIcon size={22} weight="bold" aria-hidden="true" />
        </a>
        <a href="#postavil" class={LINK}>
          Radšej dôkazy
          <ArrowDownIcon size={22} weight="bold" aria-hidden="true" />
        </a>
      </div>
    </div>

    <ol class="flex flex-col gap-4" role="list" aria-label="Sedem zastávok">
      {
        BEATY.map((b, i) => (
          <li class="reveal flex flex-wrap items-start gap-x-5 gap-y-3 rounded-lg border-3 border-ink bg-white p-5 shadow-brutal-sm" style={`--i:${i}`}>
            <span class:list={['sticker shrink-0 text-sm', FARBY[i % FARBY.length]]} style={`--sticker-rotate:${i % 2 ? 3 : -4}deg`}>
              {nbsp(b.rok)}
            </span>
            <div class="min-w-0 flex-1 basis-56">
              <h3 class="font-display text-xl font-extrabold uppercase leading-tight tracking-tight">{b.titulok}</h3>
              <p class="mt-2 text-base leading-relaxed">{nbsp(b.text)}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
