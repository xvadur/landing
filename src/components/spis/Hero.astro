---
/** Hero V5.2 „spis“ (XDR-266). Web je spis, ktorý sa pred návštevníkom odtajňuje.
 *  Kompozícia: hlavička spisu + menu v jednom riadku a stále tlačidlo Konzultácia · obrí XVADUR podčiarknutý
 *  výstražnou páskou (žiadna zvislá čiara, R čitateľné, nič ho neprekrýva) · „DIVIDED, WE ARE USELESS.“ trvalo
 *  čitateľné (hover ho na chvíľu zašifruje) · veta s redakčnými pruhmi, ktoré sa po otvorení opony stiahnu ·
 *  fotka ako fotka v spise (svorka, pečiatka, popis) · čierna lišta so záznamom z Korpusu (pulz, čísla sa dopočítajú).
 *  Paleta: ink, paper, žltá (výstraha), stamp (pečiatka). 0 kB React: Wordmark je statické SVG, mechanika v spis.ts.
 *  Copy: Adamove vety z jadra (04_myslenie/svetonazor.md, línia „dešifrovanie“ 26. 9. 2026). */
import Wordmark from '@/components/hero/Wordmark';
import { KONZULTACIA_CTA, NAV } from '@/data/nav';
import { ZIVE_CISLA, ZIVE_CISLA_SNIMKA } from '@/data/fakty';
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';
import { XZnak } from '@/components/v5/Symboly';

const fmt = (n: number) => new Intl.NumberFormat('sk-SK').format(n).replace(/\s/g, ' ');
const navLink =
  'flex h-11 items-center px-3 font-display text-base font-extrabold uppercase tracking-wide underline-offset-8 hover:underline hover:decoration-[4px] hover:decoration-stamp';
---

<section id="uvod" class="spis-hero relative flex min-h-dvh flex-col overflow-hidden border-b-3 border-ink bg-paper" aria-label="Úvod">
  <div aria-hidden="true" class="tx-grain pointer-events-none absolute inset-0 [--tx:0.1]"></div>
  <div aria-hidden="true" class="spis-linky pointer-events-none absolute inset-0"></div>

  <!-- menu v jednom riadku -->
  <div class="relative z-30 border-b-3 border-ink bg-paper">
    <nav aria-label="Hlavná navigácia" class="mx-auto flex w-full max-w-[1600px] items-center justify-between gap-3 px-4 py-2.5 sm:px-6 lg:px-10">
      <a href="/" class="flex min-h-11 items-center gap-3" aria-label="XVADUR — domov">
        <XZnak className="h-9 w-8 text-yellow" />
        <span class="hidden font-mono text-xs font-bold uppercase tracking-[0.16em] sm:inline">Spis XVD · Adam Rudavský</span>
      </a>
      <div class="hidden items-center lg:flex">
        {NAV.map((item) => <a href={item.href.replace(/^\/#/, '#')} class={navLink}>{item.label}</a>)}
      </div>
      <div class="flex items-center gap-2">
        <button type="button" data-commandk class="press hidden h-11 items-center rounded-lg border-3 border-ink bg-white px-3 font-mono text-sm shadow-brutal-sm lg:flex" aria-label="Otvoriť príkazovú paletu (⌘K)" title="⌘K / Ctrl K">
          <span aria-hidden="true">⌘K</span>
        </button>
        <button type="button" data-nav-open aria-haspopup="dialog" aria-controls="mobilna-nav" class="press flex h-11 min-w-11 items-center justify-center rounded-lg border-3 border-ink bg-paper px-3 font-display text-sm font-extrabold uppercase shadow-brutal-sm lg:hidden">
          Menu
        </button>
        <a href={KONZULTACIA_CTA.hrefDomov} data-track="konzultacia_klik" data-track-miesto="hero-menu" class="press flex h-11 items-center rounded-lg border-3 border-ink bg-yellow px-4 font-display text-sm font-extrabold uppercase text-ink shadow-brutal-sm sm:text-base">
          {KONZULTACIA_CTA.label}
        </a>
      </div>
    </nav>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1600px] flex-1 flex-col px-4 pt-5 pb-8 sm:px-6 lg:px-10 lg:pt-5 lg:pb-7" data-rd-skupina>
    <!-- hlavička spisu -->
    <p class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs font-bold uppercase tracking-[0.16em] sm:text-sm">
      <span>Spis č. XVD-2026</span>
      <span aria-hidden="true">/</span>
      <span>Subjekt: Adam Rudavský</span>
      <span aria-hidden="true">/</span>
      <span>Stav: <span class="rd" data-rd data-rd-delay="200">odtajňuje sa</span></span>
    </p>

    <div class="mt-4 grid flex-1 gap-8 sm:mt-5 lg:grid-cols-[1fr_minmax(250px,22vw)] lg:gap-12">
    <div class="flex min-w-0 flex-col">
    <!-- XVADUR, podčiarknutý výstražnou páskou -->
    <h1 class="relative w-full" data-hero-wordmark style="perspective: 1200px">
      <span class="sr-only">XVADUR — Adam Rudavský</span>
      <Wordmark className="h-auto w-full origin-center will-change-transform [--wm-shadow:5px] sm:[--wm-shadow:10px]" />
    </h1>
    <div class="hero-ciara paska mt-3 h-[clamp(12px,1.5vw,24px)] w-full rounded-sm border-3 border-ink sm:mt-5" aria-hidden="true"></div>

      <div class="mt-7 flex flex-col gap-6 sm:mt-8 lg:mt-6 lg:gap-4">
        <!-- motto: trvalo čitateľné; hover ho na chvíľu zašifruje -->
        <p lang="en" class="font-display text-[clamp(2.5rem,0.6rem+5.4vw,5.5rem)] leading-[0.86] font-extrabold tracking-[-0.04em] uppercase">
          <span class="block sm:whitespace-nowrap"><span data-sifra>{MOTTO_1}</span></span>
          <span class="block sm:whitespace-nowrap"><span data-sifra>{MOTTO_2}</span></span>
        </p>

        <p class="max-w-3xl font-display text-2xl leading-[1.15] font-extrabold sm:text-3xl">
          Všetko dôležité je za zámkom. Ja ho{' '}<span class="whitespace-nowrap"><span class="rd" data-rd data-rd-delay="500"><span class="rd-t">odomykám</span></span>.</span>
        </p>
        <p class="max-w-2xl text-lg leading-relaxed">
          Staviam AI agentov, ktorí čítajú to, čo je zašifrované:{' '}<span class="whitespace-nowrap"><span class="rd" data-rd><span class="rd-t">trh</span></span>,</span>{' '}<span class="whitespace-nowrap"><span class="rd" data-rd><span class="rd-t">médiá</span></span>,</span>{' '}<span class="whitespace-nowrap"><span class="rd" data-rd><span class="rd-t">systém</span></span>.</span>{' '}Odstraňujem informačnú asymetriu. Pre firmy aj pre teba.
        </p>

        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
          <a href={KONZULTACIA_CTA.hrefDomov} data-track="konzultacia_klik" data-track-miesto="hero" data-cursor="termín" class="press inline-flex min-h-14 items-center justify-center gap-3 rounded-lg border-3 border-ink bg-yellow px-7 font-display text-lg font-extrabold uppercase text-ink shadow-brutal-lg sm:text-xl">
            Dohodni si konzultáciu
          </a>
          <a href="#dejstvo-1" class="press inline-flex min-h-14 items-center justify-center gap-3 rounded-lg border-3 border-ink bg-ink px-7 font-display text-lg font-extrabold uppercase text-paper shadow-brutal-lg sm:text-xl">
            Otvoriť spis <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>

      <!-- fotka v spise -->
      <figure class="spis-foto relative mx-auto mt-4 w-[74%] max-w-[340px] rotate-[2.5deg] lg:mx-0 lg:mt-2 lg:w-full lg:max-w-none lg:self-start">
        <div class="relative border-3 border-ink bg-white p-3 pb-4 shadow-brutal-lg">
          <img src="/assets/v5/adam-spis.webp" alt="Adam Rudavský" width="600" height="768" class="block aspect-[600/768] w-full border-3 border-ink object-cover" decoding="async" fetchpriority="high" />
          <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1 font-mono text-[0.7rem] font-bold uppercase tracking-[0.14em]">
            <span>Subjekt č. 1</span>
            <span>A. Rudavský / XVADUR</span>
          </figcaption>
        </div>
        <!-- svorka -->
        <svg class="absolute -top-7 left-8 h-20 w-8 -rotate-6" viewBox="0 0 32 80" aria-hidden="true">
          <path d="M9 72V14a7 7 0 0 1 14 0v50a4 4 0 0 1-8 0V20" fill="none" stroke="var(--color-ink)" stroke-width="3.5" stroke-linecap="round" />
        </svg>
        <span class="peciatka absolute bottom-16 -left-5 bg-paper text-lg sm:text-xl" style="--peciatka-rotate:-11deg; mix-blend-mode: normal">Odtajnené</span>
      </figure>
    </div>
  </div>

  <!-- záznam: čísla z Korpusu (pulz) -->
  <div class="relative z-20 border-t-3 border-ink bg-ink text-paper" aria-label="Záznam z Korpusu">
    <div class="mx-auto grid w-full max-w-[1600px] grid-cols-2 gap-x-4 gap-y-4 px-4 py-5 sm:px-6 lg:grid-cols-[auto_1.35fr_1fr_1fr_1.25fr] lg:items-center lg:gap-6 lg:px-10 lg:py-4">
      <div class="col-span-2 flex items-center justify-between gap-3 border-b border-paper/20 pb-3 lg:col-span-1 lg:block lg:border-0 lg:pb-0">
        <span class="inline-flex items-center gap-2 font-mono text-sm font-bold uppercase tracking-[0.16em]">
          <span class="relative flex h-3 w-3" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-stamp opacity-70 motion-safe:animate-ping"></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-stamp"></span>
          </span>
          Záznam
        </span>
        <span class="block font-mono text-xs uppercase tracking-[0.12em] text-paper/60 lg:mt-1" data-pulz-cas>Korpus · {ZIVE_CISLA_SNIMKA}</span>
      </div>
      {
        ZIVE_CISLA.map((z) => (
          <div class="flex flex-col gap-0.5 lg:flex-row lg:items-baseline lg:gap-3 lg:border-l-3 lg:border-paper/25 lg:pl-6" title={z.note}>
            <span class="font-display text-3xl font-extrabold tracking-tight whitespace-nowrap text-yellow tabular-nums sm:text-4xl lg:text-[2.6rem] xl:text-5xl" data-count={z.value} data-pulz={z.kluc}>
              {fmt(z.value)}
            </span>
            <span class="font-mono text-xs uppercase leading-tight tracking-[0.1em] lg:whitespace-nowrap">{z.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* linky ako na papieri spisu, veľmi jemné */
  .spis-linky {
    background-image: linear-gradient(to bottom, color-mix(in oklab, var(--color-ink) 7%, transparent) 1px, transparent 1px);
    background-size: 100% 34px;
  }
  /* podčiarknutie sa natiahne od stredu po otvorení opony (html.hero-go); bez JS stojí */
  :global(html.spis-js) .hero-ciara {
    transform: scaleX(0);
    transform-origin: 50% 50%;
    transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  :global(html.spis-js.hero-go) .hero-ciara {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.spis-js) .hero-ciara { transform: none; transition: none; }
  }
</style>

<script>
  import { initSpis } from './spis';

  /** náklon wordmarku za kurzorom (desktop s myšou, bez reduced motion) */
  function naklon() {
    const h = document.querySelector<HTMLElement>('[data-hero-wordmark]');
    const svg = h?.querySelector('svg');
    const sekcia = document.getElementById('uvod');
    if (!svg || !sekcia || !matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px) and (prefers-reduced-motion: no-preference)').matches) return;
    const cur = { x: 0, y: 0 };
    const tgt = { x: 0, y: 0 };
    let raf = 0;
    const tick = () => {
      cur.x += (tgt.x - cur.x) * 0.12;
      cur.y += (tgt.y - cur.y) * 0.12;
      svg.style.transform = `rotateX(${(-cur.y * 2.5).toFixed(3)}deg) rotate(${(cur.x * 1.6).toFixed(3)}deg)`;
      raf = Math.abs(tgt.x - cur.x) > 0.002 || Math.abs(tgt.y - cur.y) > 0.002 ? requestAnimationFrame(tick) : 0;
    };
    sekcia.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = sekcia.getBoundingClientRect();
      tgt.x = ((e.clientX - r.left) / r.width) * 2 - 1;
      tgt.y = ((e.clientY - r.top) / r.height) * 2 - 1;
      if (!raf) raf = requestAnimationFrame(tick);
    });
    sekcia.addEventListener('pointerleave', () => {
      tgt.x = 0;
      tgt.y = 0;
      if (!raf) raf = requestAnimationFrame(tick);
    });
  }

  /** pulz: prepíše snímku aktuálnymi číslami (/pulse.json), ak prídu skôr, než sa začnú dopočítavať */
  async function pulz() {
    try {
      const r = await fetch('/pulse.json', { cache: 'no-store' });
      if (!r.ok) return;
      const p = (await r.json()) as Record<string, number | string>;
      document.querySelectorAll<HTMLElement>('[data-pulz]').forEach((el) => {
        const v = p[el.dataset.pulz!];
        if (typeof v !== 'number') return;
        el.dataset.count = String(v);
        // bežiace dopočítavanie si nový cieľ prečíta samo; po dobehnutí ho prepíšeme priamo
        const text = new Intl.NumberFormat('sk-SK').format(v).replace(/\s/g, ' ');
        if (el.dataset.countDone) setTimeout(() => (el.textContent = text), 1500);
        else el.textContent = text;
      });
      if (typeof p.updated_at === 'string') {
        const cas = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Bratislava' }).format(new Date(p.updated_at));
        document.querySelectorAll('[data-pulz-cas]').forEach((c) => (c.textContent = `Korpus · ${cas}`));
      }
    } catch {
      /* ostáva snímka */
    }
  }

  function start() {
    const go = () => document.documentElement.classList.add('hero-go');
    if (document.getElementById('opona')) window.addEventListener('opona:done', go, { once: true });
    else requestAnimationFrame(go);
    naklon();
    void pulz();
    initSpis(document, true);
  }
  document.addEventListener('astro:page-load', start);
</script>
