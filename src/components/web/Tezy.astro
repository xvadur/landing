---
/** Tézy: Adamove doslovné vety (data.ts TEZY) v dvoch BoldKit Marquee pásoch proti sebe. Pás sa pri hoveri zastaví,
 *  reduced motion = stojí (motion.css). */
import { Marquee, MarqueeItem, MarqueeSeparator } from '@/components/ui/marquee';
import { TEZY } from './data';

const R1 = TEZY.slice(0, 3);
const R2 = TEZY.slice(3);
---

<section id="tezy" class="relative overflow-hidden border-b-3 border-ink bg-yellow py-16 lg:py-24" aria-labelledby="tezy-nadpis">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <p class="eyebrow">✚ 05 · Tézy</p>
    <h2 id="tezy-nadpis" class="mt-8 font-display text-display-lg font-extrabold uppercase tracking-tighter">Čo si myslím</h2>
  </div>
  <div class="mt-12 flex flex-col gap-6">
    <Marquee speed="slow" repeat={2} className="border-y-3 border-ink bg-paper">
      {R1.map((t) => (
        <MarqueeItem className="font-serif text-[clamp(1.5rem,1.1rem+1.4vw,2.4rem)] italic normal-case">
          „{t.veta}“ <span class="ml-3 font-mono text-sm not-italic uppercase tracking-[0.12em] text-ink/60">{t.kedy}</span>
          <MarqueeSeparator>✚</MarqueeSeparator>
        </MarqueeItem>
      ))}
    </Marquee>
    <Marquee speed="slow" direction="right" repeat={2} className="border-y-3 border-ink bg-ink text-paper">
      {R2.map((t) => (
        <MarqueeItem className="font-serif text-[clamp(1.5rem,1.1rem+1.4vw,2.4rem)] italic normal-case">
          „{t.veta}“ <span class="ml-3 font-mono text-sm not-italic uppercase tracking-[0.12em] text-paper/60">{t.kedy}</span>
          <MarqueeSeparator>✚</MarqueeSeparator>
        </MarqueeItem>
      ))}
    </Marquee>
  </div>
</section>
