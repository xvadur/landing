---
/** Konzultácia s rezerváciou (XDR-210) na domove: #konzultacia (cieľ všetkých tlačidiel „Konzultácia“ na domove).
 *  Vľavo prečo a ako (30 minút, zatiaľ zadarmo), vpravo rezervácia termínu (ostrov Rezervacia), pod ňou WhatsApp /
 *  e-mail ako druhá možnosť (existujúci Wizard, 4 otázky → predvyplnená správa). */
import Rezervacia from './Rezervacia';
import Wizard from '@/components/port/Wizard';
import { PRIEBEH } from '@/components/konzultacia/data';
import { Peciatka } from './Symboly';

interface Props {
  id?: string;
}
const { id = 'konzultacia' } = Astro.props;
---

<section id={id} class="relative overflow-hidden border-b-3 border-ink bg-lime" aria-labelledby={`${id}-nadpis`}>
  <div aria-hidden="true" class="tx-halftone pointer-events-none absolute inset-0 [--tx:14%]"></div>
  <div class="relative mx-auto grid w-full max-w-7xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[0.9fr_1.1fr] lg:gap-x-12 lg:gap-y-8 lg:px-10">
    <div class="flex min-w-0 flex-col gap-6 lg:col-start-1 lg:row-start-1">
      <p class="eyebrow">Konzultácia / 30 minút / Zatiaľ zadarmo</p>
      <h2 id={`${id}-nadpis`} class="font-display text-display font-extrabold uppercase leading-[0.9] tracking-tighter">
        Vyber si<br />termín.
      </h2>
      <p class="max-w-md font-display text-2xl font-bold leading-tight">Príď s jednou úlohou. Odídeš so smerom a písomným ďalším krokom.</p>
    </div>

    <div class="flex min-w-0 flex-col gap-6 lg:col-start-2 lg:row-span-2 lg:row-start-1" id={id === 'konzultacia' ? 'termin' : undefined}>
      <Rezervacia client:visible />
      <div class="flex flex-col gap-3 rounded-lg border-3 border-ink bg-paper p-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-bold">Radšej píšeš? Štyri otázky a WhatsApp pripraví správu.</p>
        <span data-track="whatsapp_klik" data-track-miesto="konzultacia">
          <Wizard client:idle label="Napísať cez WhatsApp" variant="white" className="w-full sm:w-auto" />
        </span>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-6 lg:col-start-1 lg:row-start-2">
      <p class="eyebrow">Ako prebehne 30 minút</p>
      <ol class="grid gap-2" role="list">
        {
          PRIEBEH.map((k) => (
            <li class="flex gap-3 rounded-lg border-3 border-ink bg-white px-4 py-3 shadow-brutal-sm">
              <span class="w-20 shrink-0 font-mono text-sm font-bold">{k.cas}</span>
              <span class="text-base font-bold leading-snug">{k.vznikne}</span>
            </li>
          ))
        }
      </ol>
      <Peciatka id={`${id}-peciatka`} text="30 minút" className="peciatka-toc hidden h-28 w-28 text-yellow lg:block" />
    </div>
  </div>
</section>
