---
/** Texty, Hriech a hry (XDR-214): posledný článok z kolekcie `texty`, Hriech ako vlastná publikácia (odkaz overený
 *  v DOKAZY), hry ako jedna karta „čoskoro“ — škrtací test ostáva živý na /hry/. Nič „V STAVBE“ bez dizajnu,
 *  žiadne mŕtve odkazy (Substack a hriech.xvadur.com overené 26. 9. 2026, QA: work/qa/odkazy.mjs). */
import { getCollection } from 'astro:content';
import { DOKAZY, OVERENE_DNA_TEXT } from '@/data/fakty';
import { datumSk, SUBSTACK_URL } from '@/components/texty/citanie';
import { Hviezda, XZnak } from './Symboly';

const texty = (await getCollection('texty')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posledny = texty[0];
const hriech = DOKAZY.find((d) => d.id === 'hriech')!;
const BTN = 'press inline-flex min-h-12 items-center gap-2 rounded-lg border-3 border-ink px-5 font-display text-base font-extrabold uppercase shadow-brutal-sm';
---

<section id="texty" class="relative overflow-hidden border-b-3 border-ink bg-sky" aria-labelledby="texty-nadpis">
  <div aria-hidden="true" class="tx-dots pointer-events-none absolute inset-0 [--tx:16%]"></div>
  <div class="relative mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow">Texty, Hriech, hry</p>
        <h2 id="texty-nadpis" class="mt-4 font-display text-display font-extrabold uppercase leading-[0.9] tracking-tighter">Hlas.</h2>
      </div>
      <p class="max-w-md text-lg">Píšem o tom, čo staviam. A cez Hriech rozoberám, ako fungujú slovenské médiá.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3 lg:gap-8">
      {
        posledny && (
          <article class="brutal lift relative flex flex-col gap-4 bg-white p-6 sm:p-8 lg:col-span-2">
            <span class="x-stamp" aria-hidden="true" />
            <p class="eyebrow">Posledný text · {datumSk(posledny.data.date)}</p>
            <h3 class="pr-10 font-display text-display-sm font-extrabold uppercase leading-[0.92] tracking-tighter">
              <a href={`/texty/${posledny.id}/`} class="no-underline hover:underline hover:decoration-[4px] hover:decoration-hot">
                {posledny.data.title}
              </a>
            </h3>
            <p class="max-w-prose font-serif text-2xl italic leading-snug">{posledny.data.description}</p>
            <div class="mt-auto flex flex-wrap gap-3 pt-2">
              <a href={`/texty/${posledny.id}/`} class:list={[BTN, 'bg-yellow']}>Čítať →</a>
              <a href="/texty/" class:list={[BTN, 'bg-white']}>Všetky texty</a>
              <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class:list={[BTN, 'bg-white']}>Substack ↗</a>
            </div>
          </article>
        )
      }

      <article class="brutal lift relative flex flex-col gap-4 overflow-hidden bg-pink p-0">
        <img src={hriech.obrazok!} alt="Hriech — náhľad publikácie" width="960" height="600" loading="lazy" decoding="async" class="aspect-[16/10] w-full border-b-3 border-ink object-cover object-top" />
        <div class="flex flex-1 flex-col gap-3 px-6 pb-6">
          <p class="eyebrow">Mediálna kritika</p>
          <h3 class="font-display text-3xl font-extrabold uppercase tracking-tight">Hriech</h3>
          <p class="text-base">{hriech.riadok}</p>
          <a href={hriech.url!} target="_blank" rel="noopener noreferrer" data-track="dokaz_klik" data-track-miesto="hriech-texty" class:list={[BTN, 'mt-auto self-start bg-white']}>
            hriech.xvadur.com ↗
          </a>
          <p class="font-mono text-xs uppercase tracking-[0.1em]">overené {OVERENE_DNA_TEXT}</p>
        </div>
      </article>
    </div>

    <!-- hry: jedna karta čoskoro + živý škrtací test -->
    <article id="hry" class="relative mt-8 grid gap-6 overflow-hidden rounded-lg border-3 border-ink bg-yellow p-6 shadow-brutal-lg sm:p-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <Hviezda className="pointer-events-none absolute -right-6 -bottom-8 h-36 w-36 -rotate-12 text-hot opacity-90" />
      <div class="relative">
        <div class="flex flex-wrap items-center gap-3">
          <p class="eyebrow">Hry</p>
          <span class="sticker bg-white text-xs" style="--sticker-rotate:-4deg">Čoskoro viac</span>
        </div>
        <h3 class="mt-4 font-display text-display-xs font-extrabold uppercase leading-[0.95] tracking-tight">Veci, ktoré si vyskúšaš namiesto brožúry.</h3>
        <p class="mt-3 max-w-xl text-lg">Ďalšie hry staviam. Jedna už beží: vlož svoj text a škrtneme frázy, ktoré má každý.</p>
      </div>
      <div class="relative flex flex-wrap gap-3 lg:justify-end">
        <a href="/hry/skrtaci-test/" class:list={[BTN, 'bg-hot text-lg']}>
          <XZnak className="h-6 w-5 text-white" />
          Škrtací test
        </a>
        <a href="/hry/" class:list={[BTN, 'bg-white']}>Všetky hry</a>
      </div>
    </article>
  </div>
</section>
