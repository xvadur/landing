---
/** Kto som V5.3 (XDR-267): cesta na prvé čítanie — nemocnica → vyhodili → AI → agenti → XVADUR (src/data/cesta.ts).
 *  Desktop ≥ 1024 px bez reduced motion: sekcia sa pripne a cesta ide vodorovne so scrollom (GSAP ScrollTrigger sa
 *  načíta iba tu), pod kartami beží EKG krivka ako os. Mobil, tablet a reduced motion: zvislá cesta s čiarou vľavo.
 *  Tmavé pozadie, bez pastelov: papier, žltá, alarmová červená. */
import { CESTA } from '@/data/cesta';
import { ekgPath, Kriz, Sipka } from './Symboly';
import { ZdravotnikPlaceholder } from './Symboly';

const posledny = CESTA.length - 1;
---

<section id="kto-som" class="ks relative overflow-hidden border-b-3 border-ink bg-ink text-paper" aria-labelledby="kto-som-nadpis">
  <div class="ks-pin relative flex flex-col py-16 sm:py-20 lg:h-dvh lg:py-0">
    <div class="mx-auto flex w-full max-w-[1600px] flex-wrap items-end justify-between gap-6 px-4 sm:px-6 lg:px-10 lg:pt-12">
      <div>
        <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-yellow">Kto som / anamnéza</p>
        <h2 id="kto-som-nadpis" class="mt-3 font-display text-[clamp(2.75rem,1rem+5vw,5.75rem)] leading-[0.88] font-extrabold tracking-tighter uppercase">
          Z nemocnice<br />k agentom.
        </h2>
      </div>
      <p class="max-w-md pb-2 text-lg text-paper/80 sm:text-xl">
        Desať rokov som sa staral o ľudí. Dnes sa starám o firmy a ľudí, ktorých technológia obchádza.
      </p>
    </div>

    <div class="ks-okno relative mt-10 flex-1 lg:mt-6 lg:flex lg:items-center">
      <ol class="ks-pas relative flex flex-col gap-6 px-4 sm:px-6 lg:flex-row lg:gap-10 lg:px-10" role="list">
        <!-- os: EKG krivka (desktop) / zvislá čiara (mobil) -->
        <li aria-hidden="true" class="ks-os pointer-events-none absolute top-0 bottom-0 left-[calc(1rem+13px)] w-[3px] bg-yellow sm:left-[calc(1.5rem+13px)] lg:hidden"></li>
        <li aria-hidden="true" class="ks-ekg pointer-events-none absolute top-1/2 right-0 left-0 hidden h-12 -translate-y-1/2 lg:block">
          <svg viewBox="0 0 2400 40" preserveAspectRatio="none" class="h-full w-full">
            <path d={ekgPath(2400, 300)} fill="none" stroke="var(--color-yellow)" stroke-width="3" vector-effect="non-scaling-stroke" />
          </svg>
        </li>
        {
          CESTA.map((k, i) => (
            <li class="ks-karta relative flex gap-4 pl-10 sm:pl-12 lg:w-[440px] lg:shrink-0 lg:pl-0">
              <span
                aria-hidden="true"
                class:list={[
                  'absolute top-6 left-0 flex h-7 w-7 items-center justify-center rounded-full border-3 border-ink font-mono text-xs font-bold lg:hidden',
                  i === 1 ? 'bg-stamp text-paper' : 'bg-yellow text-ink',
                ]}
              >
                {i + 1}
              </span>
              <article
                class:list={[
                  'relative flex w-full flex-col gap-4 rounded-lg border-3 p-6 sm:p-7 lg:min-h-[min(52vh,460px)]',
                  i === 1 ? 'border-paper bg-stamp text-paper' : i === posledny ? 'border-ink bg-yellow text-ink' : 'border-ink bg-paper text-ink',
                  i % 2 ? 'lg:translate-y-6' : 'lg:-translate-y-6',
                ]}
                style={`box-shadow: 8px 8px 0 0 ${i === 1 || i === posledny ? 'var(--color-paper)' : 'var(--color-yellow)'}`}
              >
                <div class="flex items-center justify-between gap-3 font-mono text-xs font-bold uppercase tracking-[0.16em]">
                  <span>{String(i + 1).padStart(2, '0')} / {String(CESTA.length).padStart(2, '0')}</span>
                  <span>{k.kedy}</span>
                </div>
                <h3 class="font-display text-[clamp(2.4rem,1.6rem+3vw,4rem)] leading-[0.9] font-extrabold tracking-tighter uppercase">{k.nazov}</h3>
                <p class="text-lg leading-relaxed">{k.text}</p>
                {k.citat && (
                  <blockquote class="mt-auto border-t-3 border-paper/60 pt-4 font-display text-xl leading-snug font-bold">
                    „{k.citat}“
                  </blockquote>
                )}
                {i === posledny && (
                  <div class="mt-auto flex items-end justify-between gap-4">
                    <a
                      href="#konzultacia"
                      data-track="konzultacia_klik"
                      data-track-miesto="kto-som"
                      class="press inline-flex min-h-12 items-center gap-2 rounded-lg border-3 border-ink bg-ink px-4 font-display text-base font-extrabold uppercase text-paper shadow-brutal-sm"
                    >
                      Objednaj sa →
                    </a>
                    <div class="h-24 w-24 shrink-0 rotate-6 overflow-hidden rounded-[28%] border-3 border-ink bg-white shadow-brutal-sm">
                      <ZdravotnikPlaceholder className="h-full w-full" />
                    </div>
                  </div>
                )}
                {i === 0 && <Kriz className="absolute -top-5 -right-4 h-12 w-12 rotate-12 text-stamp" />}
              </article>
            </li>
          ))
        }
        <li class="ks-koniec hidden w-[300px] shrink-0 flex-col justify-center gap-4 lg:flex" aria-hidden="true">
          <p class="font-display text-display-sm leading-[0.9] font-extrabold tracking-tighter uppercase">Ďalší pacient: ty.</p>
          <Sipka className="h-20 w-20 text-yellow" smer="dole" />
        </li>
      </ol>
      <div class="ks-priebeh pointer-events-none absolute right-10 bottom-6 left-10 hidden h-3 overflow-hidden rounded-full border-2 border-paper/40 lg:block" aria-hidden="true">
        <div class="ks-priebeh-bar h-full w-full origin-left scale-x-0 bg-yellow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* desktop bez JS / reduced motion: cesta ako mriežka, bez EKG osi a priebehu */
  @media (min-width: 1024px) {
    .ks:not([data-gsap]) .ks-pin {
      height: auto;
      padding-bottom: 6rem;
    }
    .ks:not([data-gsap]) .ks-pas {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 3.5rem;
    }
    .ks:not([data-gsap]) .ks-karta {
      width: 380px;
    }
    .ks:not([data-gsap]) .ks-koniec,
    .ks:not([data-gsap]) .ks-priebeh,
    .ks:not([data-gsap]) .ks-ekg {
      display: none;
    }
    .ks[data-gsap] .ks-pas {
      width: max-content;
      will-change: transform;
    }
  }
</style>

<script>
  /* GSAP (≈ 44 kB gz) sa načíta iba na desktope bez reduced motion — mobil ho nesťahuje vôbec. */
  const MQ = '(min-width: 1024px) and (prefers-reduced-motion: no-preference)';
  let mm: { revert: () => void } | null = null;

  async function init() {
    mm?.revert();
    mm = null;
    const sekcia = document.querySelector<HTMLElement>('.ks');
    const pas = sekcia?.querySelector<HTMLElement>('.ks-pas');
    const bar = sekcia?.querySelector<HTMLElement>('.ks-priebeh-bar');
    if (!sekcia || !pas || !window.matchMedia(MQ).matches) return;
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);
    const m = gsap.matchMedia();
    mm = m;
    m.add(MQ, () => {
      sekcia.dataset.gsap = '';
      const vzdialenost = () => Math.max(0, pas.scrollWidth - window.innerWidth + 80);
      const lenis = (window as unknown as { __lenis?: { on: (e: string, f: () => void) => void; off?: (e: string, f: () => void) => void } }).__lenis;
      const upd = () => ScrollTrigger.update();
      lenis?.on('scroll', upd);
      const tl = gsap.timeline({
        scrollTrigger: { trigger: sekcia, start: 'top top', end: () => `+=${vzdialenost()}`, pin: true, scrub: 0.6, invalidateOnRefresh: true, anticipatePin: 1 },
      });
      tl.to(pas, { x: () => -vzdialenost(), ease: 'none' }, 0);
      if (bar) tl.to(bar, { scaleX: 1, ease: 'none' }, 0);
      ScrollTrigger.refresh();
      return () => {
        delete sekcia.dataset.gsap;
        lenis?.off?.('scroll', upd);
      };
    });
  }

  document.addEventListener('astro:page-load', () => void init());
  document.addEventListener('astro:before-swap', () => {
    mm?.revert();
    mm = null;
  });
</script>
