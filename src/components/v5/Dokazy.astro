---
/** Pacienti (XDR-208 → V5.3 XDR-267): dôkazy podľa toho, pre koho sú.
 *  1. Pacienti postavení na nohy (klienti): Jakub, maklér · Lucia, terapeutka — chorobopis: príjem → liečba → stav.
 *  2. Verejnosť: Hriech = diagnóza médií, Netopier = jeho laboratórium.
 *  3. Vlastné vitálne funkcie: Korpus, zdravotné dáta, agentový systém.
 *  4. Ďalšie záznamy: trhový dataset, tento web, v príprave (senior atlas, gramata — bez odkazu).
 *  Odkazy iba s overeným HTTP 200 a dátumom (QA: node work/qa/odkazy.mjs). Jakubov web bez odkazu (súhlas + starý deploy).
 *  Bez pastelov: papier, biela, žltá, čierna, alarmová červená. Čisté Astro, 0 JS. */
import { DOKAZY, KORPUS, OVERENE_DNA_TEXT, PRIPAD_MAKLER, PRIPAD_TERAPEUTKA, type Dokaz } from '@/data/fakty';
import { Kriz } from './Symboly';
import { nbsp } from '@/components/home/nbsp';

const datum = (iso: string | null) => (iso ? iso.split('-').reverse().map((x, i) => (i < 2 ? String(Number(x)) : x)).join('. ') : '');
const domena = (u: string) => new URL(u).hostname;
const skupina = (pre: Dokaz['pre']) => DOKAZY.filter((d) => d.pre === pre);
const STITOK: Record<string, string> = { 'AI agent': 'bg-stamp text-paper', web: 'bg-white', dáta: 'bg-yellow', médiá: 'bg-ink text-paper' };

const PACIENTI = [
  { ...PRIPAD_MAKLER, dokaz: DOKAZY.find((d) => d.id === 'system-pre-maklera')!, url: null as string | null },
  { ...PRIPAD_TERAPEUTKA, dokaz: DOKAZY.find((d) => d.id === 'terapeutka')!, cisla: null },
];
const BTN = 'press inline-flex min-h-11 items-center gap-2 rounded-lg border-3 border-ink px-4 font-display text-base font-extrabold uppercase shadow-brutal-sm';
---

<section id="dokazy" class="relative overflow-hidden border-b-3 border-ink bg-yellow" aria-labelledby="dokazy-nadpis">
  <div aria-hidden="true" class="tx-halftone pointer-events-none absolute inset-0 [--tx:10%]"></div>
  <div class="relative mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow">Pacienti / Príjem → diagnóza → liečba</p>
        <h2 id="dokazy-nadpis" class="mt-4 font-display text-display leading-[0.9] font-extrabold tracking-tighter uppercase">
          Postavení<br />na nohy.
        </h2>
      </div>
      <p class="max-w-md text-lg">Nič netvrdím, ukazujem chorobopisy. Kde systém žije, je tam odkaz a dátum, kedy som ho naposledy overil.</p>
    </div>

    <!-- 1 · pacienti -->
    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      {
        PACIENTI.map((pc, i) => (
          <article class="relative flex flex-col overflow-hidden rounded-lg border-3 border-ink bg-white" style="box-shadow: var(--shadow-brutal-xl)" aria-label={`Chorobopis: ${pc.kto}`}>
            <header class="flex flex-wrap items-center justify-between gap-3 border-b-3 border-ink bg-ink px-5 py-4 text-paper sm:px-7">
              <div class="flex items-center gap-3">
                <Kriz className="h-8 w-8 text-stamp" />
                <div>
                  <p class="font-mono text-xs uppercase tracking-[0.16em] text-paper/70">Chorobopis č. {i + 1}</p>
                  <h3 class="font-display text-2xl font-extrabold uppercase tracking-tight sm:text-3xl">{pc.kto}</h3>
                </div>
              </div>
              <ul class="flex flex-wrap gap-2" role="list" aria-label="Štítky">
                {pc.dokaz.stitky.map((s) => (
                  <li class:list={['rounded-sm border-2 border-paper px-2 py-0.5 font-mono text-xs font-bold uppercase tracking-[0.1em] text-ink', STITOK[s]]}>{s}</li>
                ))}
              </ul>
            </header>
            <div class="grid flex-1 gap-6 p-5 sm:grid-cols-2 sm:p-7">
              <div>
                <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-stamp">Príjem · stav pri príjme</p>
                <ul class="mt-3 grid gap-2" role="list">
                  {pc.mal.map((m) => <li class="flex gap-2 leading-snug"><span class="font-bold text-stamp" aria-hidden="true">✕</span>{m}</li>)}
                </ul>
              </div>
              <div>
                <p class="font-mono text-xs font-bold uppercase tracking-[0.16em]">Liečba · čo som nasadil</p>
                <ul class="mt-3 grid gap-2" role="list">
                  {pc.dostal.map((m) => <li class="flex gap-2 leading-snug font-bold"><span aria-hidden="true">✓</span>{nbsp(m)}</li>)}
                </ul>
              </div>
            </div>
            <footer class="flex flex-wrap items-center justify-between gap-4 border-t-3 border-ink bg-paper px-5 py-4 sm:px-7">
              <div>
                <p class="font-mono text-xs font-bold uppercase tracking-[0.16em]">Stav</p>
                <p class="text-sm">{pc.stav}</p>
              </div>
              {pc.cisla ? (
                <p class="flex items-baseline gap-2"><span class="font-display text-4xl font-extrabold tabular-nums">{nbsp(pc.cisla[0]!.value)}</span><span class="font-mono text-xs uppercase tracking-[0.1em]">{pc.cisla[0]!.label}</span></p>
              ) : pc.url ? (
                <div class="flex flex-col items-end gap-1">
                  <a href={pc.url} target="_blank" rel="noopener noreferrer" data-track="dokaz_klik" data-track-miesto={pc.dokaz.id} class:list={[BTN, 'bg-yellow']}>
                    {domena(pc.url)} <span aria-hidden="true">↗</span>
                  </a>
                  <span class="font-mono text-xs uppercase tracking-[0.1em]">overené {OVERENE_DNA_TEXT}</span>
                </div>
              ) : null}
            </footer>
          </article>
        ))
      }
    </div>

    <!-- 2 · verejnosť, 3 · vlastné vitálne funkcie -->
    <div class="mt-16 grid gap-8 lg:grid-cols-2">
      {
        [
          { pre: 'verejnost' as const, nadpis: 'Diagnóza médií', eyebrow: 'Pre verejnosť', bg: 'bg-ink text-paper', tien: 'var(--color-paper)' },
          { pre: 'vlastne' as const, nadpis: 'Vlastné vitálne funkcie', eyebrow: 'Na sebe', bg: 'bg-white text-ink', tien: 'var(--color-ink)' },
        ].map((g) => (
          <div class:list={['flex flex-col rounded-lg border-3 border-ink p-6 sm:p-8', g.bg]} style={`box-shadow: 9px 9px 0 0 ${g.tien}`}>
            <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] opacity-70">{g.eyebrow}</p>
            <h3 class="mt-2 font-display text-display-xs leading-[0.95] font-extrabold uppercase tracking-tight">{g.nadpis}</h3>
            {g.pre === 'verejnost' && (
              <p class="mt-3 text-lg opacity-85">Hriech nie je názor. Je to diagnóza: kto vlastní médiá, kto ich vedie a kto tvorí obsah, zložené do jednej mapy.</p>
            )}
            {g.pre === 'vlastne' && (
              <p class="mt-3 text-lg">Najprv som to skúšal na sebe. Každý prompt, každý deň: {nbsp(KORPUS.slova)} vlastných slov od {KORPUS.od}.</p>
            )}
            <ul class="mt-6 grid gap-4" role="list">
              {skupina(g.pre).map((d) => (
                <li class="grid items-start gap-x-4 gap-y-2 border-t-2 border-dashed border-current/30 pt-4 sm:grid-cols-[1fr_auto]">
                  <div class="min-w-0">
                    <p class="font-display text-xl font-extrabold uppercase">{d.nazov}</p>
                    <p class="text-sm opacity-80">{nbsp(d.riadok)}</p>
                  </div>
                  <div class="flex flex-row items-baseline gap-2 sm:flex-col sm:items-end sm:gap-1 sm:text-right">
                    <span class="font-display text-3xl font-extrabold tabular-nums">{nbsp(d.cislo)}</span>
                    <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] opacity-80">{d.cisloPopis}</span>
                  </div>
                  {d.url && (
                    <div class="flex flex-wrap items-center justify-between gap-3 sm:col-span-2">
                      <a href={d.url} target="_blank" rel="noopener noreferrer" data-track="dokaz_klik" data-track-miesto={d.id} class:list={[BTN, 'bg-yellow text-ink']}>
                        {domena(d.url)} <span aria-hidden="true">↗</span>
                      </a>
                      <span class="font-mono text-xs uppercase tracking-[0.1em] opacity-70">overené {datum(d.overene)}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- 4 · ďalšie záznamy -->
    <div class="mt-16">
      <p class="eyebrow">Ďalšie záznamy</p>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          skupina('dalsie').map((d) => (
            <li class:list={['flex flex-col gap-2 rounded-lg border-3 border-ink p-5 shadow-brutal', d.stav === 'coskoro' ? 'bg-paper' : 'bg-white']}>
              <div class="flex items-center justify-between gap-2">
                <p class="font-display text-lg font-extrabold uppercase">{d.nazov}</p>
                {d.stav === 'coskoro' && <span class="rounded-sm border-2 border-ink bg-ink px-2 py-0.5 font-mono text-[0.65rem] font-bold uppercase tracking-[0.1em] text-paper">v príprave</span>}
              </div>
              <p class="font-display text-3xl font-extrabold tabular-nums">{nbsp(d.cislo)}</p>
              <p class="text-sm">{nbsp(d.cisloPopis)}</p>
              {d.url ? (
                <div class="mt-auto flex flex-col gap-1">
                  <a href={d.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-mono text-xs font-bold uppercase tracking-[0.1em] underline decoration-2 underline-offset-4">
                    {domena(d.url)} ↗
                  </a>
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink/60">overené {datum(d.overene)}</span>
                </div>
              ) : (
                <span class="mt-auto font-mono text-xs uppercase tracking-[0.1em] text-ink/60">{d.poznamka ?? 'bez verejného odkazu'}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
