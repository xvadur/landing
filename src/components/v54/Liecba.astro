---
/** V5.4 Liečba (vzor „Services“ z cohesion.framer.ai): tri kroky s obrími obrysovými číslami 01–03, číslo je na
 *  desktope prilepené vľavo, text a karta idú vpravo. Triáž → zásah → odovzdanie. Obsah z src/data/ponuka.ts. */
import { PRECO_NIE_CHATGPT, PRODUKTY, VLAJKA } from '@/data/ponuka';
import { Blesk, Hviezda, Kriz } from '@/components/v5/Symboly';

const agent = PRODUKTY.find((p) => p.id === 'agent-pre-teba')!;
const ucenie = PRODUKTY.filter((p) => p.id !== 'agent-pre-teba');
---

<section id="liecba" class="lie relative border-b-3 border-ink bg-paper" aria-labelledby="lie-nadpis">
  <div class="mx-auto w-full max-w-[1400px] px-4 pt-24 pb-8 text-center sm:px-6 sm:pt-32 lg:px-10">
    <p class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-ink/60">✚ 03 · Liečba</p>
    <h2 id="lie-nadpis" class="mt-4 font-display text-[clamp(3rem,1.4rem+6vw,7rem)] leading-[0.86] font-extrabold tracking-tighter uppercase">
      Triáž. Zásah.<br />Odovzdanie.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink/75 sm:text-xl">Postup ako na zmene. Najprv zistím, čo bolí. Potom najmenší zásah, ktorý pomôže. Na konci ti to odovzdám tak, aby to išlo aj bezo mňa.</p>
  </div>

  <ol class="mx-auto flex w-full max-w-[1400px] flex-col px-4 pb-24 sm:px-6 lg:px-10" role="list">
    <!-- 01 triáž -->
    <li class="lie-krok grid gap-6 border-t-4 border-ink py-12 lg:grid-cols-[minmax(300px,0.8fr)_1.2fr] lg:gap-12 lg:py-20">
      <div class="lie-hlava lg:sticky lg:top-28 lg:self-start">
        <span class="lie-cislo" aria-hidden="true">01</span>
        <h3 class="-mt-[0.5em] font-display text-4xl leading-none font-extrabold uppercase sm:text-5xl">Triáž</h3>
        <p class="mt-3 font-mono text-sm font-bold uppercase tracking-[0.14em]">{VLAJKA.nazov} · {VLAJKA.trvanie} · {VLAJKA.cena}</p>
      </div>
      <div class="relative flex flex-col gap-6">
        <p class="font-display text-3xl leading-tight font-extrabold sm:text-4xl">{VLAJKA.titulok}</p>
        <ul class="grid gap-4" role="list">
          {
            VLAJKA.body.map((b, i) => (
              <li class="flex gap-4 rounded-2xl border-3 border-ink bg-white p-5 shadow-brutal-sm">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-3 border-ink bg-yellow font-mono font-bold">{i + 1}</span>
                <span class="text-lg leading-snug">{b}</span>
              </li>
            ))
          }
        </ul>
        <a href="#konzultacia" data-track="konzultacia_klik" data-track-miesto="liecba" class="press inline-flex min-h-14 w-fit items-center gap-2 rounded-full border-3 border-ink bg-hot px-7 font-display text-lg font-extrabold uppercase shadow-brutal">
          Vyber si termín →
        </a>
        <Kriz className="lie-sym absolute -top-8 right-0 hidden w-20 rotate-12 text-stamp lg:block" />
      </div>
    </li>

    <!-- 02 zásah -->
    <li class="lie-krok grid gap-6 border-t-4 border-ink py-12 lg:grid-cols-[minmax(300px,0.8fr)_1.2fr] lg:gap-12 lg:py-20">
      <div class="lie-hlava lg:sticky lg:top-28 lg:self-start">
        <span class="lie-cislo" aria-hidden="true">02</span>
        <h3 class="-mt-[0.5em] font-display text-4xl leading-none font-extrabold uppercase sm:text-5xl">Zásah</h3>
        <p class="mt-3 font-mono text-sm font-bold uppercase tracking-[0.14em]">{agent.nalepka} · {agent.pre}</p>
      </div>
      <div class="relative flex flex-col gap-6">
        <p class="font-display text-3xl leading-tight font-extrabold sm:text-4xl">{agent.nazov}. {agent.popis}</p>
        <div class="overflow-hidden rounded-2xl border-4 border-ink shadow-[8px_8px_0_0_var(--color-ink)]">
          <div class="grid grid-cols-2 border-b-4 border-ink font-display text-lg font-extrabold uppercase sm:text-xl">
            <span class="bg-white px-4 py-3">Chat</span>
            <span class="border-l-4 border-ink bg-yellow px-4 py-3">Agent</span>
          </div>
          {
            PRECO_NIE_CHATGPT.map((r, i) => (
              <div class:list={['grid grid-cols-2 text-base leading-snug sm:text-lg', i > 0 && 'border-t-3 border-ink']}>
                <span class="bg-white px-4 py-3 text-ink/70 line-through decoration-stamp decoration-2">{r.chat}</span>
                <span class="border-l-4 border-ink bg-yellow/40 px-4 py-3">{r.agent}</span>
              </div>
            ))
          }
        </div>
        <Blesk className="lie-sym absolute -top-10 right-2 hidden w-16 rotate-12 text-yellow lg:block" />
      </div>
    </li>

    <!-- 03 odovzdanie -->
    <li class="lie-krok grid gap-6 border-t-4 border-ink py-12 lg:grid-cols-[minmax(300px,0.8fr)_1.2fr] lg:gap-12 lg:py-20">
      <div class="lie-hlava lg:sticky lg:top-28 lg:self-start">
        <span class="lie-cislo" aria-hidden="true">03</span>
        <h3 class="-mt-[0.5em] font-display text-4xl leading-none font-extrabold uppercase sm:text-5xl">Odovzdanie</h3>
        <p class="mt-3 font-mono text-sm font-bold uppercase tracking-[0.14em]">Aby to išlo aj bezo mňa</p>
      </div>
      <div class="relative flex flex-col gap-6">
        <p class="font-display text-3xl leading-tight font-extrabold sm:text-4xl">Naučím ťa robiť to, čo robím ja. Po slovensky, na tvojej vlastnej úlohe.</p>
        <div class="grid gap-5 sm:grid-cols-3">
          {
            ucenie.map((p, i) => (
              <article class:list={['lift flex flex-col gap-3 rounded-2xl border-4 border-ink p-5 shadow-[6px_6px_0_0_var(--color-ink)]', p.farba]} style={`transform: rotate(${[-1.5, 1, -0.8][i] ?? 0}deg)`}>
                <span class="w-fit rounded-full border-2 border-ink bg-paper px-3 py-1 font-mono text-xs font-bold uppercase tracking-[0.1em]">{p.nalepka}</span>
                <h4 class="font-display text-2xl leading-none font-extrabold uppercase">{p.nazov}</h4>
                <p class="text-base leading-snug">{p.popis}</p>
                <a href="#zapis" class="mt-auto font-display text-base font-extrabold uppercase underline decoration-3 underline-offset-4">Chcem vedieť ako prvý →</a>
              </article>
            ))
          }
        </div>
        <Hviezda className="lie-sym absolute -top-12 right-0 hidden w-20 text-hot lg:block" />
      </div>
    </li>
  </ol>
</section>

<style>
  .lie-cislo {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(8rem, 5rem + 12vw, 17rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 4px var(--color-ink);
    text-shadow: 10px 10px 0 var(--color-yellow);
  }
  .lie-sym {
    animation: lsym 7s ease-in-out infinite;
  }
  @keyframes lsym {
    50% {
      transform: translateY(-12px) rotate(8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lie-sym {
      animation: none;
    }
  }
</style>
