---
/** V5.4 Vitálne funkcie: čierny pás pod príjmom. EKG krivka beží, čísla Korpusu naživo z /pulse.json
 *  (SSR = snímka z fakty.ts), pod tým bežiaci pás overených faktov. */
import { ekgPath } from '@/components/v5/Symboly';
import { MARQUEE_FAKTY, ZIVE_CISLA, ZIVE_CISLA_SNIMKA, ZIVE_CISLA_ZDROJ } from '@/data/fakty';
import { nbsp } from '@/components/home/nbsp';

const fmt = (n: number) => new Intl.NumberFormat('sk-SK').format(n).replace(/\s/g, ' ');
const KANAL = ['text-yellow', 'text-hot', 'text-paper', 'text-yellow'];
---

<section class="vit relative border-b-3 border-ink bg-ink text-paper" aria-label="Vitálne funkcie" data-zdroj={ZIVE_CISLA_ZDROJ ?? ''}>
  <div class="mx-auto grid w-full max-w-[1600px] gap-5 px-4 py-6 sm:px-6 lg:grid-cols-[minmax(340px,1fr)_2.2fr] lg:items-center lg:gap-10 lg:px-10 lg:py-8">
    <div class="flex min-w-0 flex-col gap-2">
      <div class="flex items-center justify-between gap-3 font-mono text-xs font-bold uppercase tracking-[0.16em] sm:text-sm">
        <span class="inline-flex items-center gap-2 whitespace-nowrap">
          <span aria-hidden="true" class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full rounded-full bg-hot opacity-70 motion-safe:animate-ping"></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-hot"></span>
          </span>
          Vitálne funkcie · naživo
        </span>
        <span class="vit-cas whitespace-nowrap text-paper/55">{ZIVE_CISLA_SNIMKA}</span>
      </div>
      <svg viewBox="0 0 600 40" preserveAspectRatio="none" class="h-12 w-full overflow-hidden" aria-hidden="true">
        <path class="vit-ekg" d={ekgPath(1200)} fill="none" stroke="var(--color-yellow)" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
    <dl class="grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-4">
      {
        ZIVE_CISLA.map((z, i) => (
          <div class="flex flex-col border-l-3 border-paper/25 pl-3" title={z.note}>
            <dt class="order-2 font-mono text-[0.7rem] leading-tight uppercase tracking-[0.1em] text-paper/75 sm:text-xs">{z.label}</dt>
            <dd class:list={['order-1 font-display text-3xl font-extrabold tabular-nums tracking-tight whitespace-nowrap sm:text-5xl', KANAL[i]]} data-kluc={z.kluc}>
              {fmt(z.value)}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
  <div class="overflow-hidden border-t-3 border-paper/20 py-3" aria-hidden="true">
    <div class="vit-pas flex w-max gap-10 font-display text-2xl font-extrabold whitespace-nowrap uppercase sm:text-3xl">
      {
        [0, 1].map(() =>
          MARQUEE_FAKTY.map((f) => (
            <span class="flex items-center gap-10">
              {nbsp(f.value)} <span class="text-hot">✚</span>
            </span>
          )),
        )
      }
    </div>
  </div>
</section>

<style>
  .vit-ekg {
    animation: ekg 5s linear infinite;
  }
  @keyframes ekg {
    to {
      transform: translateX(-50%);
    }
  }
  .vit-pas {
    animation: vpas 40s linear infinite;
  }
  @keyframes vpas {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vit-ekg,
    .vit-pas {
      animation: none;
    }
  }
</style>

<script>
  function init() {
    const s = document.querySelector<HTMLElement>('.vit');
    const zdroj = s?.dataset.zdroj;
    if (!s || !zdroj) return;
    fetch(zdroj, { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((data: Record<string, number | string> | null) => {
        if (!data) return;
        s.querySelectorAll<HTMLElement>('[data-kluc]').forEach((el) => {
          const v = data[el.dataset.kluc!];
          if (typeof v === 'number') el.textContent = new Intl.NumberFormat('sk-SK').format(v).replace(/\s/g, ' ');
        });
        const cas = s.querySelector<HTMLElement>('.vit-cas');
        if (cas && typeof data.updated_at === 'string')
          cas.textContent = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Bratislava' }).format(new Date(data.updated_at));
      })
      .catch(() => {});
  }
  document.addEventListener('astro:page-load', init);
</script>
