---
/** Hlavička: wordmark (transition:name="wordmark"), nav zo src/data/nav.ts, ⌘K, mobilná navigácia.
 *  Hrubá spodná linka 3 px. Sticky (výška = --header-h v tokens.css).
 *  Mobilná navigácia je natívny <dialog> + delegovaný skript (0 kB React): do 19. 9. to bol vaul Drawer ako React ostrov
 *  (client:media ≤ 1023 px), ktorý ťahal React runtime + vaul ≈ 92 kB gz na každú stránku vrátane článkov — doc 10 chce
 *  články 0 kB a podstránky ≤ 70 kB. Otvorenie: showModal() (fokus, Esc, inert zvyšku stránky natívne), zatvorenie: X,
 *  klik na pozadie, Esc, odkaz v menu, astro:before-swap. Pohyb: @starting-style + transition (kde prehliadač vie),
 *  reduced motion = 120 ms fade z global.css. */
import { NAV } from '@/data/nav';
import { ListIcon, XIcon } from '@phosphor-icons/react';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const linkClass =
  'press block rounded-lg border-3 border-ink bg-white px-4 py-3 font-display text-2xl font-extrabold uppercase shadow-brutal-sm aria-[current=page]:bg-yellow';
---

<header class="sticky top-0 z-50 border-b-3 border-ink bg-paper">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-10">
    <a href="/" class="flex h-11 items-center" aria-label="XVADUR — domov">
      <img
        src="/brand/xvadur-ink.svg"
        alt="XVADUR"
        width="728"
        height="130"
        class="h-6 w-auto sm:h-7"
        transition:name="wordmark"
        decoding="async"
      />
    </a>

    <nav aria-label="Hlavná navigácia" class="hidden items-center gap-1 lg:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="flex h-11 items-center rounded-lg border-3 border-transparent px-3 font-display text-base font-extrabold uppercase tracking-wide transition-colors duration-[var(--duration-base)] hover:border-ink hover:bg-yellow aria-[current=page]:border-ink aria-[current=page]:bg-yellow aria-[current=page]:shadow-brutal-sm"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-commandk
        class="press hidden h-11 items-center gap-2 rounded-lg border-3 border-ink bg-white px-3 font-mono text-sm shadow-brutal-sm lg:flex"
        aria-label="Otvoriť príkazovú paletu (⌘K)"
        title="⌘K / Ctrl K"
      >
        <span aria-hidden="true">⌘K</span>
      </button>
      <button
        type="button"
        data-nav-open
        aria-haspopup="dialog"
        aria-controls="mobilna-nav"
        class="press flex h-11 min-w-11 items-center justify-center gap-2 rounded-lg border-3 border-ink bg-yellow px-3 font-display text-sm font-extrabold uppercase tracking-wide shadow-brutal-sm lg:hidden"
      >
        <ListIcon weight="bold" size={22} aria-hidden="true" />
        <span>Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog
  id="mobilna-nav"
  data-nav
  data-lenis-prevent
  aria-label="Navigácia"
  class="mobilna-nav m-0 h-dvh max-h-none w-[min(88vw,360px)] max-w-none flex-col border-l-3 border-ink bg-paper p-0 text-ink lg:hidden"
>
  <div class="flex items-center justify-between border-b-3 border-ink px-4 py-3">
    <p class="eyebrow">Navigácia</p>
    <button
      type="button"
      data-nav-close
      class="press flex h-11 w-11 items-center justify-center rounded-lg border-3 border-ink bg-white shadow-brutal-sm"
      aria-label="Zavrieť menu"
    >
      <XIcon weight="bold" size={22} aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Mobilná navigácia" class="flex flex-col gap-3 p-4">
    <a href="/" aria-current={path === '/' ? 'page' : undefined} class={linkClass}>Domov</a>
    {
      NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class={linkClass}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="mt-auto border-t-3 border-ink p-4">
    <a
      href="/konzultacia/"
      class="press flex min-h-12 items-center justify-center rounded-lg border-3 border-ink bg-hot px-4 py-3 font-display text-lg font-extrabold uppercase text-ink shadow-brutal"
    >
      Konzultácia
    </a>
  </div>
</dialog>

<style>
  /* natívny dialóg: zprava, cez celú výšku; pozadie = overlay token */
  .mobilna-nav {
    position: fixed;
    inset: 0 0 0 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    opacity: 0;
    transition:
      transform var(--duration-slow) var(--ease-out-hard),
      opacity var(--duration-base) var(--ease-out-hard),
      display var(--duration-slow) allow-discrete,
      overlay var(--duration-slow) allow-discrete;
  }
  .mobilna-nav[open] {
    display: flex;
    transform: translateX(0);
    opacity: 1;
  }
  @starting-style {
    .mobilna-nav[open] {
      transform: translateX(100%);
      opacity: 0;
    }
  }
  .mobilna-nav::backdrop {
    background: var(--color-overlay);
    transition:
      background var(--duration-base) var(--ease-out-hard),
      display var(--duration-slow) allow-discrete,
      overlay var(--duration-slow) allow-discrete;
  }
  @starting-style {
    .mobilna-nav[open]::backdrop {
      background: transparent;
    }
  }
  /* stránka pod otvoreným menu nescrolluje */
  html:has(.mobilna-nav[open]) {
    overflow: hidden;
  }
</style>

<script>
  // Delegácia na document: skript beží raz (ClientRouter ho pri navigácii znovu nespúšťa), dialóg sa hľadá pri každom kliku.
  const dlg = () => document.querySelector<HTMLDialogElement>('dialog[data-nav]');
  document.addEventListener('click', (e) => {
    const t = (e.target as Element | null)?.closest?.('[data-nav-open],[data-nav-close],dialog[data-nav] a');
    const d = dlg();
    if (!d) return;
    if (t?.hasAttribute('data-nav-open')) {
      if (!d.open) d.showModal();
      return;
    }
    if (t?.hasAttribute('data-nav-close') || (t && t.tagName === 'A')) {
      d.close();
      return;
    }
    // klik na pozadie (::backdrop) = cieľ je samotný <dialog>, mimo jeho obsahu
    if (e.target === d) {
      const r = d.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) d.close();
    }
  });
  document.addEventListener('astro:before-swap', () => dlg()?.close());
  // desktop: keby ostal otvorený pri zväčšení okna
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => {
    if (m.matches) dlg()?.close();
  });
</script>
