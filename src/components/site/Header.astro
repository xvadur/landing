---
/** Hlavička (všetky stránky vrátane domova, v6): wordmark (transition:name="wordmark"), nav zo src/data/nav.ts,
 *  CTA KONZULTÁCIA (hot, NAV_CTA), ⌘K len keď je na stránke CommandK ostrov (prop commandK ← Base islands="full"),
 *  mobilná navigácia (NavMobil.astro, natívny <dialog>). Hrubá spodná linka 3 px. Sticky (výška = --header-h). */
import NavMobil from './NavMobil.astro';
import { NAV, NAV_CTA, navPath } from '@/data/nav';
import { ListIcon } from '@phosphor-icons/react';

interface Props {
  /** vykresliť ⌘K tlačidlo (len keď Base osadí CommandK ostrov) */
  commandK?: boolean;
}
const { commandK = false } = Astro.props;

const path = Astro.url.pathname;
/* kotvy na domove („/#ponuka“) nie sú nikdy „aktuálna stránka“ */
const isCurrent = (href: string) => {
  const base = navPath(href);
  return base !== '/' && path.startsWith(base);
};
---

<header class="sticky top-0 z-50 border-b-3 border-ink bg-paper">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-10">
    <a href="/" class="flex h-11 items-center" aria-label="XVADUR — domov">
      <img
        src="/brand/xvadur-ink.svg"
        alt="XVADUR"
        width="678"
        height="130"
        class="h-6 w-auto sm:h-7"
        transition:name="wordmark"
        decoding="async"
      />
    </a>

    <nav aria-label="Hlavná navigácia" class="hidden items-center gap-0.5 lg:flex xl:gap-1">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="flex h-11 items-center rounded-lg border-3 border-transparent px-2.5 font-display text-sm font-extrabold uppercase tracking-wide transition-colors duration-[var(--duration-base)] hover:border-ink hover:bg-yellow aria-[current=page]:border-ink aria-[current=page]:bg-yellow aria-[current=page]:shadow-brutal-sm xl:px-3 xl:text-base"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {
        commandK && (
          <button
            type="button"
            data-commandk
            class="press hidden h-11 items-center gap-2 rounded-lg border-3 border-ink bg-white px-3 font-mono text-sm shadow-brutal-sm xl:flex"
            aria-label="Otvoriť príkazovú paletu (⌘K)"
            title="⌘K / Ctrl K"
          >
            <span aria-hidden="true">⌘K</span>
          </button>
        )
      }
      <a
        href={NAV_CTA.href}
        aria-current={isCurrent(NAV_CTA.href) ? 'page' : undefined}
        class="press hidden h-11 items-center rounded-lg border-3 border-ink bg-hot px-4 font-display text-sm font-extrabold uppercase tracking-wide text-ink shadow-brutal-sm hover:bg-hot-hover lg:flex xl:text-base"
      >
        {NAV_CTA.label}
      </a>
      <button
        type="button"
        data-nav-open
        aria-haspopup="dialog"
        aria-controls="mobilna-nav"
        class="press flex h-11 min-w-11 items-center justify-center gap-2 rounded-lg border-3 border-ink bg-yellow px-3 font-display text-sm font-extrabold uppercase tracking-wide shadow-brutal-sm lg:hidden"
      >
        <ListIcon weight="bold" size={22} aria-hidden="true" />
        <span>Menu</span>
      </button>
    </div>
  </div>
</header>

<NavMobil />
