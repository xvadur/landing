---
/** V8 Príjem (1. 10. 2026): kompozícia podľa aiktivista.sk, na ktorú Adam ukázal 20. 9. („Jevčík tam stojí, ja by som tam
 *  mohol stáť viac casual“). Postava je veľká, stojí na spodnej hrane hero a meno ju prekrýva cez rameno. Fotka: Higgsfield
 *  Soul Cinema, Soul ID Sunset Vibes Explorer, výrez work/qa/vyrez.mjs. Na mobile postava stojí na čiare a meno je pod ňou. */
import { ekgPath } from '@/components/v5/Symboly';
const PISMENA = 'XVADUR'.split('');
---

<section id="uvod" class="hero relative overflow-hidden border-b-3 border-ink bg-paper" aria-label="Príjem">
  <div class="relative mx-auto flex min-h-[calc(100dvh-var(--header-h,71px))] w-full max-w-[1600px] flex-col px-4 pt-8 sm:px-6 lg:px-10 lg:pt-10">
    <p class="relative z-20 font-mono text-[0.7rem] font-bold uppercase tracking-[0.3em] text-ink/70 sm:text-xs">
      Zdravotná sestra <span class="text-hot">·</span> AI agenti <span class="text-hot">·</span> Systémy, ktoré držia prácu za ľudí
    </p>

    <div class="scena relative mt-6 flex flex-1 flex-col lg:mt-0 lg:block">
      <div class="postava-box relative flex justify-center border-b-3 border-ink lg:static lg:border-0">
        <img
          src="/v8/adam-hero.webp"
          alt="Adam Rudavský v uniforme s fonendoskopom"
          width="1100"
          height="1467"
          class="postava pointer-events-none block h-[44vh] w-auto max-w-none select-none lg:absolute lg:bottom-0 lg:left-[33%] lg:h-[94%]"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="meno relative z-10 flex flex-col items-start pt-6 pb-10 lg:absolute lg:top-1/2 lg:right-0 lg:w-[52%] lg:pt-0 lg:pb-0">
        <span class="stitok inline-block bg-ink px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-[0.22em] text-paper sm:text-sm">Adam Rudavský</span>
        <h1 class="wordmark mt-2 font-display leading-[0.8] font-extrabold tracking-[-0.045em] whitespace-nowrap uppercase text-ink" aria-label="XVADUR">
          {PISMENA.map((p, i) => <span class="inline-block" style={`--i:${i}`} aria-hidden="true">{p}</span>)}
        </h1>
        <svg viewBox="0 0 1200 40" preserveAspectRatio="none" class="ekg mt-2 h-7 w-full sm:h-9" aria-hidden="true">
          <path d={ekgPath(1200, 640)} fill="none" stroke="var(--color-ink)" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke" pathLength="1" />
        </svg>
        <p class="mt-5 max-w-md font-display text-2xl lg:max-w-none lg:whitespace-nowrap leading-[1.05] font-extrabold tracking-tight text-ink sm:text-3xl">
          Vysvetľujem AI. Staviam systémy. Ukazujem, ako.
        </p>
        <div class="mt-6 flex w-full flex-col items-stretch gap-4 sm:w-auto sm:flex-row sm:items-center">
          <a
            href="#konzultacia"
            data-track="konzultacia_klik"
            data-track-miesto="hero"
            class="press inline-flex min-h-14 items-center justify-center gap-3 rounded-lg border-3 border-ink bg-hot px-7 font-display text-lg font-extrabold uppercase text-ink shadow-brutal"
          >
            Objednaj sa na vyšetrenie <span aria-hidden="true">→</span>
          </a>
          <a href="#kto-som" class="font-mono text-xs font-bold uppercase tracking-[0.24em] text-ink/60 underline-offset-4 hover:text-ink hover:underline">Kto som ↓</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* XVADUR v Bricolage 800 má pomer šírka/veľkosť písma asi 3,55; na mobile cez celú šírku, na desktope cez 52 % obsahu */
  .wordmark {
    font-size: calc((100vw - 2rem) / 3.62);
  }
  @media (min-width: 640px) {
    .wordmark {
      font-size: calc((100vw - 3rem) / 3.62);
    }
  }
  @media (min-width: 1024px) {
    .wordmark {
      font-size: calc((min(100vw, 1600px) - 5rem) * 0.52 / 3.62);
    }
    .meno {
      transform: translateY(-42%);
    }
    .postava {
      transform: translateX(-50%);
    }
  }
  /* ramená sú orezané okrajom záberu: boky idú dostratena */
  .postava {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 13%, #000 87%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 13%, #000 87%, transparent 100%);
    animation: postava 1s var(--ease-out-hard) 0.1s both;
  }
  @keyframes postava {
    from {
      opacity: 0;
      translate: 0 3%;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  .wordmark span {
    animation: pismeno 0.9s var(--ease-out-hard) both;
    animation-delay: calc(0.35s + var(--i) * 70ms);
  }
  @keyframes pismeno {
    from {
      transform: translateY(0.35em);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .ekg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ekg-kresli 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.8s forwards;
  }
  @keyframes ekg-kresli {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wordmark span,
    .postava,
    .ekg path {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
      transform: none;
      translate: none;
    }
    @media (min-width: 1024px) {
      .postava {
        transform: translateX(-50%);
      }
    }
  }
</style>
