---
/** V8 Anamnéza / Kto som: vľavo obraz v ráme, vpravo päť zastávok cesty (src/data/cesta.ts). Veľký rok, názov, veta. */
import { CESTA } from '@/data/cesta';
---

<section id="kto-som" class="border-b-3 border-ink bg-paper" aria-labelledby="kto-som-nadpis">
  <div class="mx-auto grid w-full max-w-[1600px] gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.1fr] lg:gap-20 lg:px-10 lg:py-36">
    <div class="flex flex-col gap-8">
      <p class="eyebrow text-hot">Anamnéza</p>
      <h2 id="kto-som-nadpis" class="font-display text-display-sm font-extrabold uppercase leading-[0.9] tracking-tighter">
        Z nočných služieb<br />k agentom.
      </h2>
      <figure class="reveal overflow-hidden rounded-lg border-3 border-ink bg-white shadow-brutal-lg">
        <img src="/assets/hero-adam.webp" alt="Adam Rudavský" width="1520" height="1040" class="block h-auto w-full" loading="lazy" decoding="async" />
      </figure>
    </div>
    <ol class="flex flex-col divide-y-3 divide-ink border-y-3 border-ink lg:mt-[7.5rem]">
      {CESTA.map((k, i) => (
        <li class="reveal grid gap-2 py-7 sm:grid-cols-[9rem_1fr] sm:gap-8 lg:py-9">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-ink/55 sm:pt-2">{String(i + 1).padStart(2, '0')} · {k.kedy}</p>
          <div class="flex flex-col gap-2">
            <h3 class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{k.nazov}</h3>
            <p class="max-w-lg text-base leading-snug text-ink/75 sm:text-lg">{k.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
