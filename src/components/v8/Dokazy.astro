---
/** V8 Chorobopisy: štyri postavené veci ako riadky s veľkým číslom. Živý dôkaz namiesto hviezdičiek (src/data/fakty.ts). */
import { POSTAVIL } from '@/data/fakty';
const riadky = POSTAVIL.slice(0, 4);
---

<section id="dokazy" class="border-b-3 border-ink bg-white" aria-labelledby="dokazy-nadpis">
  <div class="mx-auto w-full max-w-[1600px] px-4 py-20 sm:px-6 sm:py-28 lg:px-10 lg:py-36">
    <div class="mb-10 flex flex-col gap-5 lg:mb-14">
      <p class="eyebrow text-hot">Chorobopisy</p>
      <h2 id="dokazy-nadpis" class="font-display text-display-sm font-extrabold uppercase leading-[0.9] tracking-tighter">Čo som postavil.</h2>
    </div>
    <ol class="divide-y-3 divide-ink border-y-3 border-ink">
      {riadky.map((p, i) => (
        <li class="reveal grid gap-3 py-8 sm:grid-cols-[4rem_minmax(0,1.1fr)_1.4fr] sm:items-baseline sm:gap-8 lg:py-10">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-ink/55">{String(i + 1).padStart(2, '0')}</span>
          <div class="flex flex-col gap-1">
            <span class="font-display text-[clamp(2.4rem,1.4rem+3.4vw,5rem)] leading-[0.9] font-extrabold tracking-tighter tabular-nums">{p.cislo}</span>
            <h3 class="font-display text-2xl font-extrabold tracking-tight sm:text-3xl">{p.nazov}</h3>
          </div>
          <div class="flex flex-col gap-3">
            <p class="max-w-xl text-base leading-snug text-ink/75 sm:text-lg">{p.riadok}</p>
            {p.url ? (
              <a href={p.url} rel="noopener" target="_blank" class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-hot underline-offset-4 hover:underline">Otvoriť →</a>
            ) : (
              <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-ink/45">{p.domena ?? 'Ukážem na vyšetrení'}</span>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
