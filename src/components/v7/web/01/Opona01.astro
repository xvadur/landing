---
/** V7-01 · Opona „monitor sa zapne“. Variant povinnej opony (src/components/home/Opona.astro): celá obrazovka je
 *  tmavý monitor JIS s riadkami CRT, v strede obrí wordmark XVADUR ako meno pacienta, pod ním sa po schodoch (steps(8))
 *  nakreslí EKG, pri poslednom kmite monitor zabliká alarmom a obraz sa roztrhne po línii EKG hore a dole (steps(5))
 *  → odhalí príjem. Pravidlá ako pôvodná opona: raz za návštevu (sessionStorage.opona), reduced motion = bez opony,
 *  scroll / klik / klávesa = preskočiť. Čisté CSS + malý inline skript, 0 kB React. */
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';

const EKG =
  'M0 60 L260 60 L282 52 L300 60 L330 60 L342 72 L360 8 L378 108 L392 60 L430 60 L452 46 L474 60 L560 60 L582 52 L600 60 L630 60 L642 72 L660 8 L678 108 L692 60 L730 60 L752 46 L774 60 L1000 60';
---

<div id="opona" class="m01-opona" aria-hidden="true" data-opona>
  {
    ['hore', 'dole'].map((p) => (
      <div class:list={['m01-op-pol', `m01-op-${p}`]}>
        <div class="m01-op-vrstva">
          <div class="m01-op-riadky" />
          <div class="m01-op-obsah">
            <p class="m01-op-stitok">
              <span class="m01-op-bodka" />✚ Monitor JIS · pacient
            </p>
            <img class="m01-op-wm" src="/brand/xvadur-paper.svg" alt="" width="678" height="130" decoding="async" />
            <svg class="m01-op-ekg" viewBox="0 0 1000 120" preserveAspectRatio="none">
              <path d={EKG} pathLength="100" />
            </svg>
            <p lang="en" class="m01-op-motto">
              {MOTTO_1} {MOTTO_2}
            </p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script is:inline>
  (() => {
    const el = document.getElementById('opona');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('opona') === '1';
    } catch {
      /* súkromné okno: opona sa ukáže */
    }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const html = document.documentElement;
    if (seen || reduced) {
      el.remove();
      html.dataset.m01Opona = 'hotovo';
      return;
    }
    try {
      sessionStorage.setItem('opona', '1');
    } catch {
      /* ignoruj */
    }
    html.classList.add('opona-lock');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      html.classList.remove('opona-lock');
      html.dataset.m01Opona = 'hotovo';
      el.remove();
      window.dispatchEvent(new CustomEvent('opona:done'));
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.removeEventListener(t, skip));
    };
    const skip = () => {
      el.classList.add('m01-op-skip');
      setTimeout(finish, 280);
    };
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.addEventListener(t, skip, { passive: true }));
    el.classList.add('m01-op-go');
    setTimeout(finish, 2350);
  })();
</script>

<style>
  .m01-opona {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html.opona-lock) {
    overflow: hidden;
  }
  .m01-op-pol {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    background: var(--color-ink);
    will-change: transform;
  }
  .m01-op-hore {
    top: 0;
    border-bottom: 3px solid var(--color-yellow);
  }
  .m01-op-dole {
    bottom: 0;
    border-top: 3px solid var(--color-yellow);
  }
  /* vrstva = celá obrazovka; v dolnej polovici posunutá o −50vh, aby nadväzovala */
  .m01-op-vrstva {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100dvh;
  }
  .m01-op-dole .m01-op-vrstva {
    top: -50dvh;
  }
  .m01-op-riadky {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper) 7%, transparent) 0 1px,
      transparent 1px 4px
    );
  }
  .m01-op-obsah {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding: 0 1rem;
    color: var(--color-paper);
  }
  .m01-op-stitok {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 0.6rem + 0.4vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-yellow);
  }
  .m01-op-bodka {
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-yellow);
    animation: m01-op-bodka 1s steps(2, end) infinite;
  }
  @keyframes m01-op-bodka {
    50% {
      background: var(--color-stamp);
    }
  }
  .m01-op-wm {
    width: min(88vw, 1100px);
    height: auto;
    max-width: none;
  }
  .m01-op-ekg {
    width: min(92vw, 1180px);
    height: clamp(56px, 9vw, 120px);
    overflow: visible;
  }
  .m01-op-ekg path {
    fill: none;
    stroke: var(--color-yellow);
    stroke-width: 4;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: m01-op-ekg 1000ms steps(8, end) 250ms forwards;
  }
  @keyframes m01-op-ekg {
    to {
      stroke-dashoffset: 0;
    }
  }
  .m01-op-motto {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 0.7rem + 2vw, 2.4rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: center;
  }
  /* alarm pri poslednom kmite: monitor zabliká (stamp / ink po schodoch) */
  .m01-op-go .m01-op-hore {
    animation:
      m01-op-alarm 240ms steps(1, end) 1260ms 2,
      m01-op-hore 640ms steps(5, end) 1700ms forwards;
  }
  .m01-op-go .m01-op-dole {
    animation:
      m01-op-alarm 240ms steps(1, end) 1260ms 2,
      m01-op-dole 640ms steps(5, end) 1700ms forwards;
  }
  @keyframes m01-op-alarm {
    0% {
      background: var(--color-stamp);
    }
    50% {
      background: var(--color-ink);
    }
  }
  @keyframes m01-op-hore {
    to {
      transform: translateY(-102%);
    }
  }
  @keyframes m01-op-dole {
    to {
      transform: translateY(102%);
    }
  }
  .m01-op-skip .m01-op-hore {
    animation: m01-op-hore 260ms steps(3, end) forwards !important;
  }
  .m01-op-skip .m01-op-dole {
    animation: m01-op-dole 260ms steps(3, end) forwards !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .m01-opona {
      display: none;
    }
  }
</style>
