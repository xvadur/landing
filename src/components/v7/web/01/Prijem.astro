---
/** V7-01 · obrazovka 01 Príjem (hero). Vľavo hlavný monitor: meno pacienta = obrí wordmark XVADUR, CRT stopa EKG
 *  (≥ 1024 px canvas, inak statické SVG) a motto, ktoré sa každé 4 s dešifruje. Vpravo fotka Adama ako nálepka 4:5
 *  (zástupná plocha „FOTKA ADAMA“). Pod tým kto je Adam jednou vetou, CTA na vyšetrenie a svietiaci widget Korpusu
 *  so 4 živými číslami. Texty: v54/Prijem.astro a hero/hero-data.ts. */
import { Sticker, Stamp } from '@/components/ui/sticker';
import { CrossShape, LightningShape } from '@/components/ui/shapes';
import { ZdravotnikPlaceholder, ekgPath } from '@/components/v5/Symboly';
import { CTA_KTO, MOTTO_1, MOTTO_2, NALEPKA_NEMOCNICA, VETA } from '@/components/hero/hero-data';
import Obrazovka from './Obrazovka.astro';
import KorpusWidget from './KorpusWidget';
import Motto from './Motto';
import CrtMonitor from './CrtMonitor';
import { ROLY } from './data';
---

<Obrazovka id="prijem" kanal="EKG II · príjem" stav="príjem otvorený" nadpisId="prijem-h" class="m01-prijem">
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:gap-6">
    <!-- kto som jednou vetou (mobil hore, desktop pod monitorom) -->
    <div class="m01-prijem-kto flex flex-col gap-4 lg:col-span-7 lg:col-start-1 lg:row-start-2">
      <h1 id="prijem-h" class="font-display text-[clamp(2.4rem,1.3rem+4vw,4.6rem)] leading-[0.95] font-extrabold tracking-tight">
        Ahoj, som <span class="font-serif font-normal tracking-normal italic">Adam</span><span class="text-hot">.</span>
      </h1>
      <p class="m01-rola relative h-[1.6em] overflow-hidden font-mono text-sm font-bold tracking-[0.12em] uppercase sm:text-base" aria-label={ROLY.join(', ')}>
        {
          ROLY.map((r, i) => (
            <span class="m01-rola-r absolute inset-x-0 block truncate" style={`--i:${i}`} aria-hidden="true">
              ✚ {r}
            </span>
          ))
        }
      </p>
      <p class="max-w-2xl text-xl leading-snug sm:text-2xl">{VETA}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="#vysetrenie"
          data-m01-cta
          data-track="konzultacia_klik"
          data-track-miesto="v7-01-prijem"
          class="m01-cta-velke inline-flex min-h-14 items-center justify-center gap-2 border-3 border-ink bg-hot px-6 font-display text-lg font-extrabold uppercase text-ink shadow-[5px_5px_0_0_var(--color-ink)] sm:text-xl"
        >
          Objednaj sa na vyšetrenie <span aria-hidden="true">→</span>
        </a>
        <a
          href="#anamneza"
          class="inline-flex min-h-14 items-center justify-center border-3 border-ink bg-white px-6 font-display text-lg font-extrabold uppercase shadow-[5px_5px_0_0_var(--color-ink)]"
        >
          {CTA_KTO.label} ↓
        </a>
      </div>
    </div>

    <!-- hlavný monitor: pacient XVADUR -->
    <div class="m01-monitor relative flex min-w-0 flex-col border-3 border-ink bg-ink text-paper shadow-[8px_8px_0_0_var(--color-yellow)] lg:col-span-8 lg:col-start-1 lg:row-start-1">
      <div class="flex items-center justify-between gap-3 border-b-3 border-paper/25 px-4 py-2 font-mono text-[11px] font-bold tracking-[0.16em] uppercase sm:text-xs">
        <span class="flex items-center gap-2"><span class="m01-bod m01-bod-zlta"></span>Pacient</span>
        <span class="text-paper/60">Adam Rudavský · 8 rokov pri lôžku</span>
      </div>
      <div class="px-4 pt-5 sm:px-6 sm:pt-7">
        <img src="/brand/xvadur-paper.svg" alt="XVADUR" width="678" height="130" class="m01-svieti-img block h-auto w-full" />
      </div>
      <div class="relative mx-4 mt-4 h-28 overflow-hidden border-3 border-paper/25 sm:mx-6 sm:h-36 lg:h-40">
        <svg viewBox="0 0 600 40" preserveAspectRatio="none" class="m01-ekg-static absolute inset-0 h-full w-full" aria-hidden="true">
          <path d={ekgPath(1200)} fill="none" stroke="var(--color-yellow)" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="absolute inset-0 hidden lg:block">
          <CrtMonitor client:media="(min-width: 1024px)" />
        </div>
        <div class="m01-riadky pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <span class="absolute top-2 right-2 border-2 border-paper/60 bg-ink px-2 py-0.5 font-mono text-[10px] font-bold tracking-[0.12em] text-paper uppercase">
          Higgsfield: 01-hero-monitor · loop 4 s
        </span>
      </div>
      <div class="px-4 pt-4 pb-5 sm:px-6 sm:pb-6">
        <Motto
          client:visible
          className="font-display text-[clamp(1.7rem,0.9rem+3.2vw,3.6rem)] leading-[0.95] font-extrabold tracking-tight uppercase"
        />
        <noscript><p lang="en" class="font-display text-3xl font-extrabold uppercase">{MOTTO_1} {MOTTO_2}</p></noscript>
      </div>
    </div>

    <!-- fotka Adama ako nálepka 4:5 -->
    <div class="m01-foto relative mx-auto w-[min(78vw,320px)] lg:col-span-4 lg:col-start-9 lg:row-start-1 lg:mx-0 lg:self-center lg:w-full lg:max-w-[400px] lg:justify-self-end">
      <figure class="relative m-0 -rotate-2 overflow-hidden border-3 border-ink bg-yellow shadow-[8px_8px_0_0_var(--color-ink)]" style="aspect-ratio: 4 / 5">
        <div class="tx-halftone absolute inset-0 opacity-60" aria-hidden="true"></div>
        <ZdravotnikPlaceholder className="absolute inset-x-0 bottom-0 block h-[88%] w-full" />
        <figcaption class="absolute top-3 left-3 flex flex-col items-start gap-1">
          <Sticker variant="outline" size="lg" rotation="slight" shadow="default">Fotka Adama</Sticker>
          <span class="border-2 border-ink bg-white px-2 py-0.5 font-mono text-[10px] font-bold tracking-[0.12em] uppercase">Higgsfield: 01-portret · 4:5</span>
        </figcaption>
      </figure>
      <Stamp variant="secondary" size="default" rotation="slight" doubleRing className="absolute -bottom-6 -left-4 px-2 text-center leading-tight">
        {NALEPKA_NEMOCNICA}
      </Stamp>
      <CrossShape size={52} filled color="var(--color-stamp)" strokeColor="var(--color-ink)" className="absolute -top-5 -right-3 rotate-12" aria-hidden="true" />
      <LightningShape size={44} filled color="var(--color-yellow)" strokeColor="var(--color-ink)" animation="pulse-hard" className="absolute top-1/2 -right-5 hidden -rotate-12 lg:block" aria-hidden="true" />
    </div>

    <!-- Korpus naživo -->
    <div class="m01-prijem-korpus lg:col-span-5 lg:col-start-8 lg:row-start-2 lg:self-start">
      <KorpusWidget client:visible />
    </div>
  </div>
</Obrazovka>
