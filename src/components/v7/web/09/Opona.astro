---
/** V7-09 · Opona ako obálka zinu (variant home/Opona.astro): žltá obálka s wordmarkom XVADUR vytlačeným risografom
 *  (červený raster posunutý pod čiernou), motto, pásky v rohoch. Po 1,1 s sa obálka strhne ako plagát zo steny
 *  (otočí sa okolo ľavého horného rohu a odletí dole), pod ňou druhý list odletí doprava a odhalí hero.
 *  Pravidlá ako pri domove: raz za návštevu (sessionStorage.opona), reduced motion = bez opony, scroll / klik / klávesa
 *  = preskočiť (250 ms). Animácia je čisto CSS, JS rieši session, zámok scrollu a preskočenie. aria-hidden. */
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';
---

<div id="opona" class="z9o" aria-hidden="true">
  <div class="z9o-list z9o-spodny">
    <p class="z9o-spodny-t">Príjem</p>
  </div>
  <div class="z9o-list z9o-obalka">
    <span class="z9o-paska z9o-paska-l"></span>
    <span class="z9o-paska z9o-paska-r"></span>
    <p class="z9o-hlava"><span>Zin</span><span>✚</span><span>XVADUR</span><span>✚</span><span>Príjem</span></p>
    <div class="z9o-wm">
      <span class="z9o-wm-riso"></span>
      <img src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
    </div>
    <p lang="en" class="z9o-motto"><span>{MOTTO_1}</span> <span>{MOTTO_2}</span></p>
    <span class="z9o-x"><img src="/brand/x.svg" alt="" width="48" height="48" /></span>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById('opona');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('opona') === '1';
    } catch {
      /* súkromné okno: opona sa ukáže */
    }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduced) {
      el.remove();
      return;
    }
    try {
      sessionStorage.setItem('opona', '1');
    } catch {
      /* ignoruj */
    }
    const html = document.documentElement;
    html.classList.add('opona-lock');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      html.classList.remove('opona-lock');
      el.remove();
      window.dispatchEvent(new CustomEvent('opona:done'));
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.removeEventListener(t, skip));
    };
    const skip = () => {
      el.classList.add('z9o-skip');
      setTimeout(finish, 280);
    };
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.addEventListener(t, skip, { passive: true }));
    el.classList.add('z9o-go');
    setTimeout(finish, 1100 + 1050 + 80);
  })();
</script>

<style>
  .z9o {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html.opona-lock) {
    overflow: hidden;
  }
  .z9o-list {
    position: absolute;
    inset: 0;
    border: 3px solid var(--color-ink);
    will-change: transform;
  }
  .z9o-spodny {
    background-color: var(--color-paper);
    background-image: radial-gradient(color-mix(in oklab, var(--color-stamp) 70%, transparent) 30%, transparent 34%);
    background-size: 14px 14px;
    display: grid;
    place-items: center;
    transform-origin: 100% 0%;
  }
  .z9o-spodny-t {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(4rem, 2rem + 14vw, 16rem);
    letter-spacing: -0.05em;
    line-height: 0.8;
    color: var(--color-paper);
    -webkit-text-stroke: 4px var(--color-ink);
    paint-order: stroke fill;
  }
  .z9o-obalka {
    background-color: var(--color-yellow);
    background-image: radial-gradient(color-mix(in oklab, var(--color-ink) 22%, transparent) 1.2px, transparent 1.7px);
    background-size: 22px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vh, 2.5rem);
    padding: 1rem;
    transform-origin: 0% 0%;
  }
  .z9o-hlava {
    position: absolute;
    top: 1.25rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    border-bottom: 3px solid var(--color-ink);
    padding-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .z9o-wm {
    position: relative;
    width: min(86vw, 1100px);
    aspect-ratio: 678 / 130;
  }
  .z9o-wm img {
    position: relative;
    width: 100%;
    height: auto;
  }
  /* risograf: červený raster wordmarku posunutý o pár pixelov */
  .z9o-wm-riso {
    position: absolute;
    inset: 0;
    translate: 1.2% 9%;
    background-color: var(--color-stamp);
    -webkit-mask: url('/brand/xvadur-ink.svg') center / contain no-repeat;
    mask: url('/brand/xvadur-ink.svg') center / contain no-repeat;
  }
  .z9o-motto {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.35em;
    margin: 0;
    max-width: 92vw;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 0.9rem + 3.4vw, 4.2rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-align: center;
  }
  .z9o-motto span:last-child {
    background: var(--color-ink);
    color: var(--color-yellow);
    padding: 0 0.15em;
  }
  .z9o-x {
    position: absolute;
    right: 8%;
    bottom: 10%;
    width: clamp(3rem, 6vw, 5.5rem);
    rotate: 12deg;
  }
  .z9o-x img {
    width: 100%;
    height: auto;
  }
  .z9o-paska {
    position: absolute;
    top: -0.4rem;
    width: 9rem;
    height: 2rem;
    background: color-mix(in oklab, var(--color-white) 72%, transparent);
    box-shadow:
      inset 0 2px 0 color-mix(in oklab, var(--color-ink) 16%, transparent),
      inset 0 -2px 0 color-mix(in oklab, var(--color-ink) 16%, transparent);
    clip-path: polygon(0 8%, 5% 0, 12% 7%, 20% 0, 80% 5%, 88% 0, 95% 6%, 100% 0, 97% 50%, 100% 100%, 93% 93%, 85% 100%, 15% 94%, 7% 100%, 0 92%, 3% 50%);
  }
  .z9o-paska-l {
    left: -1.5rem;
    top: 1.2rem;
    rotate: -38deg;
  }
  .z9o-paska-r {
    right: -1.5rem;
    top: 1.2rem;
    rotate: 38deg;
  }

  /* strhnutie: obálka sa otočí okolo ľavého horného rohu a odpadne, spodný list odletí doprava */
  .z9o-go .z9o-obalka {
    animation: z9o-strhni 950ms cubic-bezier(0.55, 0, 0.75, 0.2) 1100ms forwards;
  }
  .z9o-go .z9o-spodny {
    animation: z9o-odlet 700ms cubic-bezier(0.7, 0, 0.84, 0) 1450ms forwards;
  }
  .z9o-skip .z9o-obalka,
  .z9o-skip .z9o-spodny {
    animation-duration: 260ms;
    animation-delay: 0ms;
  }
  @keyframes z9o-strhni {
    0% {
      transform: none;
    }
    22% {
      transform: rotate(-5deg);
    }
    100% {
      transform: translate(-18vw, 130vh) rotate(-34deg);
    }
  }
  @keyframes z9o-odlet {
    to {
      transform: translate(115vw, -8vh) rotate(18deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .z9o {
      display: none;
    }
  }
</style>
