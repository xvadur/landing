---
/** V7-09 · Tézy ako manifest cez celú šírku: osem Adamových viet (doslovne z v54/Tezy.astro) v plagátovom písme,
 *  striedavo vľavo a vpravo, kľúčové slová podčiarkne žltý zvýrazňovač, ktorý sa natiahne pri scrollovaní (CSS view()).
 *  Nadpis: Fancy VerticalCutReveal. */
import { SealShape } from '@/components/ui/shapes';
import { MENO } from '@/components/hero/hero-data';
import ManifestNadpis from './ManifestNadpis';
import { TEZY } from './data';

const casti = (veta: string, z: string) => {
  const i = veta.indexOf(z);
  return i < 0 ? [veta, '', ''] : [veta.slice(0, i), z, veta.slice(i + z.length)];
};
---

<section id="manifest" class="relative border-t-3 border-ink bg-white" aria-labelledby="z9-man-h">
  <div aria-hidden="true" class="tx-halftone pointer-events-none absolute inset-0 [--tx:10%]"></div>
  <div class="relative mx-auto w-full max-w-[1600px] px-4 pt-24 pb-24 sm:px-6 sm:pt-32 lg:px-10">
    <p class="flex items-center justify-between gap-3 border-b-3 border-ink pb-2 font-mono text-xs font-bold tracking-[0.18em] uppercase sm:text-sm">
      <span>✚ Manifest · zo záznamov</span>
      <span>str. 04</span>
    </p>
    <div class="relative mt-8">
      <h2 id="z9-man-h" class="sr-only">Čo som si zapísal</h2>
      <div aria-hidden="true"><ManifestNadpis client:visible text="Čo som si zapísal" /></div>
      <div class="pointer-events-none absolute -top-6 right-0 hidden w-36 rotate-12 sm:block" aria-hidden="true">
        <SealShape size={144} color="var(--color-yellow)" strokeWidth={3} animation="spin" speed="slow" className="h-auto w-full" />
      </div>
    </div>

    <ol class="mt-12 flex flex-col" role="list">
      {
        TEZY.map((t, i) => {
          const [a, b, c] = casti(t.veta, t.zvyraznit);
          const vpravo = i % 2 === 1;
          return (
            <li class:list={['flex border-t-3 border-ink py-8 sm:py-10', vpravo && 'justify-end']}>
              <figure class:list={['flex max-w-[62rem] flex-col gap-4', vpravo && 'items-end text-right']}>
                <blockquote class="font-display text-[clamp(1.75rem,1rem+3.1vw,4.4rem)] leading-[0.98] font-extrabold tracking-[-0.03em] text-balance">
                  <span class="text-stamp">„</span>
                  {a}
                  {b && <span class="z9-marker">{b}</span>}
                  {c}
                  <span class="text-stamp">“</span>
                </blockquote>
                <figcaption class="flex items-center gap-3 font-mono text-xs font-bold tracking-[0.14em] uppercase sm:text-sm">
                  <span class="border-3 border-ink bg-ink px-2 py-0.5 text-paper">§ {String(i + 1).padStart(2, '0')}</span>
                  <span>{MENO}</span>
                  <span>· {t.kedy}</span>
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
