---
/** V7-09 · Chorobopisy ako koláž výstrižkov na čiernej stene: rozbitá mriežka, každý projekt je stoh listov
 *  (LayeredCard) prelepený páskou, natočený, pri scrollovaní sa dotočí. Detail sa otvorí na mieste v Sheete
 *  (ChorobopisSheet.tsx), grafy sú výstrižky s číslami z fakty.ts (Grafy.tsx). Obrázky projektov ako risograf
 *  (čiernobiely raster cez žltú). Texty: DOKAZY z fakty.ts, nadpis z v54/Chorobopisy.astro. */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { LayeredCard } from '@/components/ui/layered-card';
import { Badge } from '@/components/ui/badge';
import { EyeShape, SplatShape } from '@/components/ui/shapes';
import ChorobopisSheet from './ChorobopisSheet';
import Grafy from './Grafy';
import { CHOROBOPISY, PRE_TEXT, STAV_TEXT } from './data';

const obrazky = [...new Set(CHOROBOPISY.map((c) => c.obrazok).filter((o): o is string => !!o && existsSync(join(process.cwd(), 'public', o))))];
const domena = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const UHOL = [-2, 1.6, -1.2, 2.2, -1.8, 1.4, -2.4, 1];
/** rozbitá mriežka (desktop): šírka a posun každého výstrižku */
const MRIEZKA = [
  'lg:col-span-7',
  'lg:col-span-5 lg:mt-24',
  'lg:col-span-4 lg:-mt-10',
  'lg:col-span-4 lg:mt-12',
  'lg:col-span-4 lg:-mt-4',
  'lg:col-span-5 lg:col-start-2 lg:-mt-6',
  'lg:col-span-6 lg:mt-10',
  'lg:col-span-5 lg:col-start-7 lg:-mt-8',
];
const VRSTVY = ['secondary', 'muted'] as const;
---

<section id="chorobopisy" class="relative border-t-3 border-ink bg-ink text-paper" aria-labelledby="z9-cho-h">
  <div aria-hidden="true" class="tx-dots pointer-events-none absolute inset-0 opacity-40 [--tx:30%]"></div>
  <div class="relative mx-auto w-full max-w-[1500px] px-4 pt-24 pb-28 sm:px-6 sm:pt-32 lg:px-10">
    <p class="flex items-center justify-between gap-3 border-b-3 border-paper pb-2 font-mono text-xs font-bold tracking-[0.18em] uppercase sm:text-sm">
      <span>✚ Chorobopisy</span>
      <span>str. 05</span>
    </p>
    <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
      <h2 id="z9-cho-h" class="font-display text-[clamp(3rem,1.2rem+7vw,8.5rem)] leading-[0.84] font-extrabold tracking-[-0.045em] uppercase">
        Čo som<br /><span class="bg-yellow px-[0.1em] text-ink">postavil</span>
      </h2>
      <p class="max-w-md text-lg text-paper/85 sm:text-xl">Každý systém so stavom, ako naozaj je. Kde je odkaz, dá sa otvoriť.</p>
    </div>

    <ul class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-x-8 lg:gap-y-10" role="list">
      {
        CHOROBOPISY.map((d, i) => (
          <li class:list={['relative min-w-0', MRIEZKA[i] ?? 'lg:col-span-4']}>
            <div class="z9-list relative" style={`--r:${UHOL[i % UHOL.length]}deg; --r0:${i % 2 ? -12 : 12}deg`}>
              <span class="z9-paska" style={`--pr:${i % 2 ? 7 : -6}deg; left:${18 + ((i * 23) % 50)}%; top:-0.9rem`} />
              <LayeredCard layers="double" layerColor={VRSTVY[i % VRSTVY.length]} offset="default" className="mr-4 mb-4 text-ink">
                <div class="flex items-center justify-between gap-3 border-b-3 border-ink bg-paper px-4 py-2 font-mono text-xs font-bold tracking-[0.14em] uppercase">
                  <span>Chorobopis {String(i + 1).padStart(2, '0')}</span>
                  <span class="inline-flex items-center gap-1.5">
                    <span class:list={['h-2.5 w-2.5 border-2 border-ink', d.stav === 'zive' ? 'bg-yellow' : 'bg-paper']} />
                    {STAV_TEXT[d.stav]}
                  </span>
                </div>
                {d.obrazok && obrazky.includes(d.obrazok) && (
                  <div class="border-b-3 border-ink bg-yellow">
                    <img src={d.obrazok} alt="" width="960" height="600" loading="lazy" decoding="async" class="aspect-[16/7] w-full object-cover object-top mix-blend-multiply grayscale contrast-125" />
                  </div>
                )}
                <div class="flex flex-col gap-3 p-5">
                  <div class="flex flex-wrap gap-2">
                    <Badge variant="secondary" className="shadow-none hover:translate-x-0 hover:translate-y-0">
                      {PRE_TEXT[d.pre]}
                    </Badge>
                    {d.stitky.map((s) => (
                      <Badge variant="outline" className="shadow-none hover:translate-x-0 hover:translate-y-0">
                        {s}
                      </Badge>
                    ))}
                  </div>
                  <h3 class="font-display text-4xl leading-[0.88] font-extrabold tracking-tight uppercase">{d.nazov}</h3>
                  <p class="text-lg leading-snug">{d.riadok}</p>
                  <div class="mt-2 flex flex-wrap items-end justify-between gap-4 border-t-3 border-ink pt-4">
                    <div>
                      <p class="font-display text-5xl leading-none font-extrabold whitespace-nowrap tabular-nums">{d.cislo}</p>
                      <p class="mt-1 font-mono text-xs font-bold tracking-[0.1em] uppercase">{d.cisloPopis}</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      <button type="button" data-z9-projekt={d.id} class="press inline-flex min-h-11 items-center border-3 border-ink bg-yellow px-4 font-mono text-xs font-bold tracking-[0.12em] uppercase shadow-brutal-sm">
                        Otvoriť chorobopis
                      </button>
                      {d.url && (
                        <a href={d.url} target="_blank" rel="noopener noreferrer" class="press inline-flex min-h-11 items-center border-3 border-ink bg-ink px-4 font-mono text-xs font-bold text-paper shadow-brutal-sm">
                          {domena(d.url)} ↗
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </LayeredCard>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="relative mt-24">
      <div class="pointer-events-none absolute -top-16 -left-6 hidden w-28 -rotate-12 lg:block" aria-hidden="true">
        <EyeShape size={112} color="var(--color-yellow)" strokeWidth={3} className="h-auto w-full" />
      </div>
      <div class="pointer-events-none absolute -right-8 -bottom-10 hidden w-36 lg:block" aria-hidden="true">
        <SplatShape size={144} color="var(--color-stamp)" strokeWidth={3} strokeColor="var(--color-paper)" className="h-auto w-full" />
      </div>
      <Grafy client:visible />
    </div>

    <div class="mt-20 flex flex-wrap items-center gap-6">
      <p class="font-display text-[clamp(2.4rem,1.2rem+4vw,5rem)] leading-[0.88] font-extrabold tracking-tighter uppercase">Ďalší chorobopis: tvoj.</p>
      <a href="#vysetrenie" class="press inline-flex min-h-14 items-center border-3 border-paper bg-hot px-6 font-display text-lg font-extrabold text-ink uppercase shadow-[6px_6px_0_0_var(--color-paper)]">Vyšetrenie →</a>
    </div>
  </div>
  <ChorobopisSheet client:idle obrazky={obrazky} />
</section>
