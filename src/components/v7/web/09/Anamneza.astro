---
/** V7-09 · Kto som ako nástenka zinu: tri kapitoly (Základ · Služba · Stavba), každá zastávka cesty je list papiera
 *  prilepený páskou, natočený inak, pri scrollovaní sa dotočí na miesto (CSS view()). Citát je lístoček (StickyNote),
 *  nemocnica má pečiatku, XVADUR je stoh listov (LayeredCard). Zastávky bez textu na webe majú štítok „text doplní Adam“.
 *  Texty: data.ts (BIO z cesta.ts + beaty.ts beat 3), ANAMNEZA z v54/Anamneza.astro. Statické HTML, 0 kB JS. */
import { Badge } from '@/components/ui/badge';
import { Sticker, Stamp, StickyNote } from '@/components/ui/sticker';
import { LayeredCard } from '@/components/ui/layered-card';
import { Marquee, MarqueeItem, MarqueeSeparator } from '@/components/ui/marquee';
import { HeartShape, LightningShape, StarShape } from '@/components/ui/shapes';
import { ANAMNEZA, BIO, type Zastavka } from './data';

const KAPITOLY = ['Základ', 'Služba', 'Stavba'] as const;
const VETY: Record<(typeof KAPITOLY)[number], string> = {
  Základ: 'Škola a viera.',
  Služba: 'Nemocnica, psychológia, odchod.',
  Stavba: 'AI, agenti, XVADUR.',
};
const FARBA: Record<string, string> = {
  elektro: 'z9-biely',
  viera: '',
  nemocnica: 'z9-biely',
  psychologia: 'z9-zlty',
  odchod: 'z9-cerveny',
  ai: 'z9-biely',
  agenti: '',
};
const UHOL = [-2.2, 1.6, -1.4, 2.4, -2.8, 1.2, -1.8, 2];
const poradie = (z: Zastavka) => BIO.findIndex((b) => b.id === z.id);
const cislo = (z: Zastavka) => String(poradie(z) + 1).padStart(2, '0');
---

<section id="kto-som" class="relative border-t-3 border-ink bg-paper tx-grain [--tx:0.14]" aria-labelledby="z9-ana-h">
  <div class="mx-auto w-full max-w-[1500px] px-4 pt-24 sm:px-6 sm:pt-32 lg:px-10">
    <p class="flex items-center justify-between gap-3 border-b-3 border-ink pb-2 font-mono text-xs font-bold tracking-[0.18em] uppercase sm:text-sm">
      <span>✚ Anamnéza · Kto som</span>
      <span>str. 03</span>
    </p>
    <div class="mt-8 grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-end">
      <h2 id="z9-ana-h" class="font-display text-[clamp(3rem,1.2rem+7vw,8.5rem)] leading-[0.84] font-extrabold tracking-[-0.045em] uppercase">
        <span class="z9-riso block" data-t="Z nemocnice">Z nemocnice</span>
        <span class="z9-riso block" data-t="k agentom">k agentom</span>
      </h2>
      <div class="z9-list relative" style="--r:1.5deg; --r0:-10deg">
        <span class="z9-paska" style="--pr:-6deg; left: 40%; top: -0.9rem"></span>
        <blockquote class="z9-papier z9-biely p-5 sm:p-7">
          <p class="font-display text-2xl leading-tight font-extrabold sm:text-3xl">„{ANAMNEZA.citat}“</p>
          <p class="mt-3 text-lg">{ANAMNEZA.dovetok}</p>
        </blockquote>
      </div>
    </div>
  </div>

  <!-- páska s cestou -->
  <div class="relative my-14 -rotate-1 sm:my-20">
    <Marquee speed="slow" repeat={3} className="border-x-0 bg-yellow font-display text-xl font-extrabold uppercase sm:text-2xl">
      {
        BIO.map((z) => (
          <>
            <MarqueeItem>{z.nazov}</MarqueeItem>
            <MarqueeSeparator>→</MarqueeSeparator>
          </>
        ))
      }
    </Marquee>
  </div>

  <div class="mx-auto flex w-full max-w-[1500px] flex-col gap-16 px-4 pb-28 sm:px-6 lg:gap-24 lg:px-10">
    {
      KAPITOLY.map((kap, k) => {
        const listy = BIO.filter((z) => z.kapitola === kap);
        return (
          <div class="grid gap-6 lg:grid-cols-[7rem_minmax(0,1fr)] lg:gap-10">
            <div class="flex items-baseline gap-4 lg:flex-col lg:items-start">
              <p class="z9-obrys text-[4.5rem] lg:text-[6rem]" aria-hidden="true">
                {String(k + 1).padStart(2, '0')}
              </p>
              <div>
                <h3 class="font-display text-3xl font-extrabold uppercase">{kap}</h3>
                <p class="font-mono text-sm">{VETY[kap]}</p>
              </div>
            </div>

            <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-0" role="list">
              {listy.map((z, i) => {
                const n = poradie(z);
                const posun = ['lg:mt-0', 'lg:mt-20 lg:-ml-4', 'lg:mt-6 lg:-ml-6'][i] ?? '';
                return (
                  <li class:list={['relative min-w-0', posun]} style={`z-index:${i + 1}`}>
                    <div class="z9-list relative" style={`--r:${UHOL[n]}deg; --r0:${n % 2 ? -12 : 12}deg`}>
                      <span class="z9-paska" style={`--pr:${n % 2 ? 6 : -5}deg; left: ${20 + ((n * 17) % 40)}%; top: -0.85rem`} />
                      {z.id === 'xvadur' ? (
                        <LayeredCard layers="triple" layerColor="secondary" offset="sm" className="mr-5 mb-5">
                          <div class="flex flex-col gap-3 p-5 sm:p-6">
                            <div class="flex items-center justify-between gap-3">
                              <Badge variant="default" className="shadow-none hover:translate-x-0 hover:translate-y-0">
                                {z.kedy}
                              </Badge>
                              <span class="font-mono text-xs font-bold">záznam {cislo(z)} / {BIO.length}</span>
                            </div>
                            <p class="font-display text-5xl leading-[0.86] font-extrabold tracking-tight uppercase">{z.nazov}</p>
                            <p class="text-lg leading-snug">{z.text}</p>
                            <a href="#vysetrenie" class="press mt-2 inline-flex min-h-12 w-fit items-center border-3 border-ink bg-ink px-5 font-display text-base font-extrabold text-paper uppercase shadow-brutal-sm">
                              {ANAMNEZA.cta}
                            </a>
                          </div>
                        </LayeredCard>
                      ) : (
                        <article class:list={['z9-papier flex min-h-56 flex-col gap-3 p-5 sm:p-6', FARBA[z.id]]}>
                          <div class="flex items-center justify-between gap-3">
                            <Badge variant="outline" className="shadow-none hover:translate-x-0 hover:translate-y-0">
                              {z.kedy}
                            </Badge>
                            <span class="font-mono text-xs font-bold">záznam {cislo(z)} / {BIO.length}</span>
                          </div>
                          <p class="font-display text-4xl leading-[0.88] font-extrabold tracking-tight uppercase sm:text-5xl">{z.nazov}</p>
                          {z.kde && <p class="font-mono text-sm font-bold tracking-[0.12em] uppercase">{z.kde}</p>}
                          {z.text && <p class="text-lg leading-snug">{z.text}</p>}
                          {z.doplni && (
                            <div class="mt-auto pt-2">
                              <Sticker variant="outline" size="sm" rotation="slight" dashed>
                                text doplní Adam
                              </Sticker>
                            </div>
                          )}
                        </article>
                      )}
                      {z.citat && (
                        <StickyNote variant="yellow" size="default" rotation="tilt-right" pin className="relative z-10 -mt-4 ml-auto w-[88%] font-display text-lg leading-snug font-bold sm:w-[80%]">
                          „{z.citat}“
                        </StickyNote>
                      )}
                      {z.id === 'nemocnica' && (
                        <div class="absolute -right-3 -bottom-8 sm:-right-6">
                          <Stamp variant="secondary" size="lg" rotation="slight" className="font-mono text-[11px] tracking-[0.12em]">
                            {ANAMNEZA.peciatka}
                          </Stamp>
                        </div>
                      )}
                    </div>
                  </li>
                );
              })}
              {kap === 'Základ' && (
                <li class="relative min-w-0 lg:mt-10 lg:-ml-6" aria-label="Zástupná plocha pre koláž">
                  <div class="z9-list relative" style="--r:2.6deg; --r0:-14deg">
                    <span class="z9-paska z9-paska-biela" style="--pr:-4deg; left: 30%; top: -0.85rem" />
                    <div class="z9-papier z9-raster-cerveny relative grid aspect-[3/2] place-items-center overflow-hidden">
                      <StarShape size={120} color="var(--color-yellow)" strokeWidth={3} className="h-auto w-24" />
                      <p class="absolute inset-x-3 bottom-3 border-3 border-ink bg-white px-2 py-1 font-mono text-[11px] leading-tight font-bold tracking-[0.1em] uppercase">
                        HIGGSFIELD: 09-kolaz-cesta · 3:2 · risograf, papiere, nemocnica
                      </p>
                    </div>
                  </div>
                </li>
              )}
            </ol>
          </div>
        );
      })
    }
    <div class="pointer-events-none relative hidden h-0 lg:block" aria-hidden="true">
      <span class="absolute -top-[42rem] right-0 w-24 rotate-12"><LightningShape size={96} color="var(--color-yellow)" strokeWidth={3} className="h-auto w-full" /></span>
      <span class="absolute -top-[18rem] -left-4 w-20 -rotate-12"><HeartShape size={80} color="var(--color-stamp)" strokeWidth={3} className="h-auto w-full" /></span>
    </div>
  </div>
</section>
