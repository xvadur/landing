---
/** V7-07 · Opona ako dvere výťahu (variant src/components/home/Opona.astro). Nad dverami je ink preklad s ukazovateľom
 *  poschodia: 3 → 2 → 1 → R po schodoch (steps), pod wordmarkom XVA | DUR sa nakreslí čiara, potom sa krídla dverí
 *  rozídu do strán a odhalia recepciu (hero). Raz za návštevu (sessionStorage.opona), reduced motion = bez opony,
 *  scroll / klik / klávesa = preskočiť. Čisté CSS + malý inline skript (0 kB React). Google vidí hero, opona je aria-hidden. */
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';
---

<div id="opona" class="v07-vytah" aria-hidden="true" data-opona>
  <div class="v07-vytah-preklad">
    <span class="v07-vytah-sipka">▼</span>
    <span class="v07-vytah-okno"><span class="v07-vytah-pas"><span>3</span><span>2</span><span>1</span><span>R</span></span></span>
    <span class="v07-vytah-kam">Recepcia · príjem</span>
  </div>
  <div class="v07-vytah-kridlo v07-vytah-l tx-dots">
    <div class="v07-vytah-vrstva">
      <img class="v07-vytah-wm" src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
      <span class="v07-vytah-ciara"></span>
      <p lang="en" class="v07-vytah-motto v07-vytah-motto-l">{MOTTO_1}</p>
    </div>
  </div>
  <div class="v07-vytah-kridlo v07-vytah-r tx-dots">
    <div class="v07-vytah-vrstva v07-vytah-vrstva-r">
      <img class="v07-vytah-wm" src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
      <span class="v07-vytah-ciara"></span>
      <p lang="en" class="v07-vytah-motto v07-vytah-motto-r">{MOTTO_2}</p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById('opona');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('opona') === '1';
    } catch {
      /* súkromné okno: opona sa ukáže */
    }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduced) {
      el.remove();
      return;
    }
    try {
      sessionStorage.setItem('opona', '1');
    } catch {
      /* ignoruj */
    }
    const html = document.documentElement;
    html.classList.add('opona-lock');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      html.classList.remove('opona-lock');
      el.remove();
      window.dispatchEvent(new CustomEvent('opona:done'));
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.removeEventListener(t, skip));
    };
    const skip = () => {
      el.classList.add('v07-vytah-skip');
      setTimeout(finish, 260);
    };
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.addEventListener(t, skip, { passive: true }));
    setTimeout(finish, 1500 + 900 + 80);
  })();
</script>

<style>
  .v07-vytah {
    position: fixed;
    inset: 0;
    z-index: 90;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html.opona-lock) {
    overflow: hidden;
  }
  /* preklad nad dverami: ukazovateľ poschodia */
  .v07-vytah-preklad {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: var(--color-ink);
    color: var(--color-paper);
    border-bottom: 3px solid var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 13px;
    animation: v07-preklad 300ms steps(3, end) 1500ms forwards;
  }
  .v07-vytah-sipka {
    color: var(--color-yellow);
    animation: v07-blik 500ms steps(2, end) 3;
  }
  .v07-vytah-okno {
    display: inline-block;
    height: 40px;
    width: 40px;
    overflow: hidden;
    border: 3px solid var(--color-paper);
    background: var(--color-ink);
  }
  .v07-vytah-pas {
    display: flex;
    flex-direction: column;
    animation: v07-poschodie 1050ms steps(3, end) 150ms forwards;
  }
  .v07-vytah-pas span {
    display: flex;
    height: 34px;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    color: var(--color-yellow);
    letter-spacing: 0;
  }
  @keyframes v07-poschodie {
    to { transform: translateY(-102px); }
  }
  @keyframes v07-blik {
    50% { opacity: 0; }
  }
  @keyframes v07-preklad {
    to { transform: translateY(-100%); }
  }
  .v07-vytah-kridlo {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    background-color: var(--color-yellow);
    --tx: 26%;
    will-change: transform;
    animation-duration: 900ms;
    animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    animation-delay: 1500ms;
    animation-fill-mode: forwards;
  }
  .v07-vytah-l {
    left: 0;
    border-right: 3px solid var(--color-ink);
    animation-name: v07-dvere-l;
  }
  .v07-vytah-r {
    right: 0;
    border-left: 3px solid var(--color-ink);
    animation-name: v07-dvere-r;
  }
  /* madlá dverí: hrubé ink pásy pri štrbine */
  .v07-vytah-l::after,
  .v07-vytah-r::after {
    content: '';
    position: absolute;
    top: 38%;
    width: 10px;
    height: 24%;
    background: var(--color-ink);
  }
  .v07-vytah-l::after { right: 18px; }
  .v07-vytah-r::after { left: 18px; }
  .v07-vytah-vrstva {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100%;
  }
  .v07-vytah-vrstva-r {
    left: -50vw;
  }
  .v07-vytah-wm {
    --wmw: min(84vw, 1180px);
    position: absolute;
    top: 50%;
    left: calc(50vw - var(--wmw) * 0.4764);
    width: var(--wmw);
    height: auto;
    max-width: none;
    transform: translateY(-50%);
  }
  .v07-vytah-ciara {
    --wmw: min(84vw, 1180px);
    position: absolute;
    top: calc(50% + var(--wmw) * 0.096 + 0.35rem);
    left: calc(50vw - var(--wmw) * 0.4764);
    width: var(--wmw);
    height: clamp(4px, 0.45vw, 9px);
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: 47.64% 50%;
    animation: v07-ciara 1000ms steps(8, end) 400ms forwards;
  }
  @keyframes v07-ciara {
    to { transform: scaleX(1); }
  }
  .v07-vytah-motto {
    --wmw: min(84vw, 1180px);
    position: absolute;
    top: calc(50% + var(--wmw) * 0.096 + 1.4rem);
    margin: 0;
    max-width: calc(50vw - 1.5rem);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 1rem + 3.2vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .v07-vytah-motto-l {
    right: calc(50vw + 1rem);
    text-align: right;
  }
  .v07-vytah-motto-r {
    left: calc(50vw + 1rem);
    text-align: left;
  }
  @media (min-width: 640px) {
    .v07-vytah-motto { top: calc(50% + var(--wmw) * 0.096 + 2rem); }
    .v07-vytah-motto-l { right: calc(50vw + 1.5rem); }
    .v07-vytah-motto-r { left: calc(50vw + 1.5rem); }
  }
  @keyframes v07-dvere-l {
    to { transform: translateX(-101%); }
  }
  @keyframes v07-dvere-r {
    to { transform: translateX(101%); }
  }
  .v07-vytah-skip .v07-vytah-kridlo,
  .v07-vytah-skip .v07-vytah-ciara,
  .v07-vytah-skip .v07-vytah-preklad {
    animation-duration: 250ms;
    animation-delay: 0ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .v07-vytah { display: none; }
  }
</style>
