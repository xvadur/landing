---
/** V7-06 Lekáreň · opona = automatické dvere lekárne. Variant src/components/home/Opona.astro (podpis 1 z /kit/vendor/):
 *  dve sklenené krídla so wordmarkom XVADUR (XVA | DUR), pod nimi motto, nad dverami štít „✚ Lekáreň“ a senzor.
 *  Na dverách visí ceduľka ZATVORENÉ → preklopí sa na OTVORENÉ, senzor blikne (steps) a krídla sa rozídu do strán.
 *  Pravidlá ako pôvodná opona: raz za návštevu (sessionStorage.opona), reduced motion = bez opony, scroll / klik /
 *  klávesa = preskočiť (250 ms), bez JS sa opona otvorí sama (CSS delay + forwards). aria-hidden, hero je pod ňou celý čas. */
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';
---

<div id="opona" class="dv" aria-hidden="true" data-opona>
  <div class="dv-stit">
    <span class="dv-stit-kriz">✚</span>
    <span>Lekáreň XVADUR</span>
    <span class="dv-senzor"></span>
  </div>
  <div class="dv-kridlo dv-l">
    <div class="dv-sklo tx-dots"></div>
    <div class="dv-vrstva">
      <img class="dv-wm" src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
      <p lang="en" class="dv-motto dv-motto-l">{MOTTO_1}</p>
    </div>
    <span class="dv-madlo dv-madlo-l"></span>
  </div>
  <div class="dv-kridlo dv-r">
    <div class="dv-sklo tx-dots"></div>
    <div class="dv-vrstva dv-vrstva-r">
      <img class="dv-wm" src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
      <p lang="en" class="dv-motto dv-motto-r">{MOTTO_2}</p>
    </div>
    <span class="dv-madlo dv-madlo-r"></span>
  </div>
  <div class="dv-cedulka">
    <span class="dv-snurka"></span>
    <span class="dv-tabula">
      <span class="dv-zatv">Zatvorené</span>
      <span class="dv-otv">Otvorené</span>
    </span>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById('opona');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('opona') === '1';
    } catch {
      /* súkromné okno: opona sa ukáže */
    }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduced) {
      el.remove();
      return;
    }
    try {
      sessionStorage.setItem('opona', '1');
    } catch {
      /* ignoruj */
    }
    const html = document.documentElement;
    html.classList.add('opona-lock');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      html.classList.remove('opona-lock');
      el.remove();
      window.dispatchEvent(new CustomEvent('opona:done'));
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.removeEventListener(t, skip));
    };
    const skip = () => {
      el.classList.add('dv-skip');
      setTimeout(finish, 260);
    };
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.addEventListener(t, skip, { passive: true }));
    el.classList.add('dv-go');
    setTimeout(finish, 1500 + 900 + 80);
  })();
</script>

<style>
  .dv {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html.opona-lock) {
    overflow: hidden;
  }
  /* štít nad dverami */
  .dv-stit {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    height: clamp(3.25rem, 2.5rem + 3vw, 5rem);
    border-bottom: 3px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 0.8rem + 1.6vw, 2.2rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    animation: dv-stit 700ms cubic-bezier(0.76, 0, 0.24, 1) 1500ms forwards;
  }
  .dv-stit-kriz {
    color: var(--color-yellow);
  }
  .dv-senzor {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--color-paper);
    background: var(--color-paper);
    opacity: 0.35;
    animation: dv-senzor 600ms steps(3, end) 800ms forwards;
  }
  @keyframes dv-senzor {
    to {
      opacity: 1;
      background: var(--color-stamp);
    }
  }
  @keyframes dv-stit {
    to {
      transform: translateY(-101%);
    }
  }
  .dv-kridlo {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    background: var(--color-yellow);
    will-change: transform;
    animation-duration: 900ms;
    animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    animation-delay: 1500ms;
    animation-fill-mode: forwards;
  }
  .dv-l {
    left: 0;
    border-right: 3px solid var(--color-ink);
    animation-name: dv-l;
  }
  .dv-r {
    right: 0;
    border-left: 3px solid var(--color-ink);
    animation-name: dv-r;
  }
  /* sklo: rám dverí 3 px ink, vnútorná tabuľa s bodkami */
  .dv-sklo {
    position: absolute;
    inset: clamp(4.5rem, 3.5rem + 3vw, 6.5rem) clamp(0.75rem, 2vw, 2rem) clamp(0.75rem, 2vw, 2rem);
    border: 3px solid var(--color-ink);
    background-color: var(--color-paper);
    --tx: 18%;
  }
  .dv-madlo {
    position: absolute;
    top: 50%;
    width: 10px;
    height: clamp(5rem, 16vh, 9rem);
    margin-top: calc(clamp(5rem, 16vh, 9rem) / -2);
    border: 3px solid var(--color-ink);
    background: var(--color-white);
    box-shadow: 3px 3px 0 0 var(--color-ink);
    z-index: 2;
  }
  .dv-madlo-l {
    right: clamp(1.4rem, 3vw, 3rem);
  }
  .dv-madlo-r {
    left: clamp(1.4rem, 3vw, 3rem);
  }
  .dv-vrstva {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100%;
    z-index: 1;
  }
  .dv-vrstva-r {
    left: -50vw;
  }
  .dv-wm {
    --wmw: min(84vw, 1180px);
    position: absolute;
    top: 50%;
    left: calc(50vw - var(--wmw) * 0.4764);
    width: var(--wmw);
    height: auto;
    max-width: none;
    transform: translateY(-50%);
  }
  .dv-motto {
    --wmw: min(84vw, 1180px);
    position: absolute;
    top: calc(50% + var(--wmw) * 0.096 + 1rem);
    margin: 0;
    max-width: calc(50vw - 2.5rem);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 0.9rem + 3vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .dv-motto-l {
    right: calc(50vw + 1.25rem);
    text-align: right;
  }
  .dv-motto-r {
    left: calc(50vw + 1.25rem);
    text-align: left;
  }
  /* ceduľka na dverách: visí na šnúrke, preklopí sa ZATVORENÉ → OTVORENÉ */
  .dv-cedulka {
    position: absolute;
    top: clamp(4.5rem, 3.5rem + 3vw, 6.5rem);
    left: 50%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    animation: dv-cedulka 500ms steps(4, end) 1500ms forwards;
  }
  .dv-snurka {
    width: 3px;
    height: clamp(1.5rem, 5vh, 3rem);
    background: var(--color-ink);
  }
  .dv-tabula {
    position: relative;
    display: grid;
    padding: 0.4rem 0.9rem;
    border: 3px solid var(--color-ink);
    background: var(--color-white);
    box-shadow: 4px 4px 0 0 var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transform-origin: 50% 0;
    animation: dv-preklop 420ms steps(3, end) 700ms forwards;
  }
  .dv-zatv,
  .dv-otv {
    grid-area: 1 / 1;
  }
  .dv-otv {
    opacity: 0;
    animation: dv-otv 1ms linear 910ms forwards;
  }
  .dv-zatv {
    animation: dv-zatv 1ms linear 910ms forwards;
  }
  @keyframes dv-preklop {
    50% {
      transform: rotateX(90deg);
    }
    to {
      transform: rotateX(0deg);
      background: var(--color-yellow);
    }
  }
  @keyframes dv-otv {
    to {
      opacity: 1;
    }
  }
  @keyframes dv-zatv {
    to {
      opacity: 0;
    }
  }
  @keyframes dv-cedulka {
    to {
      transform: translate(-50%, -140%);
      opacity: 0;
    }
  }
  @keyframes dv-l {
    to {
      transform: translateX(-101%);
    }
  }
  @keyframes dv-r {
    to {
      transform: translateX(101%);
    }
  }
  .dv-skip .dv-l,
  .dv-skip .dv-r,
  .dv-skip .dv-stit,
  .dv-skip .dv-cedulka {
    animation-duration: 250ms;
    animation-delay: 0ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .dv {
      display: none;
    }
  }
</style>
