---
/** V7-10 · Opona „sterilné rúško z dlaždíc“ (variant home/Opona.astro). Celá obrazovka je žlté rúško poskladané z dlaždíc
 *  (4 × 3 desktop, 2 × 4 mobil), cez ne wordmark XVADUR s EKG čiarou a mottom. Po 1,2 s sa wordmark zdvihne a dlaždice
 *  jedna po druhej „odídu z podnosu“ hore (podpis variantu: zdvih s rastúcim tieňom 0 → 11 px, potom preč), pod nimi je
 *  hero. Pravidlá ako originál: raz za návštevu (sessionStorage.opona), reduced motion = bez opony, scroll / klik /
 *  klávesa = preskočiť. Čisto CSS + malý inline skript (session, zámok scrollu). */
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';
import { ekgPath } from '@/components/v5/Symboly';

/** poradie odchodu dlaždíc (nie zľava doprava — ako keď sestra berie nástroje z podnosu) */
const PORADIE = [5, 0, 9, 2, 7, 11, 1, 6, 3, 10, 4, 8];
const NAKLON = [-4, 3, -2, 5, -3, 2, -5, 4, -1, 3, -4, 2];
---

<div id="opona" class="v10-opona" aria-hidden="true" data-opona>
  <div class="v10-opona-rusko">
    {PORADIE.map((p, i) => <span class="v10-opona-dl" style={`--i:${p};--r:${NAKLON[i]}deg`} />)}
  </div>
  <div class="v10-opona-znak">
    <img src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" class="v10-opona-wm" />
    <svg viewBox="0 0 600 40" preserveAspectRatio="none" class="v10-opona-ekg">
      <path d={ekgPath(600, 200)} pathLength="1" fill="none" stroke="currentColor" stroke-width="5" vector-effect="non-scaling-stroke"></path>
    </svg>
    <p lang="en" class="v10-opona-motto">{MOTTO_1} {MOTTO_2}</p>
    <p class="v10-opona-stitok">✚ podnos pripravený</p>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById('opona');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('opona') === '1';
    } catch {
      /* súkromné okno: opona sa ukáže */
    }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduced) {
      el.remove();
      return;
    }
    try {
      sessionStorage.setItem('opona', '1');
    } catch {
      /* ignoruj */
    }
    const html = document.documentElement;
    html.classList.add('opona-lock');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      html.classList.remove('opona-lock');
      el.remove();
      window.dispatchEvent(new CustomEvent('opona:done'));
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.removeEventListener(t, skip));
    };
    const skip = () => {
      el.classList.add('v10-opona-skip');
      setTimeout(finish, 300);
    };
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.addEventListener(t, skip, { passive: true }));
    el.classList.add('v10-opona-go');
    setTimeout(finish, 2750);
  })();
</script>

<style>
  .v10-opona {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html.opona-lock) {
    overflow: hidden;
  }
  .v10-opona-rusko {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(4, 1fr);
  }
  @media (min-width: 768px) {
    .v10-opona-rusko {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(3, 1fr);
    }
  }
  .v10-opona-dl {
    background-color: var(--color-yellow);
    background-image: radial-gradient(color-mix(in srgb, var(--color-ink) 22%, transparent) 1.2px, transparent 1.6px);
    background-size: 14px 14px;
    border: 1.5px solid var(--color-ink);
    will-change: transform;
    animation: v10-odchod 640ms var(--bk-ease-stamp) forwards;
    animation-delay: calc(1300ms + var(--i) * 55ms);
  }
  /* mobil má iba 8 dlaždíc */
  @media (max-width: 767px) {
    .v10-opona-dl:nth-child(n + 9) {
      display: none;
    }
  }
  @keyframes v10-odchod {
    0% {
      transform: none;
      box-shadow: 0 0 0 0 var(--color-ink);
    }
    22% {
      transform: translate(-5px, -5px);
      box-shadow: 11px 11px 0 0 var(--color-ink);
    }
    100% {
      transform: translate(-5px, -118vh) rotate(var(--r));
      box-shadow: 11px 11px 0 0 var(--color-ink);
    }
  }
  .v10-opona-znak {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    color: var(--color-ink);
    animation: v10-znak 520ms var(--bk-ease-stamp) 1100ms forwards;
  }
  @keyframes v10-znak {
    0% {
      transform: none;
    }
    30% {
      transform: translate(-6px, -6px);
    }
    100% {
      transform: translate(-6px, -120vh);
    }
  }
  .v10-opona-wm {
    width: min(84vw, 980px);
    height: auto;
    filter: drop-shadow(6px 6px 0 var(--color-paper));
  }
  .v10-opona-ekg {
    width: min(84vw, 980px);
    height: clamp(22px, 3vw, 40px);
    overflow: visible;
  }
  .v10-opona-ekg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: v10-ekg-kresli 800ms steps(8, end) 200ms forwards;
  }
  @keyframes v10-ekg-kresli {
    to {
      stroke-dashoffset: 0;
    }
  }
  .v10-opona-motto {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 0.9rem + 2.6vw, 3.4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-align: center;
    background: var(--color-paper);
    border: 3px solid var(--color-ink);
    padding: 0.2em 0.45em;
    box-shadow: 6px 6px 0 0 var(--color-ink);
  }
  .v10-opona-stitok {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .v10-opona-skip .v10-opona-dl {
    animation-duration: 260ms;
    animation-delay: calc(var(--i) * 8ms);
  }
  .v10-opona-skip .v10-opona-znak {
    animation-duration: 220ms;
    animation-delay: 0ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .v10-opona {
      display: none;
    }
  }
</style>
