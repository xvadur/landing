---
/** V7-10 · lišta podnosu: X + XVADUR, štítky podnosov (skok na sekciu), ⌘K a stále CTA Vyšetrenie (hot).
 *  Mobil: X, ⌘K, CTA a menu (Base → NavMobil, [data-nav-open]). Statické Astro, ⌘K cez udalosť v710:paleta. */
import { PODNOSY } from './data';
---

<header class="v10-lista sticky top-0 z-40 border-b-3 border-ink bg-paper">
  <div class="mx-auto flex h-16 w-full max-w-[1440px] items-center gap-3 px-4 sm:px-6 lg:px-10">
    <a href="#prijem" class="flex min-h-11 shrink-0 items-center gap-2" aria-label="XVADUR · Príjem">
      <img src="/brand/x.svg" alt="" width="26" height="32" class="h-8 w-auto" />
      <span class="hidden font-display text-xl font-extrabold tracking-tight uppercase sm:inline">Xvadur</span>
    </a>
    <nav aria-label="Podnosy" class="hidden min-w-0 flex-1 justify-center lg:flex">
      <ul class="flex flex-wrap items-center gap-1.5">
        {
          PODNOSY.slice(1).map((p) => (
            <li class:list={[p.id === 'hry' || p.id === 'vitalne' ? 'hidden 2xl:block' : '']}>
              <a
                href={`#${p.id}`}
                class="v10-stitok-odkaz inline-flex min-h-11 items-center border-2 border-transparent px-2 font-mono text-[11px] font-bold tracking-[0.12em] uppercase hover:border-ink hover:bg-yellow"
              >
                <span class="mr-1 text-ink/50">{p.cislo}</span>
                {p.nazov}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <button
        type="button"
        data-v710-paleta
        class="press inline-flex h-11 items-center gap-2 border-3 border-ink bg-white px-3 font-mono text-xs font-bold uppercase shadow-brutal-sm"
        aria-label="Kam chceš ísť? Otvoriť paletu (⌘K)"
      >
        <span aria-hidden="true">⌘K</span>
        <span class="hidden xl:inline">Kam ísť</span>
      </button>
      <a
        href="#vysetrenie"
        data-track="konzultacia_klik"
        data-track-miesto="v710-lista"
        class="press inline-flex h-11 items-center border-3 border-ink bg-hot px-3 font-display text-sm font-extrabold text-ink uppercase shadow-brutal-sm sm:px-4 sm:text-base"
      >
        Vyšetrenie
      </a>
      <button
        type="button"
        data-nav-open
        class="press inline-flex h-11 w-11 items-center justify-center border-3 border-ink bg-yellow shadow-brutal-sm lg:hidden"
        aria-label="Otvoriť menu"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="3" /></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // názov udalosti = UDALOST.paleta v data.ts (tu natvrdo, aby skript neťahal dáta webu)
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement | null;
    if (t?.closest('[data-v710-paleta]')) window.dispatchEvent(new CustomEvent('v710:paleta'));
  });
</script>
