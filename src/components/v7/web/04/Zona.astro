---
/** V7-04 · jedna triážna zóna: hlavička v farbe úrovne (číslo, úroveň, názov, pečiatka, ktorá „udrie“, keď sa zóna
 *  stane aktuálnou — stav.ts) a telo. Úroveň 2 (hot) má celú hlavičku ako odkaz na rezerváciu (CTA). */
import { Stamp } from '@/components/ui/sticker';
import { cn } from '@/lib/utils';
import { FARBA_TRIEDY, ZONY } from './data';

interface Props {
  n: 1 | 2 | 3 | 4 | 5;
  /** trieda tela zóny (pozadie) */
  telo?: string;
  class?: string;
}
const { n, telo = 'bg-paper', class: trieda } = Astro.props;
const z = ZONY[n - 1]!;
const PEC: Record<number, 'outline' | 'default' | 'destructive' | 'secondary'> = { 1: 'outline', 2: 'default', 3: 'default', 4: 'destructive', 5: 'secondary' };
const hlavaId = `${z.id}-h`;
const Obal = n === 2 ? 'a' : 'div';
---

<section id={z.id} data-zona={n} class={cn('t-zona relative', trieda)} aria-labelledby={hlavaId}>
  <header class={cn('t-hlava relative overflow-hidden border-y-3 border-ink', FARBA_TRIEDY[z.farba])}>
    <div class={cn('pointer-events-none absolute inset-0', n === 5 || n === 1 ? 't-srafy-svetle' : 't-srafy')} aria-hidden="true"></div>
    <Obal
      class={cn('t-hlava-in relative mx-auto flex w-full max-w-[1400px] items-center gap-4 px-4 py-5 sm:gap-6 sm:px-6 lg:px-10 lg:py-6', n === 2 && 'group')}
      {...(n === 2 ? { href: '#termin', 'data-track': 'konzultacia_klik', 'data-track-miesto': 'triaz-2' } : {})}
    >
      <span
        class={cn(
          'flex h-16 w-16 shrink-0 items-center justify-center border-3 border-ink font-display text-5xl font-extrabold shadow-brutal-sm sm:h-20 sm:w-20 sm:text-6xl',
          n === 5 ? 'bg-paper text-ink' : 'bg-ink text-paper',
        )}
        aria-hidden="true">{n}</span
      >
      <div class="min-w-0 flex-1">
        <p class="font-mono text-xs font-bold tracking-[0.18em] uppercase sm:text-sm">Triáž {n} · {z.uroven}</p>
        <h2 id={hlavaId} class="mt-1 font-display text-[clamp(2rem,1.2rem+3.4vw,4.2rem)] leading-[0.9] font-extrabold tracking-tight uppercase">
          {z.nazov}
          {n === 2 && <span class="inline-block transition-transform group-hover:translate-x-2" aria-hidden="true"> →</span>}
        </h2>
        <p class="mt-2 hidden max-w-xl text-lg leading-snug sm:block">{n === 2 ? `${z.veta} Klikni a vyber si termín.` : z.veta}</p>
      </div>
      <span data-peciatka class="t-peciatka relative hidden shrink-0 sm:inline-flex" aria-hidden="true">
        <Stamp variant={PEC[n]} size="default" rotation="none" doubleRing className="shadow-brutal-sm">
          <span class="flex flex-col items-center leading-none"><span class="text-[0.6rem]">Triáž</span><span class="font-display text-3xl">{n}</span></span>
        </Stamp>
        <span class="t-vlna"></span>
      </span>
    </Obal>
  </header>
  <div class={cn('t-telo relative', telo)}>
    <slot />
  </div>
</section>
