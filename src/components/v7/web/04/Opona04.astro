---
/** V7-04 · Opona ako posuvné dvere urgentného príjmu (variant src/components/home/Opona.astro).
 *  Žlté krídla s bodkami, wordmark XVADUR rozdelený XVA | DUR, pod ním motto. Cez oboje dvere ide triážna páska
 *  s piatimi úrovňami: rozsvieti sa po schodoch (steps(5)), potom „PRIJATÝ“ udrie ako pečiatka (--bk-ease-stamp)
 *  a dvere sa rozídu do strán. Raz za návštevu (sessionStorage.opona), reduced motion = bez opony,
 *  scroll / klik / klávesa = preskočiť. Po skončení window „opona:done“ (spustí prvú pečiatku na stránke). */
import { MOTTO_1, MOTTO_2 } from '@/components/hero/hero-data';

const PAS = ['stamp', 'hot', 'yellow', 'white', 'ink'];
---

<div id="opona04" class="o4" aria-hidden="true">
  {
    (['l', 'r'] as const).map((s) => (
      <div class:list={['o4-kridlo tx-dots', `o4-${s}`]}>
        <div class:list={['o4-vrstva', s === 'r' && 'o4-vrstva-r']}>
          <p class="o4-znak">✚ Urgentný príjem · triáž</p>
          <img class="o4-wm" src="/brand/xvadur-ink.svg" alt="" width="678" height="130" decoding="async" />
          <div class="o4-pas">
            {PAS.map((f, i) => (
              <span class="o4-seg" style={`--f: var(--color-${f}); --i:${i}`}>
                <b>{i + 1}</b>
              </span>
            ))}
          </div>
          <p lang="en" class="o4-motto">
            {MOTTO_1} {MOTTO_2}
          </p>
        </div>
        <span class="o4-rukovat" />
      </div>
    ))
  }
  <span class="o4-peciatka">Prijatý</span>
</div>

<script is:inline>
  (() => {
    const el = document.getElementById('opona04');
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem('opona') === '1';
    } catch {
      /* súkromné okno */
    }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduced) {
      el.remove();
      return;
    }
    try {
      sessionStorage.setItem('opona', '1');
    } catch {
      /* ignoruj */
    }
    const html = document.documentElement;
    html.classList.add('opona-lock');
    let done = false;
    const off = () => {
      window.removeEventListener('wheel', skip);
      window.removeEventListener('touchstart', skip);
      window.removeEventListener('keydown', skip);
      window.removeEventListener('pointerdown', skip);
    };
    const finish = () => {
      if (done) return;
      done = true;
      html.classList.remove('opona-lock');
      el.remove();
      off();
      window.dispatchEvent(new CustomEvent('opona:done'));
    };
    const skip = () => {
      el.classList.add('o4-skip');
      setTimeout(finish, 260);
    };
    window.addEventListener('wheel', skip, { passive: true });
    window.addEventListener('touchstart', skip, { passive: true });
    window.addEventListener('keydown', skip);
    window.addEventListener('pointerdown', skip);
    setTimeout(finish, 1500 + 800 + 80);
  })();
</script>

<style>
  .o4 {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
  }
  :global(html.opona-lock) {
    overflow: hidden;
  }
  .o4-kridlo {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    background-color: var(--color-yellow);
    --tx: 22%;
    animation: 800ms var(--bk-ease-stamp) 1500ms forwards;
  }
  .o4-l {
    left: 0;
    border-right: 3px solid var(--color-ink);
    animation-name: o4-l;
  }
  .o4-r {
    right: 0;
    border-left: 3px solid var(--color-ink);
    animation-name: o4-r;
  }
  @keyframes o4-l {
    to { transform: translateX(-101%); }
  }
  @keyframes o4-r {
    to { transform: translateX(101%); }
  }
  /* rukoväť dverí pri strede */
  .o4-rukovat {
    position: absolute;
    top: calc(50% - 5rem);
    width: 14px;
    height: 10rem;
    border: 3px solid var(--color-ink);
    background: var(--color-white);
    box-shadow: 4px 4px 0 0 var(--color-ink);
  }
  .o4-l .o4-rukovat { right: 22px; }
  .o4-r .o4-rukovat { left: 22px; }
  .o4-vrstva {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vh, 2rem);
    padding: 0 1rem;
  }
  .o4-vrstva-r {
    left: -50vw;
  }
  .o4-znak {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(0.75rem, 0.6rem + 0.6vw, 1rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: var(--color-white);
    border: 3px solid var(--color-ink);
    padding: 0.35rem 0.75rem;
    box-shadow: 4px 4px 0 0 var(--color-ink);
  }
  .o4-wm {
    width: min(84vw, 1100px);
    height: auto;
    max-width: none;
  }
  .o4-pas {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    width: min(84vw, 1100px);
    border: 3px solid var(--color-ink);
    box-shadow: 6px 6px 0 0 var(--color-ink);
    background: var(--color-paper);
  }
  .o4-seg {
    height: clamp(2.2rem, 5vh, 3.4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 3px solid var(--color-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, 0.8rem + 1vw, 1.6rem);
    color: var(--color-ink);
    background: var(--color-paper);
    animation: o4-seg 1ms steps(1, end) forwards;
    animation-delay: calc(250ms + var(--i) * 170ms);
  }
  .o4-seg:first-child {
    border-left: 0;
  }
  @keyframes o4-seg {
    to { background: var(--f); }
  }
  /* text na stamp a ink papier, inak ink */
  .o4-seg:nth-child(1),
  .o4-seg:nth-child(5) {
    animation-name: o4-seg-t;
  }
  @keyframes o4-seg-t {
    to { background: var(--f); color: var(--color-paper); }
  }
  .o4-motto {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 1rem + 3vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-align: center;
  }
  .o4-peciatka {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: clamp(7.5rem, 16vw, 12rem);
    aspect-ratio: 1;
    border-radius: 999px;
    border: 5px double var(--color-ink);
    outline: 4px solid var(--color-stamp);
    background: var(--color-stamp);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 0.8rem + 1.4vw, 2rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 6px 6px 0 0 var(--color-ink);
    opacity: 0;
    transform: translate(-50%, -50%) scale(2.6) rotate(-28deg);
    animation:
      o4-uder 380ms var(--bk-ease-stamp) 1120ms forwards,
      o4-prec 200ms steps(2, end) 1560ms forwards;
  }
  @keyframes o4-uder {
    to { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-12deg); }
  }
  @keyframes o4-prec {
    to { opacity: 0; }
  }
  .o4-skip .o4-kridlo {
    animation-duration: 250ms;
    animation-delay: 0ms;
  }
  .o4-skip .o4-peciatka {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .o4 { display: none; }
  }
</style>
