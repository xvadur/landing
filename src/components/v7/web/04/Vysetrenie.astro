---
/** V7-04 · Triáž 2 · Vyšetrenie (telo zóny na ink). Vľavo prečo a ako: VLAJKA z ponuka.ts, tri kroky vyšetrenia,
 *  priebeh 30 minút (PRIEBEH, Progress = koľko z 30 minút je za tebou po každej fáze), zástupná plocha záberu T2.
 *  Vpravo funkčná rezervácia (ostrov Rezervacia). Texty z v5/Konzultacia.astro a data/ponuka.ts. */
import { Progress } from '@/components/ui/progress';
import { Sticker } from '@/components/ui/sticker';
import { Separator } from '@/components/ui/separator';
import { VLAJKA } from '@/data/ponuka';
import { CESTA_KLIENTA } from './data';
import Rezervacia from './Rezervacia';
import Zaber from './Zaber.astro';

const KROKY = ['Triáž', 'Diagnóza', 'Plán liečby'];
---

<div class="relative mx-auto grid w-full max-w-[1400px] gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14 lg:px-10 lg:py-20">
  <div class="flex min-w-0 flex-col gap-7 text-paper">
    <div class="flex flex-wrap items-center gap-3">
      <Sticker variant="secondary" rotation="slight" className="t-dopad">{VLAJKA.nazov} · {VLAJKA.trvanie}</Sticker>
      <Sticker variant="outline" rotation="slight-right" tape className="t-dopad">{VLAJKA.cena}</Sticker>
    </div>
    <h3 class="font-display text-[clamp(2.4rem,1.2rem+4.4vw,4.6rem)] leading-[0.9] font-extrabold tracking-tight uppercase">
      Objednaj sa<br />na vyšetrenie.
    </h3>
    <p class="max-w-lg font-display text-2xl leading-tight font-bold">{VLAJKA.titulok}</p>

    <ol class="grid gap-3" role="list">
      {
        VLAJKA.body.map((b, i) => (
          <li class="t-odhal flex gap-4 border-3 border-paper bg-ink p-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center border-3 border-paper bg-yellow font-display text-xl font-extrabold text-ink">{i + 1}</span>
            <span class="text-base leading-snug">
              <b class="block font-mono text-xs tracking-[0.14em] text-yellow uppercase">{KROKY[i]}</b>
              {b.replace(/^[^:]+:\s*/, '')}
            </span>
          </li>
        ))
      }
    </ol>

    <Separator className="bg-paper/40" />

    <div>
      <p class="mb-3 font-mono text-sm font-bold tracking-[0.16em] text-yellow uppercase">Priebeh 30 minút</p>
      <ol class="grid gap-3" role="list">
        {
          CESTA_KLIENTA.map((k) => (
            <li class="grid grid-cols-[4.5rem_1fr] items-center gap-x-3 gap-y-1">
              <span class="font-mono text-sm font-bold">{k.cas}</span>
              <span class="text-base leading-snug font-bold">{k.vznikne}</span>
              <span class="font-mono text-[0.65rem] text-paper/60">{k.od + k.trvanie} / 30</span>
              <Progress
                value={k.od + k.trvanie}
                max={30}
                variant="stepped"
                aria-label={`Po fáze ${k.cas}: ${k.od + k.trvanie} z 30 minút`}
                className="h-3 border-2 border-paper bg-ink shadow-none [&>div]:bg-yellow"
              />
            </li>
          ))
        }
      </ol>
    </div>

    <Zaber id="04-T2-sestra" popis="triážna sestra s tabletom" pomer="4 / 3" n={2} class="t-odhal mt-2 max-w-md" />
  </div>

  <div id="termin" class="min-w-0 scroll-mt-28 lg:sticky lg:top-24 lg:self-start">
    <Rezervacia client:visible />
    <p class="mt-4 text-sm text-paper/75">Radšej píšeš? <a class="font-bold text-yellow underline underline-offset-4" href="mailto:adam@xvadur.com">adam@xvadur.com</a></p>
  </div>
</div>
