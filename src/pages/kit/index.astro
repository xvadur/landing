---
/** V7 · Katalóg surovín (29. 9. 2026): rozcestník živých ukážok BoldKitu a vendor kitov v tokenoch xvadur.com. Noindex. */
import Base from '@/layouts/Base.astro';

const skupiny = [
  { href: '/kit/formulare/', meno: 'Formuláre a rezervácia', co: 'vstupy, výbery, kalendár, čas, stepper, viackrokový formulár, vyšetrenie' },
  { href: '/kit/grafy/', meno: 'Grafy a dáta', co: '10 typov grafov, stat-card, tabuľky, Korpus: heatmapa aktívnych dní a živé čísla' },
  { href: '/kit/tvary/', meno: 'Tvary, nálepky, efekty', co: 'všetky tvary, ASCII a canvas efekty, nálepky, krivky, pohybové primitívy, hero rámy' },
  { href: '/kit/rozlozenie/', meno: 'Rozloženie a navigácia', co: 'karty, záložky, karusel, časová os, strom, menu; recepty bio a projektov' },
  { href: '/kit/prekrytia/', meno: 'Prekrytia a interakcie', co: 'dialóg, sheet, drawer, popover, Cmd+K, hlásenia, sprievodca; recepty hier' },
  { href: '/kit/vendor/', meno: 'Vendor kity a pohyb', co: 'neobrutalism.dev, Magic UI, React Bits, Motion Primitives, Fancy, GSAP, Motion, shadery; podpisové pohyby' },
];
---

<Base title="Kit · XVADUR" description="Katalóg komponentov XVADUR v tokenoch xvadur.com." noindex islands="lite" header="none">
  <main class="mx-auto flex max-w-5xl flex-col gap-8 px-4 py-12">
    <header class="flex flex-col gap-3">
      <p class="eyebrow">V7 · suroviny</p>
      <h1 class="font-display text-display-md uppercase">Kit XVADUR</h1>
      <p class="max-w-2xl">Jedna stavebnica pre celý ekosystém: xvadur.com, Hriech, Netopier. Tu je každý kus naživo, vo všetkých variantoch a s tvojím obsahom.</p>
    </header>
    <ul class="grid gap-4 sm:grid-cols-2">
      {skupiny.map((s, i) => (
        <li>
          <a href={s.href} class="brutal lift press flex min-h-44 flex-col gap-2 bg-white p-5">
            <span class="font-mono text-sm">0{i + 1}</span>
            <span class="font-display text-display-xs uppercase">{s.meno}</span>
            <span class="text-sm">{s.co}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="font-mono text-sm"><a class="underline" href="/v7-kit/">/v7-kit</a> — prvá kontrola tokenov</p>
  </main>
</Base>
