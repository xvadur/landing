---
/** /konzultacia/ — verejná ponuka (pack 04 verbatim), priebeh 30 minút (#priebeh), šesť otázok (#otazky),
 *  voľba najmenšieho užitočného riešenia (#riesenie), vstup pred stretnutím (#vstup), intake formulár (#formular).
 *  Bez backendu: formulár → WhatsApp / mailto payload. islands="lite" (Toaster pre kopírovanie).
 *  Query kontrakt (kvíz / plán): ?z=kviz|plan&kto=&hodiny=&sadzba=&krok= → štítok v hero + predvyplnenie ostrova. */
import Base from '@/layouts/Base.astro';
import Section from '@/components/site/Section.astro';
import Marquee from '@/components/site/Marquee.astro';
import XMark from '@/components/site/XMark.astro';
import { routeByPath } from '@/data/routes';
import Intake from '@/components/konzultacia/Intake';
import {
  OTAZKY,
  OTAZKY_POZNAMKA,
  PONUKA,
  PRIEBEH,
  PRIEBEH_POZNAMKA,
  RIESENIA,
  RIESENIA_POZNAMKA,
  VSTUP_CITLIVE,
  VSTUP_TEXT,
} from '@/components/konzultacia/data';
import { EMAIL } from '@/components/konzultacia/payload';

const r = routeByPath('/konzultacia/')!;
const btn =
  'press inline-flex min-h-12 items-center justify-center gap-3 rounded-lg border-3 border-ink px-5 font-display text-lg font-extrabold uppercase tracking-wide shadow-brutal';
/* Hlavičky stĺpcov: 14 px mono (eyebrow utilita základu je 13 px — pod hranicou pre bežný text). */
const th = 'px-4 py-3 font-mono text-sm font-medium uppercase tracking-[0.14em] sm:px-5';
---

<Base title={r.title} description={r.description} islands="lite">
  <!-- 1 · Verejná ponuka (verbatim) -->
  <Section bg="paper" pad="lg" class="tx-grain [--tx:0.08]" label="Verejná ponuka">
    <div class="relative z-10 grid gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <p class="eyebrow">Konzultácia / Bezplatný vstup / 30 minút</p>
          <span data-zdroj hidden class="sticker bg-hot text-ink [--sticker-rotate:-3deg]"></span>
        </div>
        <h1 class="mt-6 font-display text-display font-extrabold uppercase leading-[0.9] tracking-tighter">
          {PONUKA.titulok}
        </h1>
      </div>
      <div class="flex flex-col gap-5 text-lg">
        {PONUKA.odseky.map((o) => <p>{o}</p>)}
        <p class="font-bold">
          Napíš na <a href={`mailto:${EMAIL}`} class="inline-block py-3 underline decoration-[3px] decoration-hot underline-offset-4">{EMAIL}</a>.
          Termín dohodneme osobne.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="#formular" class:list={[btn, 'bg-hot text-ink']}>Vyplniť formulár</a>
          <a href="#priebeh" class:list={[btn, 'bg-white text-ink']}>Ako to prebieha</a>
        </div>
      </div>
    </div>
  </Section>

  <Marquee
    items={['JEDNA ÚLOHA', '30 MINÚT', 'BEZPLATNÝ VSTUP', 'PÍSOMNÝ ĎALŠÍ KROK', 'NETREBA PREZENTÁCIU']}
    color="yellow"
    size="md"
    label="Konzultácia v skratke"
  />

  <!-- 2 · Priebeh 30 minút -->
  <Section id="priebeh" bg="white" border="bottom" pad="md" label="Ako prebieha 30 minút" class="scroll-mt-20">
    <p class="eyebrow">Priebeh / 30 minút</p>
    <h2 class="mt-4 max-w-4xl font-display text-display-sm font-extrabold uppercase leading-[0.92] tracking-tight">
      Ako prebieha 30 minút
    </h2>
    <div class="mt-10 overflow-hidden rounded-lg border-3 border-ink bg-white shadow-brutal">
      <table class="tbl w-full border-collapse text-left" role="table">
        <caption class="sr-only">Priebeh 30-minútového stretnutia: čas, čo vedie Adam a čo musí vzniknúť</caption>
        <thead role="rowgroup">
          <tr class="bg-ink text-paper" role="row">
            <th scope="col" role="columnheader" class={th}>Čas</th>
            <th scope="col" role="columnheader" class={th}>Adam vedie</th>
            <th scope="col" role="columnheader" class={th}>Čo musí vzniknúť</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            PRIEBEH.map((k, i) => (
              <tr class="reveal border-t-3 border-ink odd:bg-white even:bg-paper" role="row" style={`--i:${i}`}>
                <th scope="row" role="rowheader" data-label="Čas" class="whitespace-nowrap px-4 py-4 align-top font-mono text-lg font-bold sm:px-5">
                  {k.cas}
                </th>
                <td role="cell" data-label="Adam vedie" class="px-4 py-4 align-top text-lg sm:px-5">
                  {k.vedie}
                </td>
                <td role="cell" data-label="Čo musí vzniknúť" class="px-4 py-4 align-top font-display text-xl font-extrabold leading-tight sm:px-5">
                  {k.vznikne}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="mt-8 max-w-3xl">
      <p class="eyebrow">Moje pravidlá</p>
      <p class="mt-3 text-lg">{PRIEBEH_POZNAMKA}</p>
    </div>
  </Section>

  <!-- 3 · Šesť otázok -->
  <Section id="otazky" bg="yellow" border="bottom" pad="md" class="tx-halftone [--tx:10%] scroll-mt-20" label="Diagnostika">
    <p class="eyebrow">Diagnostika</p>
    <h2 class="mt-4 max-w-4xl font-display text-display-sm font-extrabold uppercase leading-[0.92] tracking-tight">
      Šesť otázok, ktoré menia riešenie
    </h2>
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        OTAZKY.map((q, i) => (
          <li class="card-drop relative flex min-h-44 flex-col justify-between gap-6 rounded-lg border-3 border-ink bg-white p-5 shadow-brutal" style={`--i:${i}`}>
            <span class="font-mono text-4xl font-bold text-hot" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="font-display text-xl font-bold leading-snug">{q}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-8 flex max-w-3xl gap-4 rounded-lg border-3 border-ink bg-paper p-5 shadow-brutal-sm">
      <XMark class="mt-1 h-6 w-6 shrink-0 text-hot" />
      <p class="text-lg">{OTAZKY_POZNAMKA}</p>
    </div>
  </Section>

  <!-- 4 · Voľba najmenšieho užitočného riešenia -->
  <Section id="riesenie" bg="lilac" border="bottom" pad="md" class="scroll-mt-20" label="Voľba najmenšieho užitočného riešenia">
    <p class="eyebrow">Prvý krok / nie hneď agent</p>
    <h2 class="mt-4 max-w-4xl font-display text-display-sm font-extrabold uppercase leading-[0.92] tracking-tight">
      Voľba najmenšieho užitočného riešenia
    </h2>
    <div class="mt-10 overflow-hidden rounded-lg border-3 border-ink bg-white shadow-brutal">
      <table class="tbl w-full border-collapse text-left" role="table">
        <caption class="sr-only">Pozorovanie, prvý vhodný krok a dôvod</caption>
        <thead role="rowgroup">
          <tr class="bg-ink text-paper" role="row">
            <th scope="col" role="columnheader" class={th}>Pozorovanie</th>
            <th scope="col" role="columnheader" class={th}>Prvý vhodný krok</th>
            <th scope="col" role="columnheader" class={th}>Dôvod</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            RIESENIA.map((x, i) => (
              <tr class="reveal border-t-3 border-ink odd:bg-white even:bg-paper" role="row" style={`--i:${i}`}>
                <th scope="row" role="rowheader" data-label="Pozorovanie" class="px-4 py-4 align-top text-lg font-bold sm:px-5">
                  {x.pozorovanie}
                </th>
                <td role="cell" data-label="Prvý vhodný krok" class="px-4 py-4 align-top font-display text-xl font-extrabold leading-tight sm:px-5">
                  <span class="inline-block rounded-lg border-3 border-ink bg-lime px-3 py-1.5 shadow-brutal-sm">{x.krok}</span>
                </td>
                <td role="cell" data-label="Dôvod" class="px-4 py-4 align-top text-lg sm:px-5">
                  {x.dovod}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-8 max-w-3xl text-lg">{RIESENIA_POZNAMKA}</p>
  </Section>

  <!-- 5 · Vstup pred stretnutím -->
  <Section id="vstup" bg="pink" border="bottom" pad="md" class="scroll-mt-20" label="Vstup pred stretnutím">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
        <p class="eyebrow">Pred stretnutím</p>
        <h2 class="mt-4 font-display text-display-sm font-extrabold uppercase leading-[0.92] tracking-tight">
          Vstup pred stretnutím
        </h2>
        <p class="mt-5 max-w-md text-lg">Toto je správa, ktorú dostaneš po dohodnutí termínu. Nič viac netreba.</p>
        <div class="mt-6 flex gap-4 rounded-lg border-3 border-ink bg-paper p-5 shadow-brutal-sm">
          <XMark class="mt-1 h-6 w-6 shrink-0 text-hot" />
          <div>
            <p class="eyebrow">Moje pravidlá</p>
            <p class="mt-2 text-base">{VSTUP_CITLIVE}</p>
          </div>
        </div>
      </div>
      <figure class="relative rounded-lg border-3 border-ink bg-white p-6 shadow-brutal-lg sm:p-9">
        <span class="x-stamp" aria-hidden="true"></span>
        <figcaption class="eyebrow">Správa od Adama</figcaption>
        <blockquote class="mt-5 border-l-[6px] border-ink pl-5 font-serif text-2xl italic leading-[1.35] sm:text-[1.75rem]">
          {VSTUP_TEXT}
        </blockquote>
      </figure>
    </div>
  </Section>

  <!-- 6 · Intake formulár -->
  <Section id="formular" bg="lime" pad="lg" class="tx-halftone scroll-mt-20" label="Formulár">
    <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
      <div class="lg:sticky lg:top-24">
        <p class="eyebrow">Formulár / Bez registrácie</p>
        <h2 class="mt-4 font-display text-display-sm font-extrabold uppercase leading-[0.92] tracking-tight">
          Napíš mi úlohu.
        </h2>
        <p class="mt-5 max-w-md text-lg">
          Vyplníš šesť polí, ja dostanem správu s tým, čo potrebujem vedieť, a termín dohodneme osobne. Odoslanie ostáva
          v tvojich rukách: WhatsApp, e-mail alebo kopírovanie.
        </p>
        <p class="mt-6 text-lg">
          Alebo rovno napíš na
          <a href={`mailto:${EMAIL}`} class="inline-block py-3 font-bold underline decoration-[3px] decoration-hot underline-offset-4">{EMAIL}</a>.
        </p>
      </div>
      <Intake client:visible={{ rootMargin: '600px' }} />
    </div>
  </Section>
</Base>

<style>
  /* Tabuľky: na mobile sa riadok skladá pod seba, hlavička riadku = data-label (bez vodorovného scrollu). */
  @media (max-width: 639px) {
    .tbl thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .tbl,
    .tbl tbody,
    .tbl tr,
    .tbl th,
    .tbl td {
      display: block;
      width: 100%;
    }
    .tbl th[data-label],
    .tbl td[data-label] {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    .tbl tr > :first-child {
      padding-top: 1rem;
    }
    .tbl tr > :last-child {
      padding-bottom: 1.25rem;
    }
    .tbl [data-label]::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.25rem;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--color-ink) 65%, transparent);
    }
    .tbl th[data-label] {
      white-space: normal;
    }
  }
</style>

<script>
  /* Štítok „Prichádzaš z kvízu / Z plánu…“ v hero podľa ?z= (rodovo neutrálne, rovnaké ako ZDROJ_LABEL v payload.ts;
     ostrov Intake si query číta sám). */
  const LABELS: Record<string, string> = {
    kviz: 'Prichádzaš z kvízu',
    plan: 'Z plánu Neviditeľný maklér',
  };
  const applyZdroj = () => {
    const el = document.querySelector<HTMLElement>('[data-zdroj]');
    if (!el) return;
    const z = new URLSearchParams(location.search).get('z') ?? '';
    const label = LABELS[z];
    if (label) {
      el.textContent = label;
      el.hidden = false;
    } else {
      el.hidden = true;
    }
  };
  document.addEventListener('astro:page-load', applyZdroj);
</script>
