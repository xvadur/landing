---
/** V7-10 · Inštrumentár (bento). Domov ako podnos s nástrojmi pred zákrokom: celá stránka je bento mriežka dlaždíc
 *  v deviatich podnosoch; každá dlaždica je overiteľná vec (služba, projekt, číslo, text). Motor: Motion (magnetické
 *  dlaždice). Podpis: nástroj sa pri hoveri zdvihne z podnosu (tieň 6 → 11 px), detail sa rozbalí s --bk-ease-rubber.
 *  Zadanie work/v7/BUILD_ZADANIE.md, koncept work/v7/koncepty/10-instrumentar.md, poznámky work/v7/vystup/10/README.md. */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { datumSk } from '@/components/texty/citanie';
import Opona from '@/components/v7/web/10/Opona.astro';
import Lista from '@/components/v7/web/10/Lista.astro';
import Podnos from '@/components/v7/web/10/Podnos.astro';
import Prijem from '@/components/v7/web/10/Prijem';
import Vitalne from '@/components/v7/web/10/Vitalne';
import Anamneza from '@/components/v7/web/10/Anamneza';
import Nastroje from '@/components/v7/web/10/Nastroje';
import Pacienti from '@/components/v7/web/10/Pacienti';
import Hry from '@/components/v7/web/10/Hry';
import Liecba from '@/components/v7/web/10/Liecba';
import PodnosVysetrenie from '@/components/v7/web/10/PodnosVysetrenie';
import ZapisTexty from '@/components/v7/web/10/ZapisTexty';
import Paleta from '@/components/v7/web/10/Paleta';

const texty = (await getCollection('texty')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const p = texty[0];
const posledny = p ? { id: p.id, title: p.data.title, description: p.data.description, datum: datumSk(p.data.date) } : null;
---

<Base
  title="V7-10 · Inštrumentár"
  description="Adam Rudavský, zdravotník, ktorý stavia AI agentov. Domov ako podnos s nástrojmi: vitálne funkcie, chorobopisy, liečba, vyšetrenie."
  noindex
  islands="full"
  header="none"
>
  <Opona />
  <div class="v710">
    <Lista />
    <div class="flex flex-col gap-14 pt-6 pb-20 sm:gap-16 lg:gap-20 lg:pt-10">
      <Podnos id="prijem" cislo="01" nazov="Príjem" pozn="kto ťa prijíma">
        <Prijem client:load />
      </Podnos>
      <Podnos id="vitalne" cislo="02" nazov="Vitálne funkcie" pozn="čísla z pulzu Korpusu">
        <Vitalne client:visible />
      </Podnos>
      <Podnos id="anamneza" cislo="03" nazov="Anamnéza" pozn="z nemocnice k agentom">
        <Anamneza client:visible />
      </Podnos>
      <Podnos id="nastroje" cislo="04" nazov="Inštrumentár" pozn="s čím robím">
        <Nastroje client:visible />
      </Podnos>
      <Podnos id="pacienti" cislo="05" nazov="Chorobopisy" pozn="čo som postavil">
        <Pacienti client:idle />
      </Podnos>
      <Podnos id="hry" cislo="06" nazov="Hry" pozn="vyskúšaj si">
        <Hry client:idle />
      </Podnos>
      <Podnos id="liecba" cislo="07" nazov="Liečba" pozn="triáž · zásah · odovzdanie">
        <Liecba client:visible />
      </Podnos>
      <Podnos id="vysetrenie" cislo="08" nazov="Vyšetrenie" pozn="30 minút s Adamom">
        <PodnosVysetrenie client:visible />
      </Podnos>
      <Podnos id="zapis" cislo="09" nazov="Zápis a texty" pozn="mimo ordinácie">
        <ZapisTexty client:visible posledny={posledny} />
      </Podnos>
    </div>
  </div>
  <Paleta client:idle />
</Base>

<style is:global>
  /* ============ V7-10 Inštrumentár: bento podnos ============ */
  .v710 {
    --v10-gap: 0.75rem;
    --v10-tien: 4px;
    --v10-zdvih: -4px;
    --v10-tien-hore: 9px;
    background-color: var(--color-paper);
  }
  @media (min-width: 640px) {
    .v710 {
      --v10-gap: 1rem;
      --v10-tien: 6px;
      --v10-zdvih: -5px;
      --v10-tien-hore: 11px;
    }
  }
  @media (min-width: 1024px) {
    .v710 {
      --v10-gap: 1.25rem;
    }
  }

  /* záložka a plocha podnosu */
  .v10-zalozka {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    padding: 0.35rem 0.9rem 0.25rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 3px solid var(--color-ink);
    border-bottom: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .v10-plocha {
    border: 3px solid var(--color-ink);
    background-color: color-mix(in srgb, var(--color-paper) 70%, var(--color-white));
    background-image: radial-gradient(color-mix(in srgb, var(--color-ink) 16%, transparent) 1px, transparent 1.4px);
    background-size: 18px 18px;
    padding: 0.75rem 0.75rem calc(0.75rem + var(--v10-tien));
  }
  @media (min-width: 640px) {
    .v10-plocha {
      padding: 1.25rem 1.25rem calc(1.25rem + var(--v10-tien));
    }
  }

  /* bento mriežka: mobil 2 stĺpce (rytmus veľkostí ostáva), tablet 6, desktop 12 */
  .v10-mriezka {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: row dense;
    grid-auto-rows: minmax(8.5rem, auto);
    gap: var(--v10-gap);
  }
  @media (min-width: 768px) {
    .v10-mriezka {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .v10-mriezka {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: minmax(9rem, auto);
    }
  }

  /* nástroj: podpis = zdvih z podnosu (tieň 6 → 11 px), CSS iba na tejto vrstve (magnet je Motion o vrstvu vyššie) */
  .v10-dl {
    box-shadow: var(--v10-tien) var(--v10-tien) 0 0 var(--color-ink);
    translate: 0 0;
    transition:
      translate 320ms var(--bk-ease-rubber),
      box-shadow 320ms var(--bk-ease-rubber);
  }
  @media (hover: hover) and (pointer: fine) {
    .v10-bunka:hover > div > .v10-dl {
      translate: var(--v10-zdvih) var(--v10-zdvih);
      box-shadow: var(--v10-tien-hore) var(--v10-tien-hore) 0 0 var(--color-ink);
    }
    .v10-bunka:hover .v10-znak {
      translate: -3px -3px;
      box-shadow: 4px 4px 0 0 var(--color-ink);
    }
  }
  .v10-bunka:focus-within > div > .v10-dl,
  .v10-dl[data-otvorene] {
    translate: var(--v10-zdvih) var(--v10-zdvih);
    box-shadow: var(--v10-tien-hore) var(--v10-tien-hore) 0 0 var(--color-ink);
  }
  .v10-znak {
    transition:
      translate 320ms var(--bk-ease-rubber),
      box-shadow 320ms var(--bk-ease-rubber);
  }

  /* štítok nástroja v rohu */
  .v10-stitok {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: none;
    padding: 0.15rem 0.45rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .v10-dl.bg-ink > .v10-stitok,
  .v10-dl.bg-stamp > .v10-stitok {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .v10-stitok {
      display: block;
    }
  }

  /* rozbalenie detailu zdola (--bk-ease-rubber); na dotyku cez tlačidlo +, s myšou aj hoverom */
  .v10-plus {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 4;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--color-ink);
    background: var(--color-white);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: 3px 3px 0 0 var(--color-ink);
  }
  .v10-plus:active {
    translate: 3px 3px;
    box-shadow: none;
  }
  .v10-detail {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    max-height: 100%;
    overflow: auto;
    padding: 1rem 3.75rem 1rem 1rem;
    border-top: 3px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
    translate: 0 calc(100% + 6px);
    transition: translate 460ms var(--bk-ease-rubber);
  }
  .v10-dl.bg-ink > .v10-detail {
    background: var(--color-yellow);
    color: var(--color-ink);
  }
  .v10-dl[data-otvorene] > .v10-detail {
    translate: 0 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .v10-bunka:hover .v10-detail {
      translate: 0 0;
    }
  }

  /* položenie nástroja na podnos pri vstupe do obrazu: CSS scroll-timeline po schodoch (0 JS) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .v10-bunka {
        animation: v10-poloz steps(4, end) both;
        animation-timeline: var(--v10-tl);
        --v10-tl: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }
  @keyframes v10-poloz {
    from {
      opacity: 0.2;
      translate: 0 22px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* motto: veľkosť podľa šírky dlaždice (container query), aby „WE ARE USELESS.“ nikdy nepretieklo */
  .v10-bunka:has(.v10-motto) .v10-dl {
    container-type: inline-size;
  }
  .v10-motto {
    font-size: min(10.4cqi, 4.6rem);
  }

  /* EKG */
  .v10-ekg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: v10-ekg-kresli 4s steps(10, end) infinite;
  }
  @keyframes v10-ekg-kresli {
    0% {
      stroke-dashoffset: 1;
    }
    30%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  .v10-ekg-beh {
    animation: v10-ekg-beh 5s linear infinite;
  }
  @keyframes v10-ekg-beh {
    to {
      transform: translateX(-50%);
    }
  }
  .v10-ekg-mriezka {
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-paper) 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-paper) 12%, transparent) 1px, transparent 1px);
    background-size: 12px 12px;
  }

  /* Korpus svieti (tvrdý posun, bez rozmazania) */
  .v10-svieti {
    text-shadow: 3px 3px 0 color-mix(in srgb, var(--color-yellow) 35%, transparent);
  }

  /* lesk fotky (Glare Card, ale tvrdý pás bez rozmazania) */
  .v10-glare-pas {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: var(--go, 0);
    background: linear-gradient(
      115deg,
      transparent calc(var(--gx, 50%) - 16%),
      color-mix(in srgb, var(--color-white) 55%, transparent) calc(var(--gx, 50%) - 16%),
      color-mix(in srgb, var(--color-white) 55%, transparent) calc(var(--gx, 50%) - 7%),
      transparent calc(var(--gx, 50%) - 7%),
      transparent calc(var(--gx, 50%) - 3%),
      color-mix(in srgb, var(--color-white) 40%, transparent) calc(var(--gx, 50%) - 3%),
      color-mix(in srgb, var(--color-white) 40%, transparent) calc(var(--gx, 50%) - 1%),
      transparent calc(var(--gx, 50%) - 1%)
    );
    transition: opacity 150ms linear;
  }

  /* obrysové čísla liečby */
  .v10-obrys {
    color: transparent;
    -webkit-text-stroke: 3px var(--color-ink);
    text-shadow: 5px 5px 0 var(--color-yellow);
  }
  .v10-obrys-svetly {
    -webkit-text-stroke-color: var(--color-paper);
    text-shadow: 5px 5px 0 var(--color-stamp);
  }

  @media (prefers-reduced-motion: reduce) {
    .v10-dl,
    .v10-znak,
    .v10-detail {
      transition: opacity 120ms linear;
    }
    .v10-ekg path,
    .v10-ekg-beh {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
