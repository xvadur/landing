---
/** V7 · 10 webov z katalógu (29. 9. 2026): rozcestník variantov domova. Noindex. Zadanie work/v7/BUILD_ZADANIE.md. */
import Base from '@/layouts/Base.astro';

const varianty = [
  ['01', 'Monitor JIS', 'dashboard obrazoviek, EKG ako navigácia'],
  ['04', 'Triáž', 'bočná triážna páska, pečiatky'],
  ['05', 'Komiks', 'panely, bubliny, Adam ako hrdina'],
  ['07', 'Orientačný systém', 'vodorovná chodba pavilónov'],
  ['08', 'Nemocničný systém', 'desktop s oknami, Cmd+K'],
  ['09', 'Plagát a zin', 'risograf, listy, páska'],
  ['10', 'Inštrumentár', 'bento podnos s nástrojmi'],
];
---

<Base title="V7 · 7 webov" description="Sedem variantov domova xvadur.com zo stavebnice XVADUR." noindex islands="lite" header="none">
  <main class="mx-auto flex max-w-5xl flex-col gap-8 px-4 py-12">
    <header class="flex flex-col gap-3">
      <p class="eyebrow">V7 · buildy</p>
      <h1 class="font-display text-display-md uppercase">7 webov XVADUR</h1>
      <p class="max-w-2xl">Každý web je poskladaný z tej istej stavebnice (<a class="underline" href="/kit/">/kit/</a>), iný layout, iný pohyb.</p>
    </header>
    <ul class="grid gap-4 sm:grid-cols-2">
      {varianty.map(([nn, meno, co]) => (
        <li>
          <a href={`/v7/${nn}/`} class="brutal lift press flex min-h-36 flex-col gap-2 bg-white p-5">
            <span class="font-mono text-sm">V7-{nn}</span>
            <span class="font-display text-display-xs uppercase">{meno}</span>
            <span class="text-sm">{co}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
