              <img src="/assets/dokazy/hriech.webp" alt="Hriech — náhľad publikácie" width="960" height="600" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover object-top grayscale contrast-125" />
            </div>
            <Zvuk zvuk={{ text: 'BUM!', tvar: 'splat', farba: 'stamp' }} size={96} rot={-10} className="top-3 right-3" />
            <div class="flex flex-1 flex-col gap-3 px-5 pb-6">
