                <Zapis05 client:visible id="k05-vydanie" zdroj="newsletter" produkt={NEWSLETTER.id} tlacidlo="Odoberať" hotovo="Hotovo. Prvé vydanie ti príde do e-mailu." />
              </div>
            </div>
          </LayeredCard>
        </div>
