                <p class="text-lg text-paper/85">{LAKADLO.popis}</p>
                <Zapis05 client:visible id="k05-lakadlo" zdroj="lakadlo" produkt={LAKADLO.id} tlacidlo="Pošli mi návod" tmavy hotovo="Hotovo. Návod ti pošlem, keď ho dopíšem." />
