---
/** Domov xvadur.com V8 (30. 9. 2026): jeden smer, prémiová disciplína podľa svojtko.com a cohesion.framer.ai
 *  (jedno slovo v hero, jedna farba navyše, veľké medzery), na zamknutej identite: neobrutalizmus, zdravotnícka línia,
 *  Bricolage / Space Grotesk / Geist Mono / Instrument Serif. Komponenty v src/components/v8/. Vyšetrenie a zápis sú
 *  tie isté funkčné bloky ako na V5.4. */
import Base from '@/layouts/Base.astro';
import Hero from '@/components/v8/Hero.astro';
import Vitalne from '@/components/v8/Vitalne.astro';
import KtoSom from '@/components/v8/KtoSom.astro';
import Vyrok from '@/components/v8/Vyrok.astro';
import Liecba from '@/components/v8/Liecba.astro';
import Dokazy from '@/components/v8/Dokazy.astro';
import Konzultacia from '@/components/v5/Konzultacia.astro';
import Zber from '@/components/v5/Zber.astro';
import { routeByPath } from '@/data/routes';

const r = routeByPath('/')!;
---

<Base title={r.title} description={r.description} islands="full" header="bar">
  <Hero />
  <Vitalne />
  <KtoSom />
  <Vyrok />
  <Liecba />
  <Dokazy />
  <Konzultacia />
  <Zber />
</Base>
