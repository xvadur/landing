---
/** Domov xvadur.com V7 (29. 9. 2026): jeden web, príbeh ako chrbtica. Adam: „nádherný, redakčný a funkčný web“.
 *  Opona → hero s fotkou a pulzom Korpusu → príbeh v troch dejstvách → vitálne funkcie → čo som postavil (detail
 *  v Sheete) → hry (Škrtací test hrateľný na mieste) a texty → tézy → liečba → vyšetrenie s rezerváciou (funkčná,
 *  /api/terminy/ + /api/rezervacia/) → zápis (/api/zapis/). Stavebnica BoldKit (src/components/ui/), komponenty
 *  src/components/web/. Predošlý domov V5.4 (src/components/v54/) ostáva v repe, na domove sa nepoužíva. */
import Base from '@/layouts/Base.astro';
import Opona from '@/components/home/Opona.astro';
import Hero from '@/components/web/Hero.astro';
import Pribeh from '@/components/web/Pribeh.astro';
import Vitalne from '@/components/web/Vitalne.astro';
import Postavil from '@/components/web/Postavil.astro';
import HryTexty from '@/components/web/HryTexty.astro';
import Tezy from '@/components/web/Tezy.astro';
import Liecba from '@/components/web/Liecba.astro';
import Konzultacia from '@/components/v5/Konzultacia.astro';
import Zber from '@/components/v5/Zber.astro';
import { routeByPath } from '@/data/routes';

const r = routeByPath('/')!;
---

<Base title={r.title} description={r.description} islands="full">
  <Opona />
  <Hero />
  <Pribeh />
  <Vitalne />
  <Postavil />
  <HryTexty />
  <Tezy />
  <Liecba />
  <Konzultacia />
  <Zber />
</Base>

<style is:global>
  /* kotvy z menu nesmú padnúť pod prilepenú lištu */
  main section[id],
  section[id] {
    scroll-margin-top: 5rem;
  }
</style>
