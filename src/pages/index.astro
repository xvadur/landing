---
/** Domov xvadur.com V5 (26. 9. 2026, work/V5_ZADANIE.md). Predajný web pripravený na platenú reklamu, mobil prvý.
 *  0 Opona (raz za návštevu) · 1 Hero (XDR-205) · 2 Kto som, 7 zastávok vodorovne (XDR-206) · pás faktov ·
 *  3 Pred a po (XDR-207) · 4 Izba dôkazov (XDR-208) · 5 Ponuka: vlajka + čakačky + prečo nie iba ChatGPT (XDR-209) ·
 *  6 Konzultácia s rezerváciou (XDR-210, #konzultacia) · 7 Zber e-mailov: lákadlo + newsletter (XDR-211) ·
 *  8 Texty, Hriech, hry (XDR-214). Makléri, kvíz a skóre ostávajú na svojich URL (pätička, ⌘K).
 *  Plávajúce tlačidlo Konzultácia vykresľuje Base. */
import Base from '@/layouts/Base.astro';
import Marquee from '@/components/site/Marquee.astro';
import Hero from '@/components/spis/Hero.astro';
import Dejstvo1 from '@/components/spis/Dejstvo1.astro';
import Opona from '@/components/home/Opona.astro';
import KtoSom from '@/components/v5/KtoSom.astro';
import PredAPo from '@/components/v5/PredAPo.astro';
import Dokazy from '@/components/v5/Dokazy.astro';
import Ponuka from '@/components/v5/Ponuka.astro';
import Konzultacia from '@/components/v5/Konzultacia.astro';
import Zber from '@/components/v5/Zber.astro';
import TextyHry from '@/components/v5/TextyHry.astro';
import { MARQUEE_FAKTY } from '@/data/fakty';
import { routeByPath } from '@/data/routes';
import { nbsp } from '@/components/home/nbsp';

const r = routeByPath('/')!;
---

<Base title={r.title} description={r.description} islands="full" header="none">
  <Opona />
  <Hero />
  <Dejstvo1 />
  <KtoSom />
  <Marquee items={MARQUEE_FAKTY.map((f) => nbsp(f.value))} color="pink" size="lg" duration={36} label="Fakty" />
  <PredAPo />
  <Dokazy />
  <Marquee items={['KONZULTÁCIA 30 MINÚT', 'JEDNA ÚLOHA', 'PÍSOMNÝ ĎALŠÍ KROK', 'ZATIAĽ ZADARMO']} color="yellow" reverse size="md" duration={30} label="Konzultácia" />
  <Ponuka />
  <Konzultacia />
  <Zber />
  <TextyHry />
</Base>
