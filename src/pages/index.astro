---
/** Domov xvadur.com V5.4 (27. 9. 2026): neobrutalizmus + zdravotnícky žargón (XDR-267), layout a pohyb podľa
 *  cohesion.framer.ai a aiaktivista (pohyb do strán). Pilulkové menu so sledovaním sekcie, príjem s bežiacim XVADUR za
 *  fotkou a plávajúcimi symbolmi, vitálne funkcie naživo, anamnéza ako vrstvené karty, inštrumentár v pásoch, liečba
 *  s obrími číslami, chorobopisy vodorovne, tézy, vyšetrenie s rezerváciou, zápis, texty a hry.
 *  Predošlé scény V5 (KtoSom, PredAPo, Dokazy, Ponuka) ostávajú v src/components/v5/, na domove sa nepoužívajú. */
import Base from '@/layouts/Base.astro';
import Opona from '@/components/home/Opona.astro';
import Pilulky from '@/components/v54/Pilulky.astro';
import Prijem from '@/components/v54/Prijem.astro';
import Vitalne from '@/components/v54/Vitalne.astro';
import Anamneza from '@/components/v54/Anamneza.astro';
import Nastroje from '@/components/v54/Nastroje.astro';
import Liecba from '@/components/v54/Liecba.astro';
import Chorobopisy from '@/components/v54/Chorobopisy.astro';
import Tezy from '@/components/v54/Tezy.astro';
import Konzultacia from '@/components/v5/Konzultacia.astro';
import Zber from '@/components/v5/Zber.astro';
import TextyHry from '@/components/v5/TextyHry.astro';
import { routeByPath } from '@/data/routes';

const r = routeByPath('/')!;
---

<Base title={r.title} description={r.description} islands="full" header="none">
  <Opona />
  <Pilulky />
  <Prijem />
  <Vitalne />
  <Anamneza />
  <Nastroje />
  <Liecba />
  <Chorobopisy />
  <Tezy />
  <Konzultacia />
  <Zber />
  <TextyHry />
</Base>
