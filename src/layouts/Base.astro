---
/** Základný layout každej stránky.
 *  <Base title="…" description="…" ogImage="/og/kviz.png" noindex>
 *  Obsahuje: meta + OG/Twitter, canonical, favicon (X), ClientRouter, global.css,
 *  Header, <slot/>, Footer a site ostrovy: Smooth (Lenis), Cursor (X), CommandK (⌘K), Toaster (sonner). */
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Header from '@/components/site/Header.astro';
import NavMobil from '@/components/site/NavMobil.astro';
import Footer from '@/components/site/Footer.astro';
import Smooth from '@/components/site/Smooth';
import Cursor from '@/components/site/Cursor';
import CommandK from '@/components/site/CommandK';
import Toaster from '@/components/site/Toaster';
import { ogUrlFor } from '@/data/routes';

interface Props {
  title: string;
  description: string;
  /** cesta k OG obrázku (1200×630); default podľa src/data/routes.ts alebo /og/default.png */
  ogImage?: string;
  noindex?: boolean;
  /** trieda na <body> (napr. bg-ink pre tmavú stránku) */
  bodyClass?: string;
  /** vypnúť hlavičku / pätičku (napr. /makleri/plan/ pri tlači) */
  chrome?: boolean;
  /** 'bar' = sticky Header (default) · 'none' = žiadna lišta, ale mobilný dialóg (NavMobil) sa vykreslí — pre
   *  domov, kde nav sedí priamo v Hero pod obrím wordmarkom (20. 9., viď Header.astro) */
  header?: 'bar' | 'none';
  /** site ostrovy: full = Smooth + Cursor + CommandK + Toaster (domov, hry) · lite = len Toaster (podstránky s formulárom,
   *  ušetrí ~50 kB gz na desktope) · none = žiadne (články: JS len z Header drawera na mobile) */
  islands?: 'full' | 'lite' | 'none';
}

const {
  title,
  description,
  ogImage,
  noindex = false,
  bodyClass = '',
  chrome = true,
  islands = 'full',
  header = 'bar',
} = Astro.props;

const site = Astro.site ?? new URL('https://xvadur.com');
const canonical = new URL(Astro.url.pathname, site);
const og = new URL(ogImage ?? ogUrlFor(Astro.url.pathname), site);
---

<!doctype html>
<html lang="sk" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffe600" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XVADUR" />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.href} />

    <link rel="icon" href="/brand/x.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/og/default.png" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body class:list={['min-h-dvh flex flex-col', bodyClass]}>
    {chrome && header === 'bar' && <Header />}
    {chrome && header === 'none' && <NavMobil />}
    <main id="obsah" class="flex-1">
      <slot />
    </main>
    {chrome && <Footer />}

    {islands === 'full' && <Smooth client:only="react" transition:persist />}
    {islands === 'full' && <Cursor client:only="react" transition:persist />}
    {islands === 'full' && <CommandK client:idle transition:persist />}
    {islands !== 'none' && <Toaster client:idle transition:persist />}
  </body>
</html>
